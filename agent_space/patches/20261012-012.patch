+CONSTANT NoValue
+
+(*
+--algorithm FastFigureSystem
+variables
+  activeProject = NoValue,
+  coreRuntime = "uninitialized",
+  appLifecycle = "booting",
+  apiExposed = FALSE,
+  mantineMounted = FALSE,
+  result = NoValue;
+
+procedure InitializeFastFigure()
+variables projectCandidate = NoValue;
+begin
+InitializeProjectCandidate:
+  projectCandidate := CreateProjectState();
+InitializeProjectValidate:
+  assert ValidateWholeProject(projectCandidate);
+InitializeProjectCommit:
+  activeProject := projectCandidate;
+InitializeRendererHosts:
+  assert RequiredRendererHostsExist();
+InitializeDashboardProjection:
+  ApplyDashboardZoomProjection();
+InitializeSlotController:
+  InstallSlotInteractionController();
+InitializeRender:
+  RenderDashboardFrom(activeProject);
+InitializeStyle:
+  ApplySlotStyleFrom(activeProject);
+InitializeReady:
+  appLifecycle := "ready";
+InitializeWorkspace:
+  SynchronizeInitialWorkspaceAndOverlay();
+InitializeApi:
+  apiExposed := TRUE;
+InitializeMantine:
+  MountMantineProviderAndShell();
+InitializeMantineState:
+  mantineMounted := TRUE;
+InitializeNoSyntheticData:
+  assert NoDefaultCsvOrFakeGraphObjectWasCreated(activeProject);
+InitializeAudit:
+  assert AuditProjectReferenceRuntimeInvariants();
+InitializeResult:
+  coreRuntime := "ready" ||
+  result := "initialized";
+InitializeReturn:
+  return;
+end procedure;
+
+begin
+Main:
+  call InitializeFastFigure();
+end algorithm;
 *)
