diff --git a/.github/workflows/tla-slot-core-modular.yml b/.github/workflows/tla-slot-core-modular.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/tla-slot-core-modular.yml
@@ -0,0 +1,71 @@
+name: TLA Slot Core Modular Experiment
+
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - '.github/tlc/modules/FastFigureApplicationFsmUnit.tla'
+      - '.github/tlc/modules/FastFigureApplicationFsmUnit.cfg'
+      - '.github/tlc/modules/FastFigureLayoutUnit.tla'
+      - '.github/tlc/modules/FastFigureLayoutUnit.cfg'
+      - '.github/workflows/tla-slot-core-modular.yml'
+
+jobs:
+  verify:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - unit: application-fsm
+            module: FastFigureApplicationFsmUnit
+          - unit: layout-annotations-export
+            module: FastFigureLayoutUnit
+    name: ${{ matrix.unit }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Java
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+
+      - name: Download TLA+ tools
+        shell: bash
+        run: |
+          set -euo pipefail
+          curl -fL --retry 3 \
+            -o /tmp/tla2tools.jar \
+            https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
+          actual="$(sha1sum /tmp/tla2tools.jar | awk '{print $1}')"
+          expected="bee4a54f3ee3d4afc347c3240ec2d9e93b075104"
+          test "$actual" = "$expected"
+
+      - name: Translate PlusCal
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p /tmp/fast-figure-tla
+          cp ".github/tlc/modules/${{ matrix.module }}.tla" /tmp/fast-figure-tla/
+          cp ".github/tlc/modules/${{ matrix.module }}.cfg" /tmp/fast-figure-tla/
+          cd /tmp/fast-figure-tla
+          java -cp /tmp/tla2tools.jar pcal.trans "${{ matrix.module }}.tla"
+
+      - name: Parse generated TLA+
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd /tmp/fast-figure-tla
