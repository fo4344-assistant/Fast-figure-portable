+    payload.changed = { slotIds: [first.id, second.id].filter(id => localKey(source.slots.find(slot => slot.id === id)) !==
+      localKey(after.slots.find(slot => slot.id === id))), chartIds: [], csvIds: [], imageIds: [], assets: [] };
