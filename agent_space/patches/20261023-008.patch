+export function scalePlotlyFigure(figure, scale = 1) {
+  let copy = projectClone(figure),
+    factor = Math.max(0.01, Number(scale) || 1),
+    scaleNumber = (value) =>
+      Number.isFinite(Number(value)) ? Number(value) * factor : value,
