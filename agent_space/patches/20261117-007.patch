+    candidate.slots[i] := result;
+    i := i + 1;
+  end while;
+  call normalizeProjectSettings(candidate); candidate := result;
+  call validateProjectObjectState(candidate,TRUE);
+ReturnValidatedNewInstance:
+  result := candidate;
+  \* Failure before return leaves activeProject unchanged.
+  return;
+end procedure;
+
