+---- MODULE FastFigureSystemPseudocode ----
+EXTENDS Naturals
+
+\* r13 translation of sourcescript/system.py.
+\* system.py is the semantic root; responsibility modules remain siblings.
+CONSTANT NoValue
+
+(*
+--algorithm FastFigureSystem {
+  variables activeProject = NoValue,
+            coreRuntime = "uninitialized",
+            appLifecycle = "booting",
+            apiExposed = FALSE,
+            mantineMounted = FALSE,
+            result = NoValue;
+
+  procedure InitializeFastFigure() {
+  CreateDefaultProjectCandidate:
+    with (candidate = CreateProjectState()) {
+    ValidateDefaultProject:
+      assert ValidateWholeProject(candidate);
+    CommitInitialProject:
+      activeProject := candidate;
+    };
+  ValidateRendererHosts:
+    assert RequiredRendererHostsExist();
+  PrepareDashboardRuntime:
+    ApplyDashboardZoomProjection();
+    InstallSlotInteractionController();
+  RenderExistingProjectSlots:
+    RenderDashboardFrom(activeProject);
+  ApplyInitialStyleAndGeometry:
+    ApplySlotStyleFrom(activeProject);
+  EnterReadyLifecycle:
+    appLifecycle := "ready";
+    SynchronizeInitialWorkspaceAndOverlay();
+  ExposeApiBoundary:
+    apiExposed := TRUE;
+  MountMantineFrontend:
+    MountMantineProviderAndShell();
+    mantineMounted := TRUE;
+  ProhibitSyntheticDefaultData:
+    assert NoDefaultCsvOrFakeGraphObjectWasCreated(activeProject);
+  FinalInvariantAudit:
+    assert AuditProjectReferenceRuntimeInvariants();
+  CompleteInitialization:
+    coreRuntime := "ready";
+    result := "initialized";
+    return;
+  }
+
+  Main:
+    call InitializeFastFigure();
+}
+*)
