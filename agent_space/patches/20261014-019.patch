+
+    변경:
+    - authoritative slot-local imageSettings를 변경하지 않는다.
+    """
+    imageEditor = "선택 image의 read-only editor projection 또는 없음"
+    return imageEditor
+
+
+def applyImageSettingsFromValues(values):
