diff --git a/.github/workflows/tla-slot-core.yml b/.github/workflows/tla-slot-core.yml
--- a/.github/workflows/tla-slot-core.yml
+++ b/.github/workflows/tla-slot-core.yml
@@ -8,6 +8,8 @@ on:
       - 'verification/FastFigureSlotCore.cfg'
       - 'verification/FastFigureInteractionCore.tla'
       - 'verification/FastFigureInteractionCore.cfg'
+      - 'verification/FastFigureBoundaryCore.tla'
+      - 'verification/FastFigureBoundaryCore.cfg'
       - '.github/tlc/FastFigureSlotCore2x2.tla'
       - '.github/tlc/FastFigureSlotCore2x2.cfg'
       - '.github/workflows/tla-slot-core.yml'
@@ -114,3 +116,47 @@ jobs:
             -workers auto \
             -config FastFigureInteractionCore.cfg \
             FastFigureInteractionCore.tla
+
+  verify-boundary-core:
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Java
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+
+      - name: Download TLA+ tools
+        shell: bash
+        run: |
+          set -euo pipefail
+          curl -fL --retry 3 \
+            -o /tmp/tla2tools.jar \
+            https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
+          actual="$(sha1sum /tmp/tla2tools.jar | awk '{print $1}')"
+          expected="bee4a54f3ee3d4afc347c3240ec2d9e93b075104"
+          test "$actual" = "$expected"
+
+      - name: Parse TLA+
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p /tmp/fast-figure-boundary-tla
+          cp verification/FastFigureBoundaryCore.tla /tmp/fast-figure-boundary-tla/
+          cp verification/FastFigureBoundaryCore.cfg /tmp/fast-figure-boundary-tla/
+          cd /tmp/fast-figure-boundary-tla
+          java -cp /tmp/tla2tools.jar tla2sany.SANY FastFigureBoundaryCore.tla
+
+      - name: Model check
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd /tmp/fast-figure-boundary-tla
+          java -XX:+UseParallelGC -cp /tmp/tla2tools.jar tlc2.TLC \
+            -workers auto \
+            -config FastFigureBoundaryCore.cfg \
+            FastFigureBoundaryCore.tla
+
