+    defaultColors: () => [...DEFAULT_COLORS],
+    hasSelectedSlot: () => !!getSelectedSlot(),
+    importFile: importSelectedGraphFile,
+    exportFfsx: downloadSlotFfsx,
+    exportPlotlyJson: downloadPlotlyJson,
