+  return state === payload.overlay ? "none" : payload.overlay;
+}
+
+export function exitGraphWorkspaceState({ machine }) {
+  machine.state = Object.freeze({
+    ...machine.state,
+    graphObject: "none",
+    graphObjectIndex: null,
+  });
+}
