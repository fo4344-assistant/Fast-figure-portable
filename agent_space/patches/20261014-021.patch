+
+r22/r8 also makes persistent command ownership explicit. This slice models only
+project commands that affect CSV/reference/tree interaction. Image settings,
+caption settings, label settings, layout style, and export settings do not alter
+the state or properties checked here, so they are omitted rather than copied as
+independent verification state.
+*)
+
+NoSlot == 0
+NoCsv == 0
+
+AssetLocations == {"normal", "trash"}
+MoveSources == {"asset", "trash-root"}
+
+TreeMoveAllowed(source) == source # "trash-root"
+SlotConnectionAllowed(location) == location = "normal"
+
+SlotIds == 1..3
+CsvIds == 1..2
+MaxGraphObjects == 2
+
+SlotContentType == <<"graph", "image", "graph">>
+
+SlotHasContent == <<TRUE, TRUE, FALSE>>
+
+WorkspaceFor(slotId) ==
+  IF slotId = NoSlot
+    THEN "project"
+    ELSE IF SlotContentType[slotId] = "image"
+      THEN "slot.image"
+      ELSE "slot.graph"
+
+InitialProject ==
+  [ csvIds |-> {},
+    nextCsvId |-> 1,
+    graphObjectCsvRefs |-> <<>> ]
+
+ValidProject(project) ==
+  /\ project.csvIds \subseteq CsvIds
+  /\ project.nextCsvId \in 1..(Cardinality(CsvIds) + 1)
+  /\ Len(project.graphObjectCsvRefs) <= MaxGraphObjects
+  /\ \A index \in 1..Len(project.graphObjectCsvRefs) :
+       project.graphObjectCsvRefs[index] \in project.csvIds
+
+TypeOKState(selectedSlotId, workspace, assetSelection, selectedCsvId, project,
+            assetLocation, assetReferenced, lastResult) ==
+  /\ selectedSlotId \in SlotIds \cup {NoSlot}
+  /\ workspace \in {"project", "slot.graph", "slot.image"}
+  /\ workspace = WorkspaceFor(selectedSlotId)
+  /\ assetSelection \in {"none", "csv"}
+  /\ selectedCsvId \in CsvIds \cup {NoCsv}
+  /\ (assetSelection = "none" <=> selectedCsvId = NoCsv)
+  /\ (selectedCsvId # NoCsv => selectedCsvId \in project.csvIds)
+  /\ ValidProject(project)
+  /\ assetLocation \in AssetLocations
+  /\ assetReferenced \in BOOLEAN
+  /\ (assetReferenced => assetLocation = "normal")
+  /\ lastResult \in {
+       "initialized",
+       "slot-selected",
+       "slot-deselected",
+       "content-pass-through",
+       "invalid-slot",
+       "empty-csv-created",
+       "empty-csv-unavailable",
+       "graph-object-added",
+       "graph-object-rejected",
+       "asset-moved-normal",
+       "asset-moved-trash",
+       "asset-move-rejected",
+       "asset-slot-connected",
+       "asset-slot-connection-rejected"
+     }
+
+ModeledInteractionProjectCommands == {
+  "DATA_OBJECT_CREATED",
+  "GRAPH_OBJECTS_REPLACED",
+  "PROJECT_NODE_MOVED",
+  "SLOT_DATA_CONNECTED"
+}
+
+InteractionCommittedResults == {
+  "empty-csv-created",
+  "graph-object-added",
+  "asset-moved-normal",
+  "asset-moved-trash",
+  "asset-slot-connected"
+}
+
+InteractionResultCommand(result) ==
+  CASE result = "empty-csv-created" -> "DATA_OBJECT_CREATED"
+    [] result = "graph-object-added" -> "GRAPH_OBJECTS_REPLACED"
+    [] result = "asset-moved-normal" -> "PROJECT_NODE_MOVED"
+    [] result = "asset-moved-trash" -> "PROJECT_NODE_MOVED"
+    [] result = "asset-slot-connected" -> "SLOT_DATA_CONNECTED"
+    [] OTHER -> "none"
+
+InteractionProjectCommandOwnershipInvariant(result) ==
+  result in InteractionCommittedResults =>
+    InteractionResultCommand(result) in ModeledInteractionProjectCommands
+
+SelectionInvariant(selectedSlotId, workspace) ==
+  workspace = WorkspaceFor(selectedSlotId)
+
+CsvReferenceInvariant(project, selectedCsvId) ==
+  /\ selectedCsvId = NoCsv \/ selectedCsvId \in project.csvIds
+  /\ \A index \in 1..Len(project.graphObjectCsvRefs) :
+       project.graphObjectCsvRefs[index] \in project.csvIds
+
+TrashReferenceInvariant(assetLocation, assetReferenced) ==
+  assetLocation = "trash" => ~assetReferenced
+
+TreeRecoveryInvariant ==
+  /\ TreeMoveAllowed("asset")
+  /\ ~TreeMoveAllowed("trash-root")
+
+SlotConnectionInvariant(assetLocation) ==
+  SlotConnectionAllowed(assetLocation) <=> assetLocation = "normal"
