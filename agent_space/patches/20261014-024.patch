+      result := ApplicationDispatchProjectCommand(
+        "CHART_MODEL_REPLACED",
+        [chartId |-> chart.id, editable |-> editable]);
+    end if;
+  end if;
+EditableReturn:
+  return;
+end procedure;
+
+procedure SetHeaderLines(csvId, headerLines)
+begin
+HeaderDispatch:
+  result := ApplicationDispatchProjectCommand(
+    "DATA_OBJECT_REPLACED",
+    [csvId |-> csvId, headerLines |-> headerLines]);
+HeaderReturn:
+  return;
+end procedure;
+
+procedure UpdateChartLayout(values)
+begin
+LayoutDispatch:
+  result := ApplicationDispatchProjectCommand(
+    "CHART_LAYOUT_CHANGED",
+    [settings |-> values]);
+LayoutReturn:
+  return;
+end procedure;
+
+procedure ApplyGraphPalette(colors)
+begin
+PaletteDispatch:
+  result := ApplicationDispatchProjectCommand(
+    "GRAPH_OBJECTS_REPLACED",
+    [colors |-> colors]);
+PaletteReturn:
+  return;
+end procedure;
+
+procedure TracesSingle(objectView)
+variables values = NoReference;
+begin
+TraceResolveValues:
+  values := ResolveTraceColumnsAndDivisors(objectView);
+TraceDomainFilter:
+  values := RemoveReciprocalZeroAndLogNonPositive(values, objectView);
+TraceBuild:
+  result := BuildPlotlyTraceFromGraphObject(values, objectView);
+TraceSingleReturn:
+  return;
+end procedure;
+
+procedure Traces(chart)
+begin
+TraceResolveCsv:
+  assert EveryGraphObjectCsvResolves(chart);
+TraceAllObjects:
+  result := ConcatenateTraceProjectionPerObject(chart);
+TracesReturn:
+  return;
+end procedure;
+
+procedure RebuildEditable(chart)
+begin
+RebuildResolveReferences:
+  assert EveryGraphObjectCsvResolves(chart);
+RebuildTraces:
+  chartCandidate := ChartWithTracesFromEditorAndCsv(chart);
+RebuildLayout:
+  chartCandidate := ChartWithNormalizedLayout(chartCandidate);
+RebuildResult:
+  result := chartCandidate;
+RebuildReturn:
+  return;
+end procedure;
+
+procedure ImportGraphFile(file)
+variables slotValue = NoReference;
+begin
+ImportGraphResolveSlot:
+  slotValue := ResolveSelectedSlot();
+ImportGraphBuild:
+  if slotValue # NoReference then
+    if IsFfsx(file) then
+      projectCandidate := ReadAndRemapFfsx(file, slotValue);
+    else
+      chartCandidate := ParsePlotlyPreservingOriginal(file);
+      projectCandidate := AttachImportedChartToSlot(chartCandidate, slotValue);
+    end if;
+    assert ValidateWholeProject(projectCandidate);
+    result := ApplicationDispatchProjectCommand(
+      "SLOT_CHART_IMPORTED",
+      [slotId |-> slotValue.id, candidate |-> projectCandidate]);
   end if;
 ImportGraphReturn:
   return;
