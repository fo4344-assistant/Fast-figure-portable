+  else
+    result := NoReference;
+  end if;
+CollisionReturn:
+  return;
+end procedure;
+
+procedure ResolveImportPlan(model, choice, reservedPaths)
+begin
+ResolvePlanBranch:
+  if model.mode = "available" then
+    result := [path |-> model.path, replaceId |-> NoReference];
+  elsif choice = "replace" /\ model.replaceAllowed = TRUE then
+    result := [path |-> model.path, replaceId |-> model.replaceId];
+  else
+    result := [
