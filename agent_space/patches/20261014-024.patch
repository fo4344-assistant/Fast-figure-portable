+(*
+--algorithm FastFigureInteractionCore
+variables
+  selectedSlotId = NoSlot,
+  workspace = "project",
+  assetSelection = "none",
+  selectedCsvId = NoCsv,
+  project = InitialProject,
+  assetLocation = "normal",
+  assetReferenced = TRUE,
+  pendingCsvSelection = NoCsv,
+  reconcilePending = FALSE,
+  lastResult = "initialized";
+
+procedure ApplySlotSelection(slotId)
+variables projectBefore = project, locationBefore = assetLocation, referenceBefore = assetReferenced;
+begin
+SelectResolve:
+  if slotId = NoSlot then
+    selectedSlotId := NoSlot ||
+    workspace := "project" ||
+    lastResult := "slot-deselected";
+  elsif slotId \in SlotIds then
+    if selectedSlotId = slotId then
+      selectedSlotId := NoSlot ||
+      workspace := "project" ||
+      lastResult := "slot-deselected";
+    else
+      selectedSlotId := slotId ||
+      workspace := WorkspaceFor(slotId) ||
+      lastResult := "slot-selected";
+    end if;
+  else
+    lastResult := "invalid-slot";
+  end if;
+SelectInterfaceIsolation:
+  assert project = projectBefore /\ assetLocation = locationBefore /\ assetReferenced = referenceBefore;
+SelectReturn:
+  return;
+end procedure;
+
+procedure SlotSurfaceClick(slotId)
+begin
+SurfaceResolve:
+  if slotId \in SlotIds then
+    if selectedSlotId # slotId then
+      call ApplySlotSelection(slotId);
+    else
+      if SlotHasContent[slotId] then
+        lastResult := "content-pass-through";
+      else
+        call ApplySlotSelection(slotId);
+      end if;
+    end if;
+  else
+    lastResult := "invalid-slot";
+  end if;
+SurfaceReturn:
+  return;
+end procedure;
+
+procedure BookmarkClick(slotId)
+begin
+BookmarkResolve:
+  if slotId \in SlotIds then
+    call ApplySlotSelection(slotId);
+  else
+    lastResult := "invalid-slot";
+  end if;
+BookmarkReturn:
+  return;
+end procedure;
+
+procedure DashboardBackgroundClick()
+begin
+BackgroundDeselect:
+  if selectedSlotId # NoSlot then
+    call ApplySlotSelection(NoSlot);
+  end if;
+BackgroundReturn:
+  return;
+end procedure;
+
+procedure CreateEmptyCsvProject()
+variables
+  newCsvId = NoCsv,
+  previousGraphObjectCount = 0,
+  selectionBefore = assetSelection,
+  csvBefore = selectedCsvId;
+begin
+EmptyCsvRememberGraphObjects:
+  previousGraphObjectCount := Len(project.graphObjectCsvRefs);
+EmptyCsvCapacity:
+  if project.nextCsvId \in CsvIds then
+    newCsvId := project.nextCsvId;
+    project := [
+      project EXCEPT
+        !.csvIds = @ \cup {newCsvId},
+        !.nextCsvId = @ + 1
+    ] ||
+    pendingCsvSelection := newCsvId ||
+    reconcilePending := TRUE;
+  else
+    lastResult := "empty-csv-unavailable";
+  end if;
+EmptyCsvProjectDoesNotMutateInterface:
+  assert assetSelection = selectionBefore /\ selectedCsvId = csvBefore;
+EmptyCsvNoGraphObjectSideEffect:
+  assert pendingCsvSelection = NoCsv
+         \/ Len(project.graphObjectCsvRefs) = previousGraphObjectCount;
+EmptyCsvProjectReturn:
+  return;
+end procedure;
+
+procedure ReconcileEmptyCsvSelection()
+variables projectBefore = project;
+begin
+EmptyCsvReconcile:
+  if pendingCsvSelection # NoCsv then
+    assetSelection := "csv" ||
+    selectedCsvId := pendingCsvSelection ||
+    lastResult := "empty-csv-created";
+  end if;
+EmptyCsvInterfaceDoesNotMutateProject:
+  assert project = projectBefore;
+EmptyCsvClearResult:
+  pendingCsvSelection := NoCsv ||
+  reconcilePending := FALSE;
+EmptyCsvReconcileReturn:
+  return;
+end procedure;
+
+procedure MoveAsset(assetMoveSourceArg, assetTargetLocationArg)
+begin
+AssetMoveGuard:
+  if assetMoveSourceArg \in MoveSources
+     /\ assetTargetLocationArg \in AssetLocations
+     /\ TreeMoveAllowed(assetMoveSourceArg) then
+    if assetTargetLocationArg = "trash" /\ assetLocation # "trash" then
+      assetReferenced := FALSE;
+    end if;
+    assetLocation := assetTargetLocationArg;
+    if assetTargetLocationArg = "trash" then
+      lastResult := "asset-moved-trash";
+    else
+      lastResult := "asset-moved-normal";
+    end if;
+  else
+    lastResult := "asset-move-rejected";
+  end if;
+AssetMoveReturn:
+  return;
+end procedure;
+
+procedure ConnectAssetToSlot()
+begin
+AssetSlotConnectionGuard:
+  if SlotConnectionAllowed(assetLocation) then
+    assetReferenced := TRUE ||
+    lastResult := "asset-slot-connected";
+  else
+    lastResult := "asset-slot-connection-rejected";
+  end if;
+AssetSlotConnectionReturn:
+  return;
+end procedure;
+
+procedure AddGraphObject()
+begin
+AddGraphGuard:
+  if /\ selectedSlotId \in SlotIds
+     /\ SlotContentType[selectedSlotId] = "graph"
+     /\ selectedCsvId # NoCsv
+     /\ selectedCsvId \in project.csvIds
+     /\ Len(project.graphObjectCsvRefs) < MaxGraphObjects then
+    project := [
+      project EXCEPT
+        !.graphObjectCsvRefs = Append(@, selectedCsvId)
+    ] ||
+    lastResult := "graph-object-added";
+  else
+    lastResult := "graph-object-rejected";
+  end if;
+AddGraphReturn:
+  return;
+end procedure;
+
+begin
+Main:
+  while TRUE do
+    either
+      with surfaceSlotId \in SlotIds do
+        call SlotSurfaceClick(surfaceSlotId);
+      end with;
+    or
+      with bookmarkSlotId \in SlotIds do
+        call BookmarkClick(bookmarkSlotId);
+      end with;
+    or
+      call DashboardBackgroundClick();
+    or
+      call CreateEmptyCsvProject();
+      call ReconcileEmptyCsvSelection();
     or
       call AddGraphObject();
