+  if ValidGraphObjectIndex(objects, selectedIndex) then
+    objectCsv := ResolveProjectCsv(objects[selectedIndex].csvId);
+  end if;
+ReadGraphDataObjectColumns:
+  if objectCsv # NoValue then
+    objectColumns := ColumnDefinitionsForCsv(objectCsv);
+  end if;
+ReadGraphDataResult:
+  result := [
+    objects |-> objects,
+    selectedIndex |-> selectedIndex,
+    currentCsv |-> currentCsv,
+    columns |-> currentColumns,
+    objectColumns |-> objectColumns
+  ];
+ReadGraphDataReturn:
+  return;
+end procedure;
+
+procedure ChooseImportPlan(file, directory, reservedPaths)
+variables model = NoValue, choice = NoValue;
+begin
+CollisionModel:
+  model := CoreCollisionModel(file, directory, reservedPaths);
+CollisionAvailable:
+  if model.mode = "available" then
+    result := CoreResolveImportPlan(model, "available", reservedPaths);
+  else
+    collisionDraft := model ||
+    resolver := [file |-> file, directory |-> directory, reserved |-> reservedPaths];
+    choice := AwaitCollisionModalOutcome();
+    if choice = "rename" \/ choice = "replace" then
+      result := CoreResolveImportPlan(model, choice, reservedPaths);
+    else
+      result := NoValue;
+    end if;
+    collisionDraft := NoValue ||
+    resolver := NoValue;
+  end if;
+CollisionReturn:
+  return;
+end procedure;
