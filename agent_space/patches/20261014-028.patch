+    [name |-> NormalizeProjectName(name)]);
+ProjectNameReturn:
+  return;
+end procedure;
+
+procedure SetSlotContentType(slotId, contentType)
+begin
+SlotTypeDispatch:
+  result := ApplicationDispatchProjectCommand(
+    "SLOT_TYPE_CHANGED",
+    [slotId |-> slotId, type |-> NormalizeSlotContentType(contentType)]);
+SlotTypeReturn:
+  return;
+end procedure;
+
+procedure ResetSlots(slotIds)
+begin
+SlotsResetDispatch:
+  result := ApplicationDispatchProjectCommand(
+    "SLOTS_RESET",
+    [slotIds |-> slotIds]);
+SlotsResetReturn:
+  return;
+end procedure;
+
+procedure InsertEmptyImage(slotId)
+variables candidate = NoValue;
+begin
+EmptyImageBuild:
+  candidate := BuildEmptyImageAndSlotCandidate(slotId);
+EmptyImageDispatch:
+  if candidate # NoValue then
+    result := ApplicationDispatchProjectCommand(
+      "SLOT_IMAGE_IMPORTED",
+      [slotId |-> slotId, candidate |-> candidate]);
+  end if;
+EmptyImageReturn:
+  return;
+end procedure;
