+(*
+--algorithm FastFigureAssetsFiles
+variables
+  projectAuthority = ReadActiveProject(),
+  candidate = NoReference,
+  command = NoReference,
+  result = NoReference;
+
+procedure NormalizePath(value, isDirectory)
+begin
+NormalizeProjectPath:
+  result := NormalizeSlashAbsoluteProjectPath(value, isDirectory);
+PathSegments:
+  assert ~ContainsDotOrDotDotSegment(result)
+         /\ EveryPathSegmentUsesProjectNameRules(result);
+NormalizePathReturn:
+  return;
+end procedure;
+
+procedure AssetPath(asset)
+begin
+RecomputeAssetPath:
+  result := JoinCanonicalAssetDirectoryAndName(asset.directory, asset.name);
+AssetPathReturn:
+  return;
+end procedure;
+
+procedure ResolveVfs(pathValue, state)
+variables canonical = NoReference;
+begin
+ResolveNormalize:
+  canonical := NormalizeProjectPathValue(pathValue);
+ResolveUniqueVfsObject:
+  result := ResolveUniqueDirectoryCsvOrImage(canonical, state);
+ResolveVfsReturn:
+  return;
+end procedure;
+
+procedure UniquePath(pathValue, reservedPaths)
+begin
+UniqueCandidate:
+  result := CalculateCollisionFreePath(pathValue, projectAuthority, reservedPaths);
+UniquePathReturn:
+  return;
+end procedure;
+
+procedure Descendants(directory)
+begin
+DescendantCollect:
+  result := CollectByCanonicalSegmentBoundary(directory, projectAuthority);
+DescendantReturn:
+  return;
+end procedure;
+
+procedure BuildImportCollision(file, directory, reservedPaths)
+variables kind = NoReference, pathValue = NoReference;
+begin
+CollisionClassify:
+  kind := ClassifyAssetFile(file);
+CollisionCandidatePath:
+  pathValue := CandidateAssetPath(file, directory);
+CollisionDecision:
+  if kind # NoReference /\ DirectoryExistsAndNotTrash(directory) then
+    result := CollisionDecision(
+      kind,
+      pathValue,
+      ResolveVfsAgainstProject(pathValue),
+      reservedPaths);
+  else
+    result := NoReference;
+  end if;
+CollisionReturn:
+  return;
+end procedure;
+
+procedure ResolveImportPlan(model, choice, reservedPaths)
+begin
+ResolvePlanBranch:
+  if model.mode = "available" then
+    result := [path |-> model.path, replaceId |-> NoReference];
+  elsif choice = "replace" /\ model.replaceAllowed = TRUE then
+    result := [path |-> model.path, replaceId |-> model.replaceId];
+  else
+    result := [
+      path |-> CalculateCollisionFreePath(model.path, projectAuthority, reservedPaths),
+      replaceId |-> NoReference
+    ];
+  end if;
+ResolvePlanReturn:
+  return;
+end procedure;
+
+procedure ParseDataAsset(name, bytes)
+variables text = NoReference;
+begin
+ParseDecodeUtf8:
+  text := DecodeUtf8(bytes);
+ParseByFormat:
+  if HasJsonExtension(name) then
+    result := NormalizeJsonTopLevelOrDataArray(text);
+  else
+    result := ParseCsvOrTsvPreservingQuotedNewlinesAndBlankRows(name, text);
+  end if;
+ParseValidate:
+  assert ValidTabularShape(result);
+ParseReturn:
+  return;
+end procedure;
+
+procedure CreateCsv(data, name, id, bytesBase64, mime, headerLines, pathValue)
+begin
+CreateCsvCandidate:
+  candidate := NormalizeCsvAsset(data, name, id, bytesBase64, mime, headerLines, pathValue);
+CreateCsvCommand:
+  command := [name |-> "DATA_OBJECT_CREATED", asset |-> candidate];
+CreateCsvResult:
+  result := candidate;
+CreateCsvReturn:
+  return;
+end procedure;
+
+procedure CreateImage(bytes, name, mime, id, pathValue)
+begin
+CreateImageCandidate:
+  candidate := NormalizeImageAssetBytesNameMimeLocation(bytes, name, mime, id, pathValue);
+CreateImageOwnership:
+  assert ~ImageAssetContainsSlotDisplaySettings(candidate);
+CreateImageCommand:
+  command := [name |-> "IMAGE_OBJECT_CREATED", asset |-> candidate];
+CreateImageResult:
+  result := candidate;
+CreateImageReturn:
+  return;
+end procedure;
+
+procedure ImportBatch(files, directory, planImport)
+begin
+ImportTarget:
+  assert DirectoryExistsAndNotTrash(directory);
+ImportReadCandidates:
+  candidate := ReadAndParseAllAssetCandidates(files);
+ImportResolvePlans:
+  candidate := ApplyCollisionPlans(candidate, planImport, projectAuthority);
+ImportProjectCandidate:
+  candidate := ApplyAssetsAndNextIdsToProject(candidate, projectAuthority);
+ImportOptionalSlot:
+  candidate := ApplyRequestedSlotImportCandidate(candidate);
+ImportValidate:
+  assert ValidateWholeProject(candidate);
+ImportCommit:
+  projectAuthority := candidate;
+ImportResult:
+  result := ImportResult(candidate);
+ImportReturn:
+  return;
+end procedure;
+
+procedure CollectReferences(csvIds, imageIds, state)
