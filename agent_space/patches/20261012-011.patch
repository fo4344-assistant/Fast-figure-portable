+procedure BuildProjectObject(payload, fileName)
+begin
+ProjectImportHeader:
+  assert ValidImportedProjectHeader(payload);
+ProjectImportAssets:
+  candidate := NormalizeImportedCsvImageCollections(payload);
+ProjectImportCharts:
+  candidate := NormalizeChartsAndResolveCsvReferences(candidate);
+ProjectImportSlots:
+  candidate := NormalizeSlotGeometryContentSettingsAndCaptions(candidate);
+ProjectImportOwnership:
+  assert EveryChartHasExactlyOneOwner(candidate);
+ProjectImportPresentation:
+  candidate := NormalizeLabelsCaptionsAppearanceExport(candidate);
+ProjectImportNextIds:
+  candidate := SetNextIdsAboveCollectionMaxima(candidate);
+ProjectImportValidate:
+  assert ValidateWholeProject(candidate);
+ProjectImportResult:
+  result := candidate;
+ProjectImportReturn:
+  return;
+end procedure;
+
+procedure ImportProject(file)
+begin
+ImportProjectRead:
+  candidate := ReadFfpxCandidate(file);
+ImportProjectBuild:
+  candidate := BuildProjectObjectCandidate(candidate);
+ImportProjectValidate:
+  assert ValidateWholeProject(candidate);
+ImportProjectCommand:
+  command := [name |-> "PROJECT_LOADED", project |-> candidate];
+ImportProjectReturn:
+  return;
+end procedure;
+
+procedure BuildFfsx(slotValue, chart)
+begin
+FfsxCollectCsv:
+  candidate := CollectOnlyChartReferencedCsv(slotValue, chart, projectAuthority);
+FfsxRemapIds:
+  candidate := RemapCsvAndGraphObjectIdsToPackageLocal(candidate);
+FfsxEncode:
+  result := BuildFfsxEntries(candidate);
+FfsxBuildReturn:
+  return;
