+procedure downloadExportPayload(payload)
+variables owned = NoValue, bytes = NoValue, completion = NoValue;
+begin
+CopiedDataOnly:
+  completion := CaptureOriginalFailureOfPayloadEncoding(payload,"ZIP STORE if entries; otherwise copied bytes");
+  if completion.threw then goto DownloadCleanup; end if;
+  bytes := completion.value;
+  completion := CaptureOriginalFailureOfCreatingDownloadResource(bytes,payload.name,payload.mime);
+  if completion.threw then goto DownloadCleanup; end if;
+  owned := completion.value;
+OneBrowserHandoff:
+  completion := CaptureOriginalFailureOfOneBrowserHandoff(owned);
+DownloadCleanup:
+  if owned # NoValue then ReleaseThisDownloadResourceAfterSafeByteConsumptionOpportunity(owned,completion); end if;
+  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
+  result := NoValue;
+  \* No disk acknowledgement or imaginary observable-cancel outcome.
+  return;
+end procedure;
