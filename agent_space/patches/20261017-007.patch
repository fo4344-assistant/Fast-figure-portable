+procedure buildProjectObject(payload, fileName)
+variables candidate = NoValue;
+begin
+SchemaNameAndGrid:
+  Require(CurrentProjectSchemaAndPackageVersion(payload,PACKAGE_FORMAT_VERSION));
+  Require(ValidProjectNameAndGrid(payload));
+  \* ffpxReadProject has assembled the declared Project-shaped payload.
+  \* Do not infer a new name from fileName or bind the parsed payload as authority.
+  candidate := DeepCopy(payload);
