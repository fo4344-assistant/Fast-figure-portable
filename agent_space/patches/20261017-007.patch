+procedure ApplyFfsxInAttempt(source, slotPayload, targetSlot)
+variables candidate = NoValue, target = NoValue,
+          copy = DeepCopy(slotPayload.chart), ids = <<>>, mapping = [],
+          i = 1, j = 1, csv = NoValue, path = "", oldChartId = NoValue, retainedCharts = <<>>;
+begin
+CurrentTargetNotCallerSnapshot:
+  target := ResolveVisibleSlot(source,targetSlot.id);
+  Require(target # NoValue);
+  candidate := DeepCopy(source);
+RepresentationAwareIds:
+  call ReferencedProjectCsvIds(copy); ids := result;
+EachPackageLocalIdGetsOneActualProjectId:
+  while i <= Len(ids) do
+    csv := DeepCopy(ResolvePackageCsv(slotPayload,ids[i])); Require(csv # NoValue);
+    csv.id := candidate.nextId.csv; candidate.nextId.csv := csv.id + 1;
+    Require(IsValidSingleProjectFileName(csv.name));
+    path := JoinProjectPath(BackendSettings.defaults.vfs.csv,csv.name);
+    call normalizeProjectPath(path,FALSE); path := result;
+    Require(CurrentParentDirectoryExists(candidate,path));
+    call projectVfsUniquePath(path,candidate,{}); path := result;
+    csv.directory := CanonicalParent(path); csv.name := CanonicalLeaf(path);
+    RemoveField(csv,"dataRef");
+    csv.bytesBase64 := Base64Encode(CopyBytes(Base64Decode(csv.bytesBase64)));
+    mapping[ids[i]] := csv.id;
+    candidate.assets.csvFiles := Append(candidate.assets.csvFiles,csv);
+    i := i + 1;
+  end while;
+RemapOnlyRealProjectReferences:
+  call RemapRealProjectCsvIds(copy,mapping); copy := result;
+  \* imported/conversionRows/Plotly original are not rewritten as project CSVs.
+NewUniqueChartOwner:
+  copy.id := candidate.nextId.chart; candidate.nextId.chart := copy.id + 1;
+  oldChartId := target.content.chart;
+  if oldChartId # NoValue then
+    Require(CountSlotsReferencingChart(candidate,oldChartId) = 1);
+    Require(ResolveChart(candidate,oldChartId) # NoValue);
+  end if;
+RemoveOnlyReplacedOwnedChart:
+  j := 1;
+  while j <= Len(candidate.charts) do
+    if candidate.charts[j].id # oldChartId then retainedCharts := Append(retainedCharts,candidate.charts[j]); end if;
+    j := j + 1;
+  end while;
+  candidate.charts := Append(retainedCharts,copy);
+  CandidateSlot(candidate,target.id).content.chart := copy.id;
+  CandidateSlot(candidate,target.id).content.imageId := NoValue;
+  CandidateSlot(candidate,target.id).content.contentType := "graph";
+  \* Keep target identity/geometry/local display settings and unrelated assets/charts.
+  CandidateSlot(candidate,target.id).caption := slotPayload.caption;
+  call validateProjectObjectState(candidate,TRUE);
+  result := candidate;
+  \* No partial commit/Frontend selection/reverse callback. SLOT_CHART_IMPORTED final-commits once.
+  return;
+end procedure;
