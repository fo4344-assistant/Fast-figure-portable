+    while j <= Len(keys) do
+      row := Append(row, ObjectTableCellOrMissing(data[i], keys[j]));
+      j := j + 1;
+    end while;
+    matrix := Append(matrix, row);
+    i := i + 1;
+  end while;
+TableReturn:
+  result := matrix;
+  return;
+end procedure;
