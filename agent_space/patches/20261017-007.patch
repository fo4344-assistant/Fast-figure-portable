+  return;
+end procedure;
+
+procedure selectProjectCsv(path)
+variables resolved = NoValue, target = NoValue, final = NoValue, canonical = "";
+begin
+CurrentIdentityBeforeAnyEvent:
+  call dispatchProjectQuery("project-api",[operation |-> "assets.readDeletionTarget",path |-> path]); resolved := result;
+  if ~ResolvedTargetIsCsv(resolved) then result := NoValue; return; end if;
+  target := resolved.target; canonical := CanonicalAssetPath(target);
+ValidatedSingleTransition:
+  call dispatchInterfaceEvent("SELECT_ASSET",[kind |-> "csv",path |-> canonical]); final := result;
+  if final.assetSelection = "csv" /\ final.assetPath = canonical then result := target;
+  else result := NoValue; end if;
+  \* SELECT_ASSET itself clears graph object; no preceding clear/persistent mutation.
+  return;
+end procedure;
+
+procedure createEmptyProjectCsvAndSelect()
+variables csv = NoValue;
+begin
+CreateExactlyOnce:
+  call createEmptyProjectCsv(); csv := result;
+  if IsUncommittedCommandResult(csv) then result := csv; return; end if;
+SelectAfterCommitNotInsideBackend:
+  call selectProjectCsv(CanonicalAssetPath(csv));
+  \* None/throw after commit does not remove the created CSV or pretend noncommit.
+  return;
+end procedure;
+
+procedure ReadImportedAssetsInInputOrder(changed)
+variables paths = ActualImportedAssetPathsInInputOrder(changed), output = <<>>, i = 1;
+begin
+OfficialSuccessReadsOnly:
+  while i <= Len(paths) do
+    call dispatchProjectQuery("project-api",[operation |-> "assets.readDeletionTarget",path |-> paths[i]]);
+    output := Append(output,result.target); i := i + 1;
+  end while;
+  result := output;
+  return;
+end procedure;
+
+procedure CollectCompletedImportPlans(files,directory,planImport)
+variables plans = <<>>, reservedPaths = {}, i = 1, plan = NoValue;
+begin
+CompleteUiBeforeBackendCommand:
+  while i <= Len(files) do
+    \* planImport is the Source UI-local chooser, not a Backend callback.
+    \* Its official collision/resolve queries include this batch's reserved paths.
+    \* Await invokes the chooser exactly once; original throw propagates.
+    plan := AwaitUiChooserOnce(planImport,files[i],directory,reservedPaths);
+    if plan = NoValue then result := NoValue; return; end if;
+    Require(ValidFinalImportPlanShape(plan));
+    plans := Append(plans,DeepCopy(plan));
+    reservedPaths := reservedPaths \cup {plan.path};
+    i := i + 1;
+  end while;
+ReturnPlansNotCandidates:
+  \* Final path/optional replaceId only, no invented proposal/decision fields.
+  \* All plans/reservations are call-local and become untrusted command inputs.
+  result := plans;
+  return;
+end procedure;
+
+procedure importProjectFilesToDirectory(files,directory,planImport)
+variables choices = NoValue, tuple = NoValue;
+begin
+EmptyHasNoQueryChoiceOrCommand:
+  if Len(files) = 0 then result := <<>>; return; end if;
