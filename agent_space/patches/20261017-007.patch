+variables inputs = OrderedFileList(files), target = NoValue, output = <<>>, i = 1,
+          kind = "", item = NoValue, directory = "", initialState = NoValue;
+begin
+EmptyNoEffects:
+  if Len(inputs) = 0 then result := <<>>; return; end if;
+CaptureTargetExactlyOnce:
+  call InterfaceStateMachine_readState(); initialState := result; target := initialState.selectedSlotId;
