+(* --algorithm BackendAssets
+variables result = NoValue;
+
+procedure normalizeProjectPath(value, directory)
+variables parts = <<>>, i = 1, normalized = <<>>;
+begin
+SlashNormalizedAbsoluteSegments:
+  parts := AbsoluteProjectSegmentsAfterSlashNormalization(value,directory);
+ValidateEverySegment:
+  while i <= Len(parts) do
+    Require(parts[i] # "." /\ parts[i] # "..");
+    normalized := Append(normalized,NormalizeProjectFileNameSegment(parts[i]));
+    i := i + 1;
+  end while;
+CanonicalReturn:
+  result := JoinAbsoluteProjectSegments(normalized);
+  if ~directory then Require(result # "/"); end if;
+  \* directory lookup may name root; a file path must fail here, not in a later caller.
+  return;
+end procedure;
+
+procedure projectAssetPath(asset)
+begin
+DeriveNotStore:
+  Require(ValidDirectoryAndName(asset.directory,asset.name));
+  call normalizeProjectPath(JoinDirectoryAndName(asset.directory,asset.name),TRUE);
+  Require(result # "/");
+  return;
+end procedure;
+
+procedure slotFileKind(file)
+variables name = Lowercase(TextOrEmpty(FieldOrMissing(file,"name"))),
+          mime = Lowercase(TextOrEmpty(FieldOrMissing(file,"type")));
+begin
+PriorityIsNotContentSniffing:
+  if HasExtension(name,".ffsx") then result := "slot";
+  elsif Extension(name) \in {".csv",".tsv",".json"} then result := "data";
+  elsif StartsWith(mime,"image/") \/ Extension(name) \in {".png",".jpg",".jpeg",".gif",".webp",".bmp",".svg"} then result := "image";
+  else result := ""; end if;
+  \* .json is DATA here. Explicit Plotly/project imports have their own parser.
+  return;
+end procedure;
+
+procedure projectVfsResolve(path, state)
+variables canonical = "", matches = <<>>, i = 1, nodes = <<>>, node = NoValue;
+begin
+CanonicalLookup:
+  call normalizeProjectPath(path,TRUE); canonical := result;
+  nodes := CurrentFixedDirectoriesProjectDirectoriesCsvAndImages(state,FIXED_DIRECTORIES);
+  while i <= Len(nodes) do
+    node := nodes[i];
+    if CanonicalNodePath(node) = canonical then matches := Append(matches,node); end if;
+    i := i + 1;
+  end while;
+RequireUniqueOwner:
+  Require(Len(matches) <= 1);
+  if Len(matches) = 0 then result := NoValue; else result := matches[1]; end if;
+  return;
+end procedure;
+
+procedure projectVfsUniquePath(path, state, reservedPaths)
+variables candidate = path, suffix = 0, owner = NoValue;
+begin
+FindCollisionFreeSibling:
+  while TRUE do
+    call projectVfsResolve(candidate,state); owner := result;
+    if owner = NoValue /\ candidate \notin reservedPaths then result := candidate; return; end if;
+    suffix := suffix + 1;
+    candidate := SiblingPathWithCollisionSuffix(path,suffix);
+    \* Preserve parent and original basename/extension meaning. No node mutation.
+  end while;
+end procedure;
+
+procedure projectVfsDescendants(directory, state)
+variables parent = "", nodes = <<>>, output = <<>>, i = 1;
+begin
+SegmentBoundaryNotStringPrefix:
+  call normalizeProjectPath(directory,TRUE); parent := result;
+  nodes := CurrentProjectDirectoriesCsvAndImages(state);
+  while i <= Len(nodes) do
+    if IsDescendant(CanonicalNodePath(nodes[i]),parent) then output := Append(output,nodes[i]); end if;
+    i := i + 1;
+  end while;
+  result := output;
+  return;
+end procedure;
+
+procedure SerializeNewDataTable(table,path)
+variables extension = DataTableEncodingExtension(path), delimiter = ",", lines = <<>>, fields = <<>>,
+          i = 1, j = 1, value = NoValue, text = "";
+begin
+OnlySyntheticDataNotImportedOriginalBytes:
+  if extension = ".json" then result := EncodeUtf8(CompactJson(table)); return; end if;
+  if extension = ".tsv" then delimiter := Tab; end if;
+RowsAndFieldsInOriginalOrder:
+  while i <= Len(table) do
+    fields := <<>>; j := 1;
+    while j <= Len(table[i]) do
+      value := table[i][j];
+      if value = NoValue then text := "";
+      elsif IsRecord(value) \/ IsArray(value) then text := CompactJson(value);
+      else text := ScalarText(value); end if;
+      if Contains(text,delimiter) \/ Contains(text,Quote) \/ Contains(text,CR) \/ Contains(text,LF) then
+        text := Quote \o ReplaceAll(text,Quote,Quote \o Quote) \o Quote;
+      end if;
+      fields := Append(fields,text); j := j + 1;
+    end while;
+    lines := Append(lines,JoinText(fields,delimiter)); i := i + 1;
+  end while;
+  result := EncodeUtf8(JoinText(lines,LF)); return;
+end procedure;
+
+procedure CalculateAssetCollisionInProject(state, kind, directory, name, reservedPaths)
+variables parent = NoValue, path = "", owner = NoValue, mode = "";
+begin
+OneExplicitReadOrCandidate:
+  Require(kind \in {"data","image"});
+  call projectVfsResolve(directory,state); parent := result;
+  Require(IsDirectory(parent));
+  name := NormalizeProjectFileNameSegment(name);
+  call normalizeProjectPath(JoinDirectoryAndName(CanonicalNodePath(parent),name),FALSE); path := result;
+CurrentAndReservedCollision:
+  call projectVfsResolve(path,state); owner := result;
+  if path \in reservedPaths then mode := "rename-only";
+  elsif owner = NoValue then mode := "available";
+  elsif AssetKindEqualsFileKind(owner,kind) then mode := "replace-or-rename";
+  else mode := "rename-only"; end if;
+DetachedProposal:
+  result := [assetKind |-> kind,parent |-> CanonicalNodePath(parent),name |-> name,path |-> path,
+    mode |-> mode,replaceId |-> IF mode = "replace-or-rename" THEN owner.id ELSE NoValue,
+    information |-> CollisionUiInformation(owner,mode)];
+  return;
+end procedure;
+
+procedure projectAssetImportCollisionModel(file, directory, reservedPaths)
+variables source = activeProject, kind = "";
+begin
+RawAssetsOnly:
+  call slotFileKind(file); kind := result;
+  call CalculateAssetCollisionInProject(source,kind,directory,file.name,reservedPaths);
+  return;
+end procedure;
+
+procedure ResolveAssetPlanInProject(state, model, choice, reservedPaths)
+variables fresh = NoValue, path = "";
+begin
+ProposalIsNotAuthority:
+  Require(ValidCollisionProposalShape(model));
+  call CalculateAssetCollisionInProject(state,model.assetKind,model.parent,model.name,reservedPaths);
+  fresh := result;
+StaleReplaceBeforeAvailable:
+  if choice = "replace" /\ model.replaceId # NoValue then
+    Require(fresh.mode = "replace-or-rename");
+    Require(fresh.assetKind = model.assetKind /\ fresh.replaceId = model.replaceId);
+  end if;
+CurrentAvailable:
+  if fresh.mode = "available" then
+    result := [path |-> fresh.path,replaceId |-> NoValue];
+    return;
+  end if;
+ValidatedReplaceOrCurrentRename:
+  if choice = "replace" /\ fresh.mode = "replace-or-rename" /\ model.replaceId = fresh.replaceId then
+    result := [path |-> fresh.path,replaceId |-> fresh.replaceId];
+  else
+    call projectVfsUniquePath(fresh.path,state,reservedPaths); path := result;
+    result := [path |-> path,replaceId |-> NoValue];
+  end if;
+  \* Query/candidate share the calculation, not a stored VFS copy or reservation.
+  return;
+end procedure;
+
+procedure resolveProjectAssetImportPlan(model, choice, reservedPaths)
+variables source = activeProject;
+begin
+ReadOnceNoPromptOrReservation:
+  call ResolveAssetPlanInProject(source,model,choice,reservedPaths);
+  return;
+end procedure;
+
+\* Private construction of Source csvAsset/imageAsset metadata. VFS identity is
+\* the final canonical directory/name, never the original file's colliding name.
+\* Caller supplies id and CSV rows/header only inside its own candidate.
+procedure BuildAssetMetadata(kind, path, mime, bytes)
+variables canonical = "";
+begin
+CanonicalStoredLocation:
+  Require(kind \in {"csv","image"});
+  call normalizeProjectPath(path,FALSE); canonical := result;
+OwnedBytesAndNoSlotSettings:
+  result := [directory |-> CanonicalParent(canonical),name |-> CanonicalLeaf(canonical),
+             mime |-> mime,bytesBase64 |-> Base64Encode(CopyBytes(bytes))];
+  \* No path alias/original-name field, imageSettings, slot id, or mutable handle.
+  return;
+end procedure;
+
+procedure BuildAssetImportInAttempt(source, files, directory, planImport, targetSlotId)
+variables candidate = NoValue, target = NoValue, parent = NoValue, canonicalPath = "",
+          i = 1, kind = "", parsed = NoValue, plan = NoValue, asset = NoValue, reserved = {},
+          current = NoValue, facts = <<>>, outcome = NoValue;
+begin
+CommandContextAndCurrentTarget:
+  Require(InsideAssetsImportedCommand());
+  Require(ValidDirectoryInProject(directory,source));
+  if targetSlotId # NoValue then
+    target := ResolveVisibleSlot(source,targetSlotId);
+    Require(target # NoValue);
+  end if;
+  candidate := DeepCopy(source);
+NoBackendUiCallback:
+  Require(CompletedCollisionChoicesNotCallback(planImport));
+FileOrderWithinOneCandidate:
+  while i <= Len(files) do
+    call slotFileKind(files[i]); kind := result;
+    Require(kind \in {"data","image"});
+    if kind = "data" then
+      call parseProjectDataAsset(files[i].name,CopyBytes(files[i])); parsed := result;
+    else parsed := CopyImageBytesAndMetadata(files[i]); end if;
+    \* Parse may await in implementation. EFSM rechecks authority and recalculates
+    \* whole candidate on revision change; stale completed choices cannot retarget.
+    \* UI choosePlan returns the Source core final {path,replaceId} plan.
+    \* Do not require invented proposal/decision fields from that producer.
+    plan := planImport[i];
+    Require(ValidFinalImportPlanShape(plan));
+    call normalizeProjectPath(plan.path,FALSE); canonicalPath := result;
+    Require(canonicalPath = plan.path /\ CanonicalParent(canonicalPath) = directory);
+    call projectVfsResolve(directory,candidate); parent := result;
+    Require(IsDirectory(parent) /\ canonicalPath \notin reserved);
+    call projectVfsResolve(canonicalPath,candidate); current := result;
+    \* Final plan is input, not authority: current same-kind/id/path must match.
+    \* A now-occupied create path rejects rather than silently changing the plan.
+    call BuildAssetMetadata(AssetSequenceKind(kind),plan.path,FileMime(files[i]),CopyBytes(files[i])); asset := result;
+    if kind = "data" then
+      asset.rows := parsed;
+      asset.headerLines := NormalizeHeaderCount(1,parsed);
+    end if;
+    if plan.replaceId # NoValue then
+      Require(current # NoValue /\ AssetKindEqualsFileKind(current,kind));
+      Require(current.id = plan.replaceId);
+      asset.id := current.id;
+      ReplaceSameKindAssetAtId(candidate,AssetSequenceKind(kind),current.id,asset);
+      \* Referencing graph objects/image slots retain this id; no detach/relink.
+    else
+      Require(current = NoValue /\ plan.path \notin reserved);
+      asset.id := candidate.nextId[AssetSequenceKind(kind)];
+      AppendAssetOfKind(candidate,AssetSequenceKind(kind),asset);
+      candidate.nextId[AssetSequenceKind(kind)] := asset.id + 1;
+    end if;
+    reserved := reserved \cup {plan.path};
+    if target # NoValue then
+      if kind = "data" then
+        call ConnectDataInsideCandidate(candidate,targetSlotId,asset.id,asset.name);
+        candidate := result;
+      else
+        target := ResolveVisibleSlot(candidate,targetSlotId);
+        Require(target # NoValue /\ target.content.contentType = "image");
+        CandidateSlot(candidate,targetSlotId).content.imageId := asset.id;
+      end if;
+    end if;
+    facts := Append(facts,[kind |-> AssetSequenceKind(kind),id |-> asset.id,path |-> plan.path]);
+    i := i + 1;
+  end while;
+WholeCandidateOrReject:
+  call validateProjectObjectState(candidate,TRUE);
+  result := [candidate |-> candidate,importedAssets |-> facts];
+  \* Call-local actual facts preserve file order, never another persistent registry.
+  \* Caller EFSM rechecks authority and commits ONCE; retry discards candidate+facts.
+  return;
+end procedure;
+
+procedure buildProjectAssetImportCandidate(files, directory, planImport, targetSlotId)
+variables source = activeProject;
+begin
+SourceCandidateOnlyReturn:
+  call BuildAssetImportInAttempt(source,files,directory,planImport,targetSlotId);
+  result := result.candidate;
+  return;
+end procedure;
+
+procedure planProjectNodeMove(path, directory)
+variables readProject = activeProject, source = NoValue, target = NoValue, destination = "", references = NoValue;
+begin
+CurrentSourceIncludingTrash:
+  call projectVfsResolve(path,readProject); source := result;
+  Require(source # NoValue);
+  if CanonicalNodePath(source) \in FIXED_DIRECTORIES then
+    result := FixedDirectoryMoveRejected(source);
+    return;
+  end if;
+  \* Being inside trash is NOT a prohibition on source moves.
+  call projectVfsResolve(directory,readProject); target := result;
+  Require(IsDirectory(target));
+  destination := JoinDirectoryAndName(CanonicalNodePath(target),NodeName(source));
+  references := ReferencesForExactNodeOrSubtree(source,readProject);
+  result := [source |-> CanonicalNodePath(source),kind |-> NodeKind(source),
+     directory |-> CanonicalNodePath(target),destination |-> destination,
+     collision |-> CurrentCollisionAt(destination),uniqueName |-> CurrentUniqueSiblingName(destination),
+     enteringTrash |-> ~InTrash(CanonicalNodePath(source)) /\ InTrash(destination),
+     referenceCount |-> Len(references)];
+  return;
+end procedure;
+
+procedure projectFileStem(value)
+variables text = Trim(TextOrEmpty(value)), output = "", i = 1, char = "";
+begin
+ReplaceUnsafeCharacters:
+  while i <= Len(text) do
+    char := text[i];
+    if char \in {"\\","/",":","*","?","\"","<",">","|"} \/ IsControlU0000To001F(char) then char := "-"; end if;
+    output := output \o char;
+    i := i + 1;
+  end while;
+CollapseAndLimit:
+  output := CollapseWhitespaceRunsToOneSpace(output);
+  output := RemoveTrailingDotAndSpace(output);
+  output := FirstTextUnits(output,BackendSettings.defaults.naming.exportStemMaxLength);
+  if Len(output) = 0 then output := "fast-figure-project"; end if;
+  result := output;
+  return;
+end procedure;
+
+procedure ParseDelimitedText(text, delimiter)
+variables rows = <<>>, row = <<>>, field = "", i = 1, char = "", quoted = FALSE,
+          afterQuote = FALSE, explicitLine = FALSE, pendingBlankLines = 0;
+begin
+CharacterOrder:
+  while i <= Len(text) do
+    char := text[i];
+    if quoted then
+      if char = "\"" then
+        if i < Len(text) then
+          if text[i + 1] = "\"" then field := field \o "\""; i := i + 2; goto ContinueCharacter; end if;
+        end if;
+        quoted := FALSE;
+        afterQuote := TRUE;
+      else field := field \o char; end if;
+      i := i + 1;
+      goto ContinueCharacter;
+    end if;
+    if char = delimiter then
+      row := Append(row,field); field := ""; afterQuote := FALSE; explicitLine := TRUE;
+    elsif IsLineBreakCharacter(char) then
+      if explicitLine \/ Len(field) > 0 \/ Len(row) > 0 \/ afterQuote then
+        while pendingBlankLines > 0 do rows := Append(rows,<<"">>); pendingBlankLines := pendingBlankLines - 1; end while;
+        rows := Append(rows,Append(row,field));
+      else pendingBlankLines := pendingBlankLines + 1; end if;
+      row := <<>>; field := ""; afterQuote := FALSE; explicitLine := FALSE;
+      if char = CarriageReturn() /\ i < Len(text) then
+        if text[i + 1] = LineFeed() then i := i + 1; end if;
+      end if;
+    elsif char = "\"" then
+      Require(Len(field) = 0 /\ ~afterQuote);
+      quoted := TRUE; explicitLine := TRUE;
+    else
+      Require(~afterQuote);
+      field := field \o char; explicitLine := TRUE;
+    end if;
+    i := i + 1;
+ContinueCharacter:
+    skip;
+  end while;
+FinishFieldNotTrailingPhysicalBlank:
+  Require(~quoted);
+  if explicitLine \/ Len(field) > 0 \/ Len(row) > 0 \/ afterQuote then
+    while pendingBlankLines > 0 do rows := Append(rows,<<"">>); pendingBlankLines := pendingBlankLines - 1; end while;
+    rows := Append(rows,Append(row,field));
+  end if;
+  \* Unflushed pending blank physical lines are trailing, not synthetic data rows.
+  result := rows;
+  return;
+end procedure;
+
+procedure parseProjectDataAsset(name, bytes)
+variables text = DecodeUtf8(bytes), extension = Lowercase(Extension(name)), input = NoValue;
+begin
+ExtensionSpecificDecode:
+  if extension = ".json" then
+    input := ParseJson(text);
+    if IsRecord(input) then Require(IsSequence(FieldOrMissing(input,"data"))); input := input.data; end if;
+    call dataTable(input);
+  else
+    Require(extension \in {".csv",".tsv"});
+    call ParseDelimitedText(text,IF extension = ".tsv" THEN TabCharacter() ELSE ",");
+    input := result;
+    call dataTable(input);
+  end if;
+  \* Original bytes remain separate asset input; rows never replace owned bytes.
+  return;
+end procedure;
