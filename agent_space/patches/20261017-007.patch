+procedure dataTable(data)
+variables matrix = <<>>, keys = <<>>, i = 1, row = <<>>, j = 1;
+begin
+RequireNonemptyArray:
+  Require(IsSequence(data) /\ Len(data) > 0);
+ChooseRowShape:
+  if EveryElementIsSequence(data) then
+    result := DeepCopy(data);
