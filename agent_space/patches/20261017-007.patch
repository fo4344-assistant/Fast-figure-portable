+AtomicBatchCandidate:
+  call dispatchProjectCommand("ASSETS_IMPORTED",[files |-> CopiedFileInputs(files),directory |-> directory,choices |-> choices]); tuple := result;
+  if ~tuple[1].committed then result := tuple[1]; return; end if;
