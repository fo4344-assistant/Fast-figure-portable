+PaletteHasItsOwnWholePaletteRule:
+  if ~HasField(candidate,"appearance") then candidate.appearance := []; end if;
+  if HasField(candidate.appearance,"uiPalette") then supplied := candidate.appearance.uiPalette; end if;
+  Require(IsRecord(supplied));
+  names := PropertyNames(BackendSettings.project_object.appearance.uiPalette); i := 1;
+  while i <= Len(names) do
+    key := names[i];
+    if HasField(supplied,key) then
+      if IsSixDigitHexColor(supplied[key]) then palette[key] := supplied[key];
+      else palette[key] := BackendSettings.project_object.appearance.uiPalette[key]; end if;
+    else palette[key] := BackendSettings.project_object.appearance.uiPalette[key]; end if;
+    i := i + 1;
