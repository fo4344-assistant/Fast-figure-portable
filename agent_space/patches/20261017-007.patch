+procedure BuildPlainProjectRead(source)
+variables read = NoValue;
+begin
+SameOfficialPathsWithoutRecursivePackageExport:
+  call SnapshotProjectPathsInRead(source,<<"project","layout","labels","captions",
+    "data","images","files","charts","slots","sequences","appearance","export">>);
+  read := result;
+AssembleProjectShapeNotAnotherSchema:
+  result := ImmutableCopy([kind |-> source.kind,meta |-> read.project,layout |-> read.layout,
+    annotations |-> [labels |-> read.labels,captions |-> read.captions],
+    assets |-> [csvFiles |-> read.data,images |-> read.images],
+    fileSystem |-> [directories |-> read.files],charts |-> read.charts,slots |-> read.slots,
+    nextId |-> read.sequences,appearance |-> read.appearance,export |-> read.export]);
+  \* Call-local immutable snapshot. Never retained or supplied as command mutation input.
+  return;
+end procedure;
