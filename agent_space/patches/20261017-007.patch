+procedure ffsxReadSlot(file)
+variables entries = <<>>, payload = NoValue, i = 1, asset = NoValue, localIds = {}, bytes = NoValue;
+begin
+StoreCrcPathVersion:
+  call ReadStorePackage(file,"slot"); entries := result;
+  call ReadFfsxDocumentPayload(entries); payload := result;
+CsvBytesAndRealReferences:
+  while i <= Len(payload.csvFiles) do
+    asset := payload.csvFiles[i];
+    Require(IsPositiveInteger(asset.id) /\ asset.id \notin localIds);
+    localIds := localIds \cup {asset.id};
+    Require(DataRefInAllowedSubtree(asset,"assets/data") /\ EntryExists(entries,asset.dataRef));
+    bytes := CopyBytes(EntryBytes(entries,asset.dataRef));
+    asset.bytesBase64 := Base64Encode(bytes);
+    call parseProjectDataAsset(asset.name,bytes); asset.rows := result;
+    RemoveField(asset,"dataRef");
+    payload.csvFiles[i] := asset;
+    i := i + 1;
+  end while;
+  call validateChartModel(payload.chart,payload.csvFiles);
+  \* Its ordinary-object branch resolves every csvId in THIS package collection.
+  \* Its conversion branch validates the table/columns without project/local CSV resolve.
+  \* No id=0/protected default CSV; conversion objects do not resolve package CSVs.
+  result := payload;
+  return;
+end procedure;
