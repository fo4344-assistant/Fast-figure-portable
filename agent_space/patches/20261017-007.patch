+RecomputeIdsAndWholeValidate:
+  candidate.nextId := [csv |-> MaximumIdOrZero(candidate.assets.csvFiles) + 1,
+                       image |-> MaximumIdOrZero(candidate.assets.images) + 1,
+                       chart |-> MaximumIdOrZero(candidate.charts) + 1];
