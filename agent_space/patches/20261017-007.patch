+procedure CompleteGraphRender(host,slotId,chartId,generation,completion)
+begin
+DiscardStaleCompletionWithoutResurrection:
+  if generation # dashboardGeneration \/ ~SameLiveGraphHostSlotChart(graphInstances,host,slotId,chartId,generation) then
+    ReleaseOnlyCompletionTemporaryResources(completion);
+    result := NoValue; return;
+  end if;
+  if completion.threw then
+    ReleaseOnlyCompletionTemporaryResources(completion);
+    PropagateOriginalFailure(completion.failure);
+  end if;
+  ApplyCompletedPresentationToCurrentHostOnly(host,completion);
+  RequestGenerationCheckedResize(host,slotId,chartId,generation);
+  result := NoValue;
+  return;
+end procedure;
+
+procedure CompleteImageRender(host,slotId,imageInput,generation,completion)
+begin
+SurfaceOwnsHandleNotSharedImageAsset:
+  if generation # dashboardGeneration \/ ~SameCurrentImageSurfaceInput(host,slotId,imageInput,generation) then
+    ReleaseOnlyCompletionTemporaryResources(completion); result := NoValue; return;
+  end if;
+  if completion.threw then
+    ReleaseOnlyCompletionTemporaryResources(completion); PropagateOriginalFailure(completion.failure);
+  end if;
+  InstallCompletedImageOnCurrentSurface(host,completion);
+  \* Removing this surface cannot revoke another live surface's handles/URLs.
+  result := NoValue;
+  return;
+end procedure;
