+procedure ProjectStateMachine_send(event, payload)
+variables sourceReference = NoValue, resolved = NoValue, calculation = NoValue,
+          candidate = NoValue, transactionOutcome = NoValue, pre = NoValue, post = NoValue;
+begin
+DeclaredMutationEntry:
+  if event \notin PROJECT_COMMANDS then RejectDeclaredCommandUnchanged(event); end if;
+  \* No Application-provided full candidate/model/current objects; only identities,
+  \* new edit values/raw files and completed collision choices are admissible.
+  assert DeclaredPayloadAndWritableScope(event, payload);
+ReResolveCurrentAuthority:
+  sourceReference := CurrentAuthorityReference(activeProject);
+  resolved := ResolveCommandInputsAndPreconditions(event, payload, sourceReference);
+  if resolved.rejected then result := UncommittedUnchanged(); return; end if;
+CalculateWithoutAuthorityWrites:
+  \* Mechanical exception/await adapter invokes CalculateSourceCommandCandidate
+  \* exactly once for THIS attempt and observes returned noncommit versus throw.
+  \* It is not a command engine, public envelope, persisted task, or second owner.
+  transactionOutcome := AwaitSourceCalculationCapturingOnlyReturnOrThrow(
+    CalculateSourceCommandCandidate,event,payload,sourceReference);
+DistinguishFailureFromSuccessfulCandidate:
+  if transactionOutcome.threw then
+    PropagateOriginalFailure(transactionOutcome.failure);
+  elsif transactionOutcome.cancelled \/ ~transactionOutcome.hasCandidate then
+    result := UncommittedUnchanged();
+    return;
+  end if;
+  calculation := transactionOutcome.calculation;
+  candidate := calculation.candidate;
+RevalidateAfterFileWait:
+  \* Domain calculation re-resolves current VFS/target/references/collision/next-id
+  \* after its await and validates completed replace choices against same id/path.
+  \* No UI resolver callback, silent rename/replace selection, partial write or rollback.
+  if CurrentAuthorityReference(activeProject) # sourceReference then goto ReResolveCurrentAuthority; end if;
+ValidateWholeCandidate:
+  call validateProjectObjectState(candidate, TRUE);
+CommitExactlyOnce:
+  \* Final freshness comparison + synchronous validated state replacement is ONE
+  \* Source transaction boundary; implementation/optional verification must not
+  \* introduce a yield/interleaving inside it. It is not a new lock/FSM/state.
+  if CurrentAuthorityReference(activeProject) # sourceReference then goto ReResolveCurrentAuthority; end if;
+  pre := sourceReference;
+  call ProjectObject_initialize(candidate);
+  post := CurrentAuthorityReference(activeProject);
+FormActualImmutableResult:
+  call FormActualMutationResult(event,pre,post,calculation);
+  \* ActualSelectionHints uses same original-index filter/actual reference set:
+  \* append -> actual append index; move -> final to; edit -> same index;
+  \* direct delete -> explicit none; palette/no hint -> omitted key.
+  \* Cascade maps are recalculated on retry, include only affected retained charts,
+  \* and exclude noneditable imported conversion views using graph validator scope.
+  \* No Frontend state read/write, reconciliation, renderer invocation or extra commit.
+ReturnMutationResult:
+  return;
+end procedure;
