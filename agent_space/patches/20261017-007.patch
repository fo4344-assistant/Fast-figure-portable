+procedure FillMissingSettingRecord(current,defaults)
+variables copy = DeepCopy(current), names = PropertyNames(defaults), i = 1, key = "";
+begin
+SettingsFieldsOnly:
+  Require(IsRecord(current));
+  while i <= Len(names) do
+    key := names[i];
+    if ~HasField(copy,key) then
+      copy[key] := DeepCopy(defaults[key]);
+    elsif IsRecord(defaults[key]) then
+      if IsRecord(copy[key]) then
+        call FillMissingSettingRecord(copy[key],defaults[key]);
+        copy[key] := result;
+      end if;
+      \* A present malformed value is NOT missing. Owner/whole validation
+      \* rejects or normalizes it under that owner's existing rule.
+    end if;
+    i := i + 1;
+  end while;
+MissingMergeReturn:
+  result := copy;
+  return;
+end procedure;
