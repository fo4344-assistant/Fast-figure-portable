+procedure collectAssetReferences(csvIds, imageIds, state)
+variables refs = <<>>, ci = 1, oi = 1, si = 1, chart = NoValue, object = NoValue, slot = NoValue;
+begin
+ChartOriginalPositionsNotEqualityRematch:
+  while ci <= Len(state.charts) do
+    chart := state.charts[ci];
+    if ~ConversionRepresentation(chart) then
+      oi := 1;
+      while oi <= Len(chart.editor.objects) do
+        object := chart.editor.objects[oi];
+        if object.csvId \in csvIds then refs := Append(refs,[kind |-> "csv",assetId |-> object.csvId,
+           chartId |-> chart.id,originalObjectIndex |-> oi - 1,object |-> object]); end if;
+        oi := oi + 1;
+      end while;
+    end if;
+    ci := ci + 1;
+  end while;
+ImagePerSlot:
+  while si <= Len(state.slots) do
+    slot := state.slots[si];
+    if FieldOrMissing(slot.content,"imageId") \in imageIds then
+      refs := Append(refs,[kind |-> "image",assetId |-> slot.content.imageId,slotId |-> slot.id,slot |-> slot]);
+    end if;
+    si := si + 1;
+  end while;
+  \* Repeated same-CSV objects count separately. Confirmation and cascade share this set.
+  result := refs;
+  return;
+end procedure;
+
+procedure ffpxEncodeValue(value)
+variables element = NoValue, i = 1, names = <<>>, key = "", children = <<>>;
+begin
+TypedWriter:
+  if value = NoValue then element := TypedXmlScalar("null",NoText());
+  elsif IsBoolean(value) then element := TypedXmlScalar("boolean",IF value THEN "true" ELSE "false");
+  elsif IsNumber(value) then Require(IsFinite(value)); element := TypedXmlScalar("number",FiniteNumberText(value));
+  elsif IsText(value) then element := TypedXmlScalar("string",XmlEscapeText(value));
+  elsif IsSequence(value) then
+    while i <= Len(value) do
+      call ffpxEncodeValue(value[i]); children := Append(children,XmlItem(result)); i := i + 1;
+    end while;
+    element := TypedXmlContainer("array",children);
+  elsif IsRecord(value) then
+    names := PropertyNames(value);
+    while i <= Len(names) do
+      key := names[i]; call ffpxEncodeValue(value[key]);
+      children := Append(children,XmlProperty(XmlEscapeAttribute(key),result)); i := i + 1;
+    end while;
+    element := TypedXmlContainer("object",children);
+  else FailWriter("unsupported typed XML value"); end if;
+  result := element;
+  return;
+end procedure;
+
+procedure ffpxDecodeValue(element)
+variables value = NoValue, i = 1, children = <<>>, key = "", decoded = NoValue;
+begin
+StrictTypeAndShape:
+  Require(IsTypedValueElement(element));
+  if element.type = "null" then Require(NullHasNoScalarChildren(element)); value := NoValue;
+  elsif element.type = "boolean" then Require(ScalarOnly(element) /\ element.text \in {"true","false"}); value := element.text = "true";
+  elsif element.type = "number" then Require(ScalarOnly(element)); value := ParseNumber(element.text); Require(IsFinite(value));
+  elsif element.type = "string" then Require(ScalarOnly(element)); value := XmlUnescapeText(element.text);
+  elsif element.type = "array" then
+    Require(ArrayItemValueChildShape(element)); children := element.children; value := <<>>;
+    while i <= Len(children) do call ffpxDecodeValue(children[i].value); value := Append(value,result); i := i + 1; end while;
+  elsif element.type = "object" then
+    Require(ObjectPropertyValueChildShape(element)); children := element.children; value := [];
+    while i <= Len(children) do
+      key := XmlUnescapeAttribute(children[i].name); call ffpxDecodeValue(children[i].value); value[key] := result; i := i + 1;
+    end while;
+  else FailReader("unknown typed XML type"); end if;
+  result := value;
+  return;
+end procedure;
+
+procedure ReadStorePackage(file, packageKind)
+variables entries = <<>>, i = 1, entry = NoValue;
+begin
+ContainerValidation:
+  Require(IsZipContainer(file) /\ ~IsSplitZip(file));
+  entries := ReadZipDirectoryAndEntries(file);
+EachEntry:
+  while i <= Len(entries) do
+    entry := entries[i];
+    Require(entry.compression = "STORE");
+    Require(~IsAbsoluteEntryPath(entry.path) /\ ~HasDotDotSegment(entry.path));
+    Require(Crc32(entry.bytes) = entry.crc32);
+    i := i + 1;
+  end while;
+SchemaAndVersion:
+  Require(ManifestKind(entries) = packageKind /\ ManifestVersion(entries) = PACKAGE_FORMAT_VERSION);
+  result := entries;
+  return;
+end procedure;
+
+procedure ReferencedProjectCsvIds(chart)
+variables ids = <<>>, seen = {}, i = 1;
+begin
+SharedRepresentationScope:
+  if ~ConversionRepresentation(chart) then
+    while i <= Len(chart.editor.objects) do
+      if chart.editor.objects[i].csvId \notin seen then
+        ids := Append(ids,chart.editor.objects[i].csvId);
+        seen := seen \cup {chart.editor.objects[i].csvId};
+      end if;
+      i := i + 1;
+    end while;
+  end if;
+CsvIdsReturn:
+  result := ids;
+  return;
+end procedure;
+
+procedure RemapRealProjectCsvIds(chart,mapping)
+variables copy = DeepCopy(chart), i = 1;
+begin
+NoImportedConversionRewrite:
+  if ~ConversionRepresentation(copy) then
+    while i <= Len(copy.editor.objects) do
+      Require(HasField(mapping,copy.editor.objects[i].csvId));
+      copy.editor.objects[i].csvId := mapping[copy.editor.objects[i].csvId];
+      i := i + 1;
+    end while;
+  end if;
+RemappedChartReturn:
+  result := copy;
+  return;
+end procedure;
+
+\* XML tree/UTF-8 operations below are platform-neutral codec primitives.
+\* Literal document/tag spelling binds the Source's existing package version,
+\* not a new Project schema or second scalar grammar.
+procedure EncodeNamedXml(name,value)
+begin
+SingleTypedValueGrammar:
+  call ffpxEncodeValue(value);
+  result := XmlElement(name,[],<<result>>);
+  return;
+end procedure;
+
+procedure AddPackageXml(entries,path,root,children)
+begin
+VersionedCopiedEntry:
+  result := Append(entries,[path |-> path,
+            bytes |-> EncodeUtf8Xml(VersionedXmlDocument(root,PACKAGE_FORMAT_VERSION,children))]);
+  return;
+end procedure;
+
+procedure EncodeGraphXml(chart)
+variables settings = DeepCopy(chart), nodes = <<>>, i = 1, settingsNode = NoValue;
+begin
+SeparateObjectsFromTheOneGraphSettingsCopy:
+  settings.editor.objects := <<>>;
+  call EncodeNamedXml("settings",settings); settingsNode := result;
+OrderedObjectsThroughTheSameTypedGrammar:
+  while i <= Len(chart.editor.objects) do
+    call ffpxEncodeValue(chart.editor.objects[i]);
+    nodes := Append(nodes,XmlElement("graphObject",[index |-> i - 1],<<result>>));
+    i := i + 1;
+  end while;
+GraphXmlReturn:
+  result := XmlElement("graph",[],<<settingsNode,XmlElement("graphObjects",[],nodes)>>);
+  return;
+end procedure;
+
+procedure BuildFfpxDocumentEntries(snapshot)
+variables entries = <<>>, i = 1, k = 1,
+          asset = NoValue, metadata = NoValue, dataRef = "", typedAssets = <<>>,
+          typedImages = <<>>, projectDocument = [], layoutDocument = [],
+          captionDocument = [], labelDocument = [], placements = <<>>,
+          slot = NoValue, chart = NoValue, children = <<>>, node = NoValue,
+          kinds = <<"csv","image">>, collection = <<>>, documentRefs = <<>>;
+begin
+MetadataAndOwnedBytesInTheSameOrder:
+  while k <= Len(kinds) do
+    collection := IF kinds[k] = "csv" THEN snapshot.assets.csvFiles ELSE snapshot.assets.images;
+    i := 1;
+    while i <= Len(collection) do
+      asset := collection[i]; metadata := DeepCopy(asset);
+      RemoveField(metadata,"bytesBase64");
+      if kinds[k] = "csv" then
+        RemoveField(metadata,"rows");
+        dataRef := "assets/" \o CurrentVersionCsvDataRef(metadata);
+        Require(SafePackagePathInSubtree(dataRef,"assets/data"));
+      else
+        dataRef := CurrentVersionImageDataRef(metadata);
+        Require(SafePackagePathInSubtree(dataRef,"assets/media"));
+      end if;
+      metadata.dataRef := dataRef;
+      call ffpxEncodeValue(metadata);
+      if kinds[k] = "csv" then
+        typedAssets := Append(typedAssets,XmlElement("dataAsset",[id |-> metadata.id,src |-> dataRef],<<result>>));
+      else
+        typedImages := Append(typedImages,XmlElement("imageAsset",[id |-> metadata.id,src |-> dataRef],<<result>>));
+      end if;
+      entries := Append(entries,[path |-> dataRef,bytes |-> CopyBytes(Base64Decode(asset.bytesBase64))]);
+      i := i + 1;
+    end while;
+    k := k + 1;
+  end while;
+ProjectMetadataNotLiveObjects:
+  projectDocument := [schema |-> "fast-figure-project",version |-> PACKAGE_FORMAT_VERSION,
+    appBuild |-> snapshot.meta.appBuild,projectName |-> snapshot.meta.projectName,
+    exportedAt |-> ExportTimestampForThisCall(),fileSystem |-> DeepCopy(snapshot.fileSystem),
+    appearance |-> [slotStyle |-> DeepCopy(snapshot.layout.slotStyle),uiPalette |-> DeepCopy(snapshot.appearance.uiPalette)],
+    export |-> DeepCopy(snapshot.export)];
+  documentRefs := <<XmlElement("assets",[ref |-> "assets/assets.xml"],<<>>),
+    XmlElement("slots",[ref |-> "slots/"],<<>>),
+    XmlElement("layout",[ref |-> "layout/layout.xml"],<<>>),
+    XmlElement("caption",[ref |-> "caption/caption.xml"],<<>>),
+    XmlElement("labels",[ref |-> "labels/labels.xml"],<<>>)>>;
+  call EncodeNamedXml("settings",projectDocument); node := result;
+  call AddPackageXml(entries,"project.xml","fastFigureProject",Append(documentRefs,node)); entries := result;
+MandatoryAssetsDocumentIncludingEmptyCollections:
+  call AddPackageXml(entries,"assets/assets.xml","fastFigureAssets",
+       <<XmlElement("dataAssets",[],typedAssets),XmlElement("imageAssets",[],typedImages)>>); entries := result;
+PlacementDocumentOwnsGeometryOnly:
+  i := 1;
+  while i <= Len(snapshot.slots) do
+    slot := snapshot.slots[i];
+    placements := Append(placements,[slotId |-> slot.id,row |-> slot.row,col |-> slot.col,
+                           rowSpan |-> slot.rowSpan,colSpan |-> slot.colSpan]);
+    i := i + 1;
+  end while;
+  layoutDocument := [gridRows |-> snapshot.layout.gridRows,gridCols |-> snapshot.layout.gridCols,placements |-> placements];
+  call EncodeNamedXml("layout",layoutDocument); node := result;
+  call AddPackageXml(entries,"layout/layout.xml","fastFigureLayout",<<node>>); entries := result;
+AnnotationDocuments:
+  captionDocument := [enabled |-> snapshot.annotations.captions.enabled,
+      beforeText |-> snapshot.annotations.captions.text,afterText |-> snapshot.annotations.captions.afterText,
+      name |-> snapshot.annotations.captions.name,nameBold |-> snapshot.annotations.captions.nameBold,
+      settings |-> DeepCopy(snapshot.annotations.captions.settings)];
+  labelDocument := DeepCopy(snapshot.annotations.labels);
+  call EncodeNamedXml("caption",captionDocument); node := result;
+  call AddPackageXml(entries,"caption/caption.xml","fastFigureCaption",<<node>>); entries := result;
+  call EncodeNamedXml("labels",labelDocument); node := result;
+  call AddPackageXml(entries,"labels/labels.xml","fastFigureLabels",<<node>>); entries := result;
+EachSlotSplitsItsStateWithoutChangingOwnership:
+  i := 1;
+  while i <= Len(snapshot.slots) do
+    slot := snapshot.slots[i]; children := <<>>;
+    call EncodeNamedXml("settings",[id |-> slot.id,contentType |-> slot.content.contentType]); children := Append(children,result);
+    call EncodeNamedXml("caption",[text |-> slot.caption]); children := Append(children,result);
+    if slot.content.chart # NoValue then
+      chart := ChartById(snapshot,slot.content.chart); Require(chart # NoValue);
+      call EncodeGraphXml(chart); children := Append(children,result);
+    end if;
+    if slot.content.imageId # NoValue then Require(ImageById(snapshot,slot.content.imageId) # NoValue); end if;
+    \* Slot-local settings survive even with no image: null imageRef is not a fake asset.
+    \* The existing typed imageObject/settings representation can express this case.
+    call ffpxEncodeValue([imageRef |-> slot.content.imageId,settings |-> DeepCopy(slot.content.imageSettings)]);
+    if slot.content.imageId = NoValue then
+      children := Append(children,XmlElement("imageObject",[],<<result>>));
+    else
+      children := Append(children,XmlElement("imageObject",[imageRef |-> slot.content.imageId],<<result>>));
+    end if;
+    node := XmlElement("slot",[id |-> slot.id,contentType |-> slot.content.contentType],children);
+    call AddPackageXml(entries,"slots/slot-" \o IntegerText(slot.id) \o ".xml","fastFigureSlot",<<node>>); entries := result;
+    i := i + 1;
+  end while;
+DocumentsReturn:
+  \* Entry sequence order is not Project identity; references and object order are.
+  \* No bytes regenerated from rows, chart cloning, resource allocation or commit.
+  result := entries;
+  return;
+end procedure;
+
+procedure ffpxBuildProject()
+variables source = activeProject;
+begin
+OneOfficialReadContext:
+  call BuildFfpxInRead(source);
+  return;
+end procedure;
+
+procedure BuildFfpxInRead(source)
+variables snapshot = NoValue, entries = <<>>, i = 1,
+          asset = NoValue, retained = <<>>, path = "", slot = NoValue;
+begin
+ValidateThenOfficialExportSnapshot:
+  call validateProjectObjectState(source,TRUE);
+  call BuildPlainProjectRead(source); snapshot := DeepCopy(result);
+FilterCsvTrashWithoutTouchingAuthority:
+  i := 1; retained := <<>>;
+  while i <= Len(snapshot.assets.csvFiles) do
+    asset := snapshot.assets.csvFiles[i];
+    call projectAssetPath(asset); path := result;
+    if ~InTrash(path) then retained := Append(retained,asset); end if;
+    i := i + 1;
+  end while;
+  snapshot.assets.csvFiles := retained;
+FilterImageTrash:
+  i := 1; retained := <<>>;
+  while i <= Len(snapshot.assets.images) do
+    asset := snapshot.assets.images[i];
+    call projectAssetPath(asset); path := result;
+    if ~InTrash(path) then retained := Append(retained,asset); end if;
+    i := i + 1;
+  end while;
+  snapshot.assets.images := retained;
+FilterTrashDirectorySubtree:
+  i := 1; retained := <<>>;
+  while i <= Len(snapshot.fileSystem.directories) do
+    if ~InTrash(CanonicalNodePath(snapshot.fileSystem.directories[i])) then
+      retained := Append(retained,snapshot.fileSystem.directories[i]);
+    end if;
+    i := i + 1;
+  end while;
+  snapshot.fileSystem.directories := retained;
+RecheckExportReferencesAgainstRetainedAssets:
+  Require(UniqueChartSlotOwnership(snapshot));
+  i := 1;
+  while i <= Len(snapshot.charts) do
+    call validateChartModel(snapshot.charts[i],snapshot.assets.csvFiles);
+    i := i + 1;
+  end while;
+  i := 1;
+  while i <= Len(snapshot.slots) do
+    slot := snapshot.slots[i];
+    if slot.content.imageId # NoValue then
+      Require(ImageById(snapshot,slot.content.imageId) # NoValue);
+    end if;
+    i := i + 1;
+  end while;
+  \* Do not validate fixed roots on this trimmed export snapshot: trash is omitted.
+  \* Missing ordinary CSV/image now fails; conversion objects use the shared validator.
+ResponsibleDocumentsAndCopiedBytes:
+  call BuildFfpxDocumentEntries(snapshot); entries := result;
+  result := PackageEntriesWithVersion(entries,PACKAGE_FORMAT_VERSION);
+  \* STORE ZIP only; no reopen-required filesystem path; original Project untouched.
+  return;
+end procedure;
+
+procedure ReadPackageXml(entries,path,root)
+variables tree = NoValue;
+begin
+RequiredVersionedDocument:
+  Require(EntryExists(entries,path));
+  tree := ParseXmlTree(DecodeUtf8(EntryBytes(entries,path)));
+  Require(XmlRootName(tree) = root /\ XmlVersion(tree) = PACKAGE_FORMAT_VERSION);
+  result := tree;
+  return;
+end procedure;
+
+procedure DecodeNamedXml(parent,name)
+variables node = NoValue;
+begin
+OneNamedTypedValue:
+  node := RequiredSingleDirectChild(parent,name);
+  call ffpxDecodeValue(RequiredSingleValueChild(node));
+  return;
+end procedure;
+
+procedure RestorePlacementVisibility(slots)
+variables copy = DeepCopy(slots), i = 1, j = 1, anchor = NoValue,
+          row = 0, col = 0, matches = <<>>;
+begin
+FreshTaskLocalVisibility:
+  while i <= Len(copy) do copy[i].hidden := FALSE; i := i + 1; end while;
+MergedFootprints:
+  i := 1;
+  while i <= Len(copy) do
+    anchor := copy[i];
+    Require(IsPositiveInteger(anchor.rowSpan) /\ IsPositiveInteger(anchor.colSpan));
+    if anchor.rowSpan # 1 \/ anchor.colSpan # 1 then
+      row := anchor.row;
+      while row < anchor.row + anchor.rowSpan do
+        col := anchor.col;
+        while col < anchor.col + anchor.colSpan do
+          if row # anchor.row \/ col # anchor.col then
+            matches := SlotIndicesAtCell(copy,row,col);
+            Require(Len(matches) = 1);
+            j := matches[1];
+            Require(copy[j].content.chart = NoValue /\ copy[j].content.imageId = NoValue);
+            copy[j].hidden := TRUE;
+          end if;
+          col := col + 1;
+        end while;
+        row := row + 1;
+      end while;
+    end if;
+    i := i + 1;
+  end while;
+VisibilityReturn:
+  \* Do not discard caption/settings/payload to hide malformed topology.
+  result := copy;
+  return;
+end procedure;
+
+procedure ReadFfpxDocumentPayload(entries)
+variables project = NoValue, assetsRoot = NoValue, layout = NoValue,
+          caption = NoValue, labels = NoValue, payload = NoValue,
+          csvMetadata = <<>>, imageMetadata = <<>>, nodes = <<>>, i = 1, j = 1,
+          placement = NoValue, slotRoot = NoValue, slotNode = NoValue,
+          slotSettings = NoValue, slotCaption = NoValue, graphNode = NoValue,
+          imageNode = NoValue, image = NoValue, chart = NoValue, slot = NoValue,
+          objects = <<>>, charts = <<>>, slots = <<>>, appearance = [],
+          sourceNames = <<"enabled","beforeText","afterText","name","nameBold","settings">>,
+          targetNames = <<"enabled","text","afterText","name","nameBold","settings">>,
+          captionState = [], fixed = <<>>, paths = {}, path = "";
+begin
+MandatoryDocumentsThroughOneTypedGrammar:
+  call ReadPackageXml(entries,"project.xml","fastFigureProject");
+  call DecodeNamedXml(result,"settings"); project := result;
+  Require(project.schema = "fast-figure-project" /\ project.version = PACKAGE_FORMAT_VERSION);
+  call ReadPackageXml(entries,"assets/assets.xml","fastFigureAssets"); assetsRoot := result;
+  call ReadPackageXml(entries,"layout/layout.xml","fastFigureLayout");
+  call DecodeNamedXml(result,"layout"); layout := result;
+  call ReadPackageXml(entries,"caption/caption.xml","fastFigureCaption");
+  call DecodeNamedXml(result,"caption"); caption := result;
+  call ReadPackageXml(entries,"labels/labels.xml","fastFigureLabels");
+  call DecodeNamedXml(result,"labels"); labels := result;
+ReadBothAssetMetadataCollections:
+  nodes := DirectChildren(RequiredSingleDirectChild(assetsRoot,"dataAssets"),"dataAsset"); i := 1;
+  while i <= Len(nodes) do
+    call ffpxDecodeValue(RequiredSingleValueChild(nodes[i])); csvMetadata := Append(csvMetadata,result);
+    i := i + 1;
+  end while;
+  nodes := DirectChildren(RequiredSingleDirectChild(assetsRoot,"imageAssets"),"imageAsset"); i := 1;
+  while i <= Len(nodes) do
+    call ffpxDecodeValue(RequiredSingleValueChild(nodes[i])); imageMetadata := Append(imageMetadata,result);
+    i := i + 1;
+  end while;
+ReadPlacementDocumentsInTheirStoredOrder:
+  i := 1;
+  while i <= Len(layout.placements) do
+    placement := layout.placements[i];
+    call ReadPackageXml(entries,"slots/slot-" \o IntegerText(placement.slotId) \o ".xml","fastFigureSlot"); slotRoot := result;
+    slotNode := RequiredSingleDirectChild(slotRoot,"slot");
+    call DecodeNamedXml(slotNode,"settings"); slotSettings := result;
+    call DecodeNamedXml(slotNode,"caption"); slotCaption := result;
+    chart := NoValue; image := NoValue;
+    graphNode := OptionalSingleDirectChild(slotNode,"graph");
+    if graphNode # NoValue then
+      call DecodeNamedXml(graphNode,"settings"); chart := result;
+      nodes := DirectChildren(RequiredSingleDirectChild(graphNode,"graphObjects"),"graphObject");
+      objects := <<>>; j := 1;
+      while j <= Len(nodes) do
+        call ffpxDecodeValue(RequiredSingleValueChild(nodes[j])); objects := Append(objects,result);
+        j := j + 1;
+      end while;
+      chart.editor.objects := objects;
+      charts := Append(charts,chart);
+      \* Do not deduplicate/clone/drop chart ids to repair a shared/orphan import.
+    end if;
+    imageNode := OptionalSingleDirectChild(slotNode,"imageObject");
+    if imageNode # NoValue then call ffpxDecodeValue(RequiredSingleValueChild(imageNode)); image := result; end if;
+    slot := [id |-> placement.slotId,row |-> placement.row,col |-> placement.col,
+       rowSpan |-> placement.rowSpan,colSpan |-> placement.colSpan,hidden |-> FALSE,
+       caption |-> slotCaption.text,
+       content |-> [contentType |-> slotSettings.contentType,
+           chart |-> IF chart = NoValue THEN NoValue ELSE chart.id,
+           imageId |-> IF image = NoValue THEN NoValue ELSE image.imageRef]];
+    if image # NoValue then
+      if HasField(image,"settings") then slot.content.imageSettings := DeepCopy(image.settings); end if;
+    end if;
+    \* Missing imageSettings remain missing here; Backend slot normalization owns defaults.
+    slots := Append(slots,slot);
+    i := i + 1;
+  end while;
+VisibilityFromMergedGeometry:
+  call RestorePlacementVisibility(slots); slots := result;
+WireFieldsToTheSourceProjectImportShape:
+  if HasField(project,"appearance") then appearance := project.appearance; end if;
+  i := 1;
+  while i <= Len(sourceNames) do
+    if HasField(caption,sourceNames[i]) then captionState[targetNames[i]] := DeepCopy(caption[sourceNames[i]]); end if;
+    i := i + 1;
+  end while;
+  payload := [schema |-> project.schema,version |-> project.version,
+      kind |-> "fast-figure-project-object",
+      meta |-> [projectName |-> project.projectName,appBuild |-> project.appBuild],
+      layout |-> [gridRows |-> layout.gridRows,gridCols |-> layout.gridCols],
+      annotations |-> [labels |-> DeepCopy(labels),captions |-> captionState],
+      fileSystem |-> DeepCopy(project.fileSystem),
+      assets |-> [csvFiles |-> csvMetadata,images |-> imageMetadata],
+      charts |-> charts,slots |-> slots,appearance |-> []];
+  if HasField(appearance,"slotStyle") then payload.layout.slotStyle := DeepCopy(appearance.slotStyle); end if;
+  if HasField(appearance,"uiPalette") then payload.appearance.uiPalette := DeepCopy(appearance.uiPalette); end if;
+  if HasField(project,"export") then payload.export := DeepCopy(project.export); end if;
+RestoreFixedDirectoryInstancesNotExportedTrashContents:
+  fixed := <<BackendSettings.defaults.vfs.root,BackendSettings.defaults.vfs.csv,
+             BackendSettings.defaults.vfs.image,BackendSettings.defaults.vfs.trash>>;
+  paths := CanonicalDirectoryPathSet(payload.fileSystem.directories); i := 1;
+  while i <= Len(fixed) do
+    path := fixed[i];
+    if path \notin paths then
+      payload.fileSystem.directories := Append(payload.fileSystem.directories,NewDirectoryInstance(path));
+      paths := paths \cup {path};
+    end if;
+    i := i + 1;
+  end while;
+DecodedPayloadReturn:
+  \* schema/version are transport validation fields, stripped by buildProjectObject.
+  \* kind binds the existing Source schema identifier, not a new state.
+  \* nextId is computed from restored collections by the constructor, not from a package hint.
+  result := payload;
+  return;
+end procedure;
+
+procedure ffpxReadProject(file)
+variables entries = <<>>, payload = NoValue, i = 1, k = 1,
+          kinds = <<"csv","image">>, collection = <<>>, normalized = <<>>,
+          asset = NoValue, bytes = NoValue, referenceWidth = NoValue;
+begin
+StoreCrcPathAndVersion:
+  call ReadStorePackage(file,"project"); entries := result;
+RequiredTypedDocumentsAndPlacementReferences:
+  call ReadFfpxDocumentPayload(entries); payload := result;
+RestoreOwnedBytes:
+  while k <= Len(kinds) do
+    collection := IF kinds[k] = "csv" THEN payload.assets.csvFiles ELSE payload.assets.images;
+    normalized := <<>>; i := 1;
+    while i <= Len(collection) do
+      asset := DeepCopy(collection[i]);
+      Require(DataRefInAllowedSubtree(asset,IF kinds[k] = "csv" THEN "assets/data" ELSE "assets/media"));
+      Require(EntryExists(entries,asset.dataRef));
+      bytes := CopyBytes(EntryBytes(entries,asset.dataRef));
+      asset.bytesBase64 := Base64Encode(bytes);
+      if kinds[k] = "csv" then call parseProjectDataAsset(asset.name,bytes); asset.rows := result; end if;
+      RemoveField(asset,"dataRef");
+      normalized := Append(normalized,asset);
+      i := i + 1;
+    end while;
+    if kinds[k] = "csv" then payload.assets.csvFiles := normalized;
+    else payload.assets.images := normalized; end if;
+    k := k + 1;
+  end while;
+AdditiveMissingExportOnly:
+  if ~HasField(payload,"export") then
+    payload.export := DeepCopy(BackendSettings.project_object.export);
+    referenceWidth := FieldAtPathOrNoValue(payload,<<"layout","slotStyle","referenceWidth">>);
+    if referenceWidth = NoValue then referenceWidth := BackendSettings.project_object.layout.slotStyle.referenceWidth; end if;
+    payload.export.width := referenceWidth;
+    payload.export.height := IF payload.export.heightMode = "auto" THEN NoValue
+                             ELSE BackendSettings.defaults.limits.export.logicalHeight[1];
+  end if;
+  \* Do NOT clone/drop shared/orphan charts to repair topology. buildProjectObject validates it.
+  result := payload;
+  return;
+end procedure;
+
+procedure ffsxBuildSlot(slot, chart)
+variables source = activeProject;
+begin
+OneOfficialSlotReadContext:
+  call BuildFfsxInRead(source,slot,chart);
+  return;
+end procedure;
+
+procedure BuildFfsxInRead(source,slot,chart)
+variables copy = DeepCopy(chart), ids = <<>>, mapping = [],
+          entries = <<>>, i = 1, csv = NoValue, metadata = NoValue, dataRef = "",
+          typedAssets = <<>>, assetDocument = NoValue;
+begin
+SharedRepresentationValidation:
+  call validateChartModel(copy,source.assets.csvFiles);
+  call ReferencedProjectCsvIds(copy); ids := result;
+PackageLocalRemap:
+  while i <= Len(ids) do
+    csv := ResolveCsv(source,ids[i]); Require(csv # NoValue);
+    mapping[ids[i]] := i;
+    metadata := DeepCopy(csv); metadata.id := i;
+    RemoveField(metadata,"rows"); RemoveField(metadata,"bytesBase64"); RemoveField(metadata,"directory");
+    \* Current-format dataRef spelling is a package codec binding, not a local path.
+    dataRef := "assets/" \o CurrentVersionCsvDataRef(metadata);
+    Require(SafePackagePathInSubtree(dataRef,"assets/data"));
+    metadata.dataRef := dataRef;
+    call ffpxEncodeValue(metadata);
+    typedAssets := Append(typedAssets,XmlElement("dataAsset",[id |-> i,src |-> dataRef],<<result>>));
+    entries := Append(entries,[path |-> dataRef,bytes |-> CopyBytes(Base64Decode(csv.bytesBase64))]);
+    i := i + 1;
+  end while;
+  call RemapRealProjectCsvIds(copy,mapping); copy := result;
+RequiredAssetDocumentEvenForZeroObjects:
+  assetDocument := VersionedXmlDocument("fastFigureAssets",PACKAGE_FORMAT_VERSION,
+                   <<XmlElement("dataAssets",[],typedAssets)>>);
+  entries := Append(entries,[path |-> "assets/assets.xml",bytes |-> EncodeUtf8Xml(assetDocument)]);
+  call AddFfsxSlotDocument(entries,source,slot,copy); entries := result;
+  \* Conversion imported/view kept intact; zero-object chart needs no CSV entry.
+  result := PackageEntriesWithVersion(entries,PACKAGE_FORMAT_VERSION);
+  return;
+end procedure;
+
+procedure AddFfsxSlotDocument(entries,source,slot,chart)
+variables graph = DeepCopy(chart), settingsNode = NoValue, captionNode = NoValue,
+          graphNode = NoValue, children = <<>>;
+begin
+PackageGraphNotRegisteredProjectIdentity:
+  RemoveField(graph,"id");
+  call EncodeGraphXml(graph); graphNode := result;
+  call EncodeNamedXml("settings",[contentType |-> "graph",appBuild |-> source.meta.appBuild]); settingsNode := result;
+  call EncodeNamedXml("caption",[text |-> slot.caption]); captionNode := result;
+SlotAndFixedAssetDocumentReference:
+  children := <<XmlElement("assets",[ref |-> "assets/assets.xml"],<<>>),
+                XmlElement("slot",[],<<settingsNode,captionNode,graphNode>>)>>;
+  call AddPackageXml(entries,"slot.xml","fastFigureSlot",children);
+  return;
+end procedure;
+
+procedure ReadFfsxDocumentPayload(entries)
+variables root = NoValue, slotNode = NoValue, settings = NoValue, caption = NoValue,
+          graphNode = NoValue, chart = NoValue, nodes = <<>>, objects = <<>>,
+          csvFiles = <<>>, i = 1;
+begin
+FixedVersionSlotAndGraphDocuments:
+  call ReadPackageXml(entries,"slot.xml","fastFigureSlot"); root := result;
+  slotNode := RequiredSingleDirectChild(root,"slot");
+  call DecodeNamedXml(slotNode,"settings"); settings := result;
