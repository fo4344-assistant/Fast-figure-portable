+
+procedure validateProjectObjectState(state,requireSlots)
+variables i = 1, item = NoValue, ids = {}, paths = {}, chartIds = {}, slotIds = {}, owners = [],
+          expectedDirectories = {}, fields = <<>>, j = 1, labels = NoValue, exports = NoValue;
+begin
+TopLevelAndConfiguredGrid:
+  Require(ProjectSchemaRequiredNestedObjectsExist(state));
+  Require(IntegerInRange(state.layout.gridRows,BackendSettings.defaults.limits.layout.gridRows));
+  Require(IntegerInRange(state.layout.gridCols,BackendSettings.defaults.limits.layout.gridCols));
+  fields := <<"referenceWidth","gap","outerMargin","radius","aspect">>;
+  while j <= Len(fields) do
+    Require(FiniteInRange(state.layout.slotStyle[fields[j]],BackendSettings.defaults.limits.layout[fields[j]])); j := j + 1;
+  end while;
+  Require(IsBoolean(state.layout.slotStyle.showBorders));
+LabelAndExportRelationships:
+  labels := state.annotations.labels.settings;
+  Require(IsFinite(labels.x) /\ IsFinite(labels.y) /\ labels.fontSize >= BackendSettings.defaults.limits.labels.fontSizeMin);
+  exports := state.export;
+  Require(FiniteInRange(exports.width,BackendSettings.defaults.limits.export.logicalWidth));
+  Require(FiniteInRange(exports.dpi,BackendSettings.defaults.limits.export.dpi));
+  Require(exports.format \in {"png","jpeg"} /\ exports.heightMode \in {"auto","explicit"});
+  if exports.heightMode = "auto" then Require(exports.height = NoValue);
+  else Require(FiniteInRange(exports.height,BackendSettings.defaults.limits.export.logicalHeight)); end if;
+PaletteAndVfs:
+  fields := PropertyNames(BackendSettings.project_object.appearance.uiPalette); j := 1;
+  while j <= Len(fields) do Require(IsSixDigitHexColor(state.appearance.uiPalette[fields[j]])); j := j + 1; end while;
+  Require(CanonicalUniqueDirectoryPaths(state.fileSystem.directories));
+  Require(AllConfiguredFixedDirectoriesExist(state,BackendSettings.defaults.vfs));
+AssetIdsPathsAndDirectories:
+  while i <= Len(state.assets.csvFiles) do
+    item := state.assets.csvFiles[i];
+    Require(IsPositiveInteger(item.id) /\ item.id \notin ids); ids := ids \cup {item.id};
+    call projectAssetPath(item); Require(result \notin paths); paths := paths \cup {result};
+    Require(AssetDirectoryExists(state,item.directory));
+    i := i + 1;
+  end while;
+  ids := {}; i := 1;
+  while i <= Len(state.assets.images) do
+    item := state.assets.images[i];
+    Require(IsPositiveInteger(item.id) /\ item.id \notin ids); ids := ids \cup {item.id};
+    call projectAssetPath(item); Require(result \notin paths); paths := paths \cup {result};
+    Require(AssetDirectoryExists(state,item.directory));
+    i := i + 1;
+  end while;
+SingleSharedChartValidator:
+  i := 1;
+  while i <= Len(state.charts) do
+    item := state.charts[i]; Require(item.id \notin chartIds); chartIds := chartIds \cup {item.id};
+    call validateChartModel(item,state.assets.csvFiles);
+    owners[item.id] := 0;
+    i := i + 1;
+  end while;
+SlotsGeometryReferencesAndLocalDisplay:
+  i := 1;
+  while i <= Len(state.slots) do
+    item := state.slots[i]; Require(IsInteger(item.id) /\ item.id \notin slotIds); slotIds := slotIds \cup {item.id};
+    Require(ValidSlotGeometryInsideGrid(item,state.layout));
+    Require(~(item.content.chart # NoValue /\ item.content.imageId # NoValue));
+    if item.content.chart # NoValue then
+      Require(item.content.chart \in chartIds); owners[item.content.chart] := owners[item.content.chart] + 1;
+    end if;
+    if item.content.imageId # NoValue then Require(ImageById(state,item.content.imageId) # NoValue); end if;
+    Require(item.content.imageSettings.fit \in {"contain","cover","manual"});
+    Require(FiniteInRange(item.content.imageSettings.scale,BackendSettings.defaults.limits.imageSettings.scale));
+    Require(FiniteInRange(item.content.imageSettings.x,BackendSettings.defaults.limits.imageSettings.x));
+    Require(FiniteInRange(item.content.imageSettings.y,BackendSettings.defaults.limits.imageSettings.y));
+    Require(IsText(item.caption) \/ item.caption = NoValue);
+    i := i + 1;
+  end while;
+NoOrphanOrSharedChartAndMonotonicIds:
+  Require(EveryChartOwnerCountEqualsOne(owners));
+  Require(state.nextId.csv > MaximumIdOrZero(state.assets.csvFiles));
+  Require(state.nextId.image > MaximumIdOrZero(state.assets.images));
+  Require(state.nextId.chart > MaximumIdOrZero(state.charts));
+  if requireSlots then Require(Len(state.slots) > 0); end if;
+  result := state;
+  \* No repair, default insertion, fake CSV, placeholder, chart clone/drop or authority write.
+  return;
+end procedure;
+
+procedure createProjectState()
+variables candidate = NoValue, row = 0, col = 0, slot = NoValue;
+begin
+ConfigurationNotProjectData:
+  Require(BackendSettingsHasRequiredBackendOnlyShapeAndNoProjectData(BackendSettings));
+  candidate := [kind |-> "fast-figure-project-object",
+    meta |-> [projectName |-> "",appBuild |-> CurrentApplicationBuildMarker()],
+    layout |-> [],annotations |-> [labels |-> [],captions |-> []],
+    assets |-> [csvFiles |-> <<>>,images |-> <<>>],charts |-> <<>>,slots |-> <<>>,
+    fileSystem |-> [directories |-> <<>>],nextId |-> [],appearance |-> [uiPalette |-> []],export |-> []];
+  candidate.layout := DeepCopy(BackendSettings.project_object.layout);
+  candidate.annotations.labels := DeepCopy(BackendSettings.project_object.annotations.labels);
+  candidate.annotations.captions := DeepCopy(BackendSettings.project_object.annotations.captions);
+  candidate.annotations.captions.text := "";
+  candidate.annotations.captions.afterText := "";
+  candidate.annotations.captions.name := "";
+  candidate.assets := [csvFiles |-> <<>>,images |-> <<>>]; candidate.charts := <<>>; candidate.slots := <<>>;
+FixedDirectoryInstancesAndFirstIds:
+  candidate.fileSystem.directories := <<BackendSettings.defaults.vfs.root,BackendSettings.defaults.vfs.csv,
+                                      BackendSettings.defaults.vfs.image,BackendSettings.defaults.vfs.trash>>;
+  candidate.nextId := [csv |-> 1,image |-> 1,chart |-> 1];
+  candidate.appearance.uiPalette := DeepCopy(BackendSettings.project_object.appearance.uiPalette);
+  candidate.export := DeepCopy(BackendSettings.project_object.export);
+  candidate.export.width := candidate.layout.slotStyle.referenceWidth;
+  candidate.export.height := IF candidate.export.heightMode = "auto" THEN NoValue
+                             ELSE BackendSettings.defaults.limits.export.logicalHeight[1];
+EachCellEmptyNotProtectedCsv:
+  while row < candidate.layout.gridRows do
+    col := 0;
+    while col < candidate.layout.gridCols do
+      slot := [id |-> row * candidate.layout.gridCols + col,row |-> row,col |-> col];
+      slot.rowSpan := 1; slot.colSpan := 1; slot.hidden := FALSE;
+      slot.content := DeepCopy(BackendSettings.defaults.slotSettings.content);
+      slot.content.chart := NoValue; slot.content.imageId := NoValue; slot.caption := NoValue;
+      candidate.slots := Append(candidate.slots,slot);
+      col := col + 1;
+    end while;
+    row := row + 1;
+  end while;
+  call validateProjectObjectState(candidate,TRUE);
+  result := candidate;
+  \* Return candidate, never bind activeProject here.
+  return;
+end procedure;
+
+procedure ProjectObject_read(path)
