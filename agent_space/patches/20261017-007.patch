+procedure ProjectObject_initialize(source)
+variables candidate = DeepCopy(source), previous = NoValue, i = 1;
+begin
+NormalizeOutsideAuthority:
+  while i <= Len(candidate.slots) do
+    call normalizeSlotContent(candidate.slots[i]); candidate.slots[i] := result; i := i + 1;
+  end while;
+  call validateProjectObjectState(candidate,TRUE);
+OneValidatedBindingReplacement:
+  previous := activeProject;
+  activeProject := candidate;
+  result := previous;
+  \* Existing binding owned here and EFSM only; not a second global authority.
+  return;
+end procedure;
