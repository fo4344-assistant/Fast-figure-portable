+\* Helpers below NEVER reenter the public lifecycle binding.
+CONSTANT NoValue, EMPTY_CSV_TEMPLATE, PROJECT_ASSET_DIRECTORIES
+(* --algorithm PublicAssets
+variables result = NoValue;
+
+procedure readAssetFileKind(file)
+begin
+NameAndTypeOnly:
+  call dispatchProjectQuery("project-api",[operation |-> "assets.fileKind",file |-> CopyNameType(file)]);
+  return;
+end procedure;
