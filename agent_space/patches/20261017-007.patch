+procedure FormActualMutationResult(event,pre,post,calculation)
+variables hints = calculation.selectionHints, facts = calculation.domainFacts,
+          maps = <<>>, i = 1, changed = [], graphCount = 0, imageCount = 0, projectionEffect = NoValue;
+begin
+FactsOfThisSuccessfulAttemptOnly:
+  call BuildActualChanged(event,pre,post,facts); changed := result;
+  \* Helper resolves recorded command calculations against post ids/paths, never
+  \* reads UI/old projection. Replacements preserve input order, not asset id order.
+  if HasField(facts,"removedGraphReferenceCount") then graphCount := facts.removedGraphReferenceCount; end if;
+  if HasField(facts,"resetImageSlotCount") then imageCount := facts.resetImageSlotCount; end if;
+  if HasField(facts,"graphObjectIndexMaps") then
+    while i <= Len(facts.graphObjectIndexMaps) do
+      if UniqueChartOwnerExists(post,facts.graphObjectIndexMaps[i].chartId) then
+        maps := Append(maps,facts.graphObjectIndexMaps[i]);
+      end if;
+      i := i + 1;
+    end while;
+    if Len(maps) > 0 then hints.graphObjectIndexMaps := maps; end if;
+  end if;
+ResetAndExplicitGraphHintSemantics:
+  if event = "PROJECT_LOADED" then hints.resetInterfaceSelection := TRUE; end if;
+  \* calculateGraphObjectEdit supplies chartId+explicit none for direct delete;
+  \* palette omits key. Never synthesize selected object's CSV asset selection.
+ProjectionFromActualMutation:
+  call CalculateProjectionEffect(event,pre,post); projectionEffect := result;
+  result := ImmutableCopy([event |-> event,committed |-> TRUE,changed |-> changed,
+    removedGraphReferenceCount |-> graphCount,resetImageSlotCount |-> imageCount,
+    selectionHints |-> hints,
+    projectionEffect |-> projectionEffect]);
+  return;
+end procedure;
