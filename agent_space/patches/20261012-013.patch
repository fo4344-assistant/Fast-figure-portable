+procedure PublishState()
+begin
+PublishRevision:
+  revision := revision + 1;
+PublishReturn:
+  return;
+end procedure;
+
+procedure Transition(region, target, event, payload)
+begin
+TransitionMode:
+  if CurrentRegionState(region) = target /\ ~RequestsReentry(payload) then
+    effect := RunRegionUpdateHook(region, event, payload);
+  else
+    effect := RunRegionExitHook(region, event, payload);
+    effect := SetRegionState(region, target);
+    effect := RunRegionEntryHook(region, event, payload);
+  end if;
+TransitionDirection:
+  direction := PayloadDirectionOrDefault(payload);
+TransitionPublish:
+  call PublishState();
+TransitionReturn:
+  return;
+end procedure;
+
+procedure ProcessRegion(region, event, payload)
+variables handler = NoSelection;
+begin
+ResolveRegionHandler:
+  handler := ResolveRegionHandler(region, event);
+RunRegionHandler:
+  if handler # NoSelection then
+    effect := ApplyDeclaredHandlerAction(handler, payload);
+  end if;
+RegionTransition:
+  if handler # NoSelection /\ HandlerHasTarget(handler) then
+    call Transition(region, HandlerTarget(handler, payload), event, payload);
+  end if;
+ProcessRegionReturn:
+  return;
+end procedure;
+
+procedure Send(event, payload)
+variables handledBefore = HandlerCount();
+begin
+LifecycleRegion:
+  call ProcessRegion("lifecycle", event, payload);
+WorkspaceRegion:
+  call ProcessRegion("workspace", event, payload);
+OverlayRegion:
+  call ProcessRegion("overlay", event, payload);
+AssetRegion:
+  call ProcessRegion("assetSelection", event, payload);
+GraphObjectRegion:
+  call ProcessRegion("graphObject", event, payload);
+UnhandledEvent:
+  if HandlerCount() = handledBefore then
+    effect := RecordDebugWarning(event);
+  end if;
+SendReturn:
+  return;
+end procedure;
+
+procedure Notify(objectName, event, payload)
+begin
+NotifyGuard:
+  if lifecycle # "booting" /\ ~IsTransitionInProgress() then
+    direction := "model-to-ui";
+    if CurrentWorkspaceOrOverlaySubscribes(objectName) then
+      effect := RunProjectionUpdate(objectName, event, payload);
+    end if;
+    revision := revision + 1;
+  end if;
+NotifyReturn:
+  return;
+end procedure;
+
+procedure RunLifecycle(requestedLifecycle, event, task)
+begin
+LifecycleReadyGuard:
+  if lifecycle = "ready" then
+    lifecycle := requestedLifecycle;
+  end if;
+LifecycleTask:
+  if lifecycle = requestedLifecycle then
+    either
+      result := ExecuteTaskResult(task);
+    or
+      error := ExecuteTaskFailure(task) ||
+      lifecycle := "error";
+    end either;
+  end if;
+LifecycleRestore:
+  if lifecycle = requestedLifecycle \/ lifecycle = "error" then
+    lifecycle := "ready";
+  end if;
+LifecycleReturn:
+  return;
+end procedure;
+
+procedure SelectCsv(request)
+variables csvPath = NoSelection;
+begin
+ResolveCsv:
+  csvPath := ResolveCsvPath(request);
+CommitCsvIfResolved:
+  if csvPath # NoSelection then
+    graphObject := "none" ||
+    graphObjectIndex := NoSelection ||
+    assetSelection := "csv" ||
+    assetPath := csvPath;
+  end if;
+SelectCsvReturn:
+  return;
+end procedure;
+
+procedure SelectObject(request)
+variables index = NoSelection, csvPath = NoSelection;
+begin
+ResolveObjectIndex:
+  index := ResolveObjectIndex(request);
+ResolveObjectCsv:
+  if index # NoSelection then
+    csvPath := ResolveObjectCsvPath(index);
+  end if;
+CommitObjectIfResolved:
+  if index # NoSelection /\ csvPath # NoSelection then
+    graphObject := "selected" ||
+    graphObjectIndex := index ||
+    assetSelection := "csv" ||
+    assetPath := csvPath;
+  end if;
+SelectObjectReturn:
+  return;
+end procedure;
+
+procedure SelectImage(request)
+variables imagePath = NoSelection;
+begin
+ResolveImage:
+  imagePath := ResolveImagePath(request);
+CommitImageIfResolved:
+  if imagePath # NoSelection then
+    graphObject := "none" ||
+    graphObjectIndex := NoSelection ||
+    assetSelection := "image" ||
+    assetPath := imagePath;
+  end if;
+SelectImageReturn:
+  return;
+end procedure;
+
+procedure ApplySlotSelection(payload)
+variables slot = NoSelection;
+begin
+ResolveSlotSelection:
+  slot := ResolveSlotFromCurrentProject(payload.slotId);
+CommitSlotSelection:
+  if payload.slotId = NoSelection then
+    selectedSlotId := NoSelection ||
+    graphObject := "none" ||
+    graphObjectIndex := NoSelection ||
+    workspace := "project";
+  elsif slot # NoSelection then
+    if PayloadUsesUiToggle(payload) /\ selectedSlotId = slot.id then
+      selectedSlotId := NoSelection ||
+      graphObject := "none" ||
+      graphObjectIndex := NoSelection ||
+      workspace := "project";
+    else
+      selectedSlotId := slot.id ||
+      workspace := IF slot.contentType = "image" THEN "slot.image" ELSE "slot.graph";
+      if ~GraphObjectSelectionValidForSlot(slot, graphObjectIndex) then
+        graphObject := "none" ||
+        graphObjectIndex := NoSelection;
+      end if;
+    end if;
+  end if;
+SlotSelectionReturn:
+  return;
+end procedure;
+
+procedure ApplyProjectLoaded(project)
+variables candidate = project;
+begin
+ProjectLoadValidate:
+  if HasWriteScope("project") /\ ValidateWholeProject(candidate) then
+    projectAuthority := candidate;
+    selectedSlotId := ReResolveOrClearSelectedSlot(candidate, selectedSlotId);
+    assetPath := ReResolveOrClearAssetPath(candidate, assetPath);
+    assetSelection := ReResolveOrClearAssetKind(candidate, assetPath);
+    graphObjectIndex := ReResolveOrClearGraphObject(candidate, selectedSlotId, graphObjectIndex);
+    graphObject := IF graphObjectIndex = NoSelection THEN "none" ELSE "selected";
+    effect := ReleaseOldProjectResourcesAfterCommit();
+    effect := ReprojectRendererFrom(candidate);
   end if;
 ProjectLoadReturn:
   return;
