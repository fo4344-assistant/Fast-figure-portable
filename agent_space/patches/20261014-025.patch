+  assert assetSelection = selectionBefore /\ selectedCsvId = csvBefore;
+EmptyCsvNoGraphObjectSideEffect:
+  assert pendingCsvSelection = NoCsv
+         \/ Len(project.graphObjectCsvRefs) = previousGraphObjectCount;
+EmptyCsvProjectReturn:
+  return;
+end procedure;
+
+procedure ReconcileEmptyCsvSelection()
+variables projectBefore = project;
+begin
+EmptyCsvReconcile:
+  if pendingCsvSelection # NoCsv then
+    assetSelection := "csv" ||
+    selectedCsvId := pendingCsvSelection ||
+    lastResult := "empty-csv-created";
+  end if;
+EmptyCsvInterfaceDoesNotMutateProject:
+  assert project = projectBefore;
+EmptyCsvClearResult:
+  pendingCsvSelection := NoCsv ||
+  reconcilePending := FALSE;
+EmptyCsvReconcileReturn:
+  return;
+end procedure;
+
+procedure ImportAssetBatch(allowCommit)
+variables projectBefore = project, candidate = project;
+begin
+BatchBuildCandidate:
+  candidate := [
+    project EXCEPT
+      !.csvIds = CsvIds,
+      !.nextCsvId = Cardinality(CsvIds) + 1
+  ];
+BatchCommitOrReject:
+  if allowCommit /\ ValidProject(candidate) then
+    project := candidate ||
+    lastResult := "batch-imported";
+  else
+    lastResult := "batch-import-rejected";
+  end if;
+BatchRejectUnchanged:
+  assert lastResult # "batch-import-rejected" \/ project = projectBefore;
+BatchCommitAll:
+  assert lastResult # "batch-imported" \/ project.csvIds = CsvIds;
+BatchReturn:
+  return;
+end procedure;
+
