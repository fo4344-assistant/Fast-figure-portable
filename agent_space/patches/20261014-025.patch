+        call ApplySlotSelection(slotId);
+      end if;
+    end if;
+  else
+    lastResult := "invalid-slot";
+  end if;
+SurfaceReturn:
+  return;
+end procedure;
+
+procedure BookmarkClick(slotId)
+begin
+BookmarkResolve:
+  if slotId \in SlotIds then
+    call ApplySlotSelection(slotId);
+  else
+    lastResult := "invalid-slot";
+  end if;
+BookmarkReturn:
+  return;
+end procedure;
+
+procedure DashboardBackgroundClick()
+begin
+BackgroundDeselect:
+  if selectedSlotId # NoSlot then
+    call ApplySlotSelection(NoSlot);
+  end if;
+BackgroundReturn:
+  return;
+end procedure;
+
+procedure CreateEmptyCsvProject()
+variables
+  newCsvId = NoCsv,
+  previousGraphObjectCount = 0,
+  selectionBefore = assetSelection,
+  csvBefore = selectedCsvId;
