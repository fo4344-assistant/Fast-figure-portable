+  debugEnabled = FALSE,
+  lifecycle = "booting",
+  result = NoSelection,
+  effect = NoSelection;
+
+procedure PublishTelemetry(patch)
+begin
+TelemetryPatch:
+  effect := ApplyTelemetryProjectionPatch(patch);
+TelemetryRevision:
+  telemetryRevision := telemetryRevision + 1;
+TelemetryReturn:
+  return;
+end procedure;
+
+procedure SetDebug(enabled)
+begin
+DebugAuthority:
+  debugEnabled := ToBoolean(enabled);
+DebugProjection:
+  call PublishTelemetry([debugEnabled |-> debugEnabled]);
+DebugReturn:
+  return;
+end procedure;
+
+procedure Status(message)
+begin
+StatusNormalize:
+  statusText := NormalizeStatusText(message);
+StatusProjection:
+  call PublishTelemetry([status |-> statusText]);
+StatusResult:
+  result := statusText;
+StatusReturn:
+  return;
+end procedure;
+
+procedure RenderDashboard()
+begin
+RenderGridAndStyle:
+  effect := ProjectLayoutToDashboardCss(ReadActiveProject());
+RenderPurge:
+  effect := PurgeDisconnectedPlotlyInstances();
+RenderSlots:
+  effect := RenderEveryVisibleSlotFromProject(ReadActiveProject());
+RenderGraphs:
+  effect := RenderGraphSlotsFromReferencedCharts(ReadActiveProject());
+RenderImages:
+  effect := RenderImageSlotsFromReferencedAssetsAndSlotSettings(ReadActiveProject());
