+  effect := ApplySelectedSlotClass(selectedSlotId);
+RenderAnnotations:
+  effect := RenderLabelsAndCaptions(ReadActiveProject());
+RenderResult:
+  result := "rendered";
+RenderReturn:
+  return;
+end procedure;
+
+procedure SetSelectedSlot(slotId, selectionDirection)
+begin
+EmitSelectSlot:
+  issuedCommand := [
+    name |-> "SELECT_SLOT",
+    slotId |-> slotId,
+    direction |-> selectionDirection
+  ];
+ResolveSelectionAfterEvent:
+  selectedSlotId := ReadSelectedSlotIdFromFsm();
+UpdateSelectedWorkspace:
+  call UpdateGraphView();
+ResizeAfterSelection:
+  effect := RequestGraphViewResize();
+SetSelectedReturn:
+  return;
+end procedure;
+
+procedure ContentBodyClick(slotId)
+begin
+ContentPassThrough:
+  skip;
+ContentReturn:
+  return;
+end procedure;
+
+procedure EmptySlotClick(slotId)
+begin
+EmptySelect:
+  if IsVisibleEmptySlot(slotId) then
+    call SetSelectedSlot(slotId, "ui-to-fsm");
+  end if;
+EmptyReturn:
+  return;
+end procedure;
+
+procedure BookmarkClick(slotId)
+begin
+BookmarkGuard:
+  if IsVisibleContentSlot(slotId) then
+    if suppressBookmarkClick then
+      if slotDragSourceId = NoSelection then
+        suppressBookmarkClick := FALSE;
+      end if;
+    else
+      call SetSelectedSlot(slotId, "ui-to-fsm");
+    end if;
+  end if;
+BookmarkReturn:
+  return;
+end procedure;
+
+procedure BookmarkDragStart(slotId)
+begin
+BookmarkDragGuard:
+  if IsVisibleContentSlot(slotId) then
+    slotDragSourceId := slotId ||
+    suppressBookmarkClick := TRUE;
+  end if;
+BookmarkDragStartReturn:
+  return;
+end procedure;
+
+procedure SwapSlotContents(sourceId, targetId)
+begin
+EmitSlotSwap:
+  if sourceId # targetId /\ IsVisibleSlot(sourceId) /\ IsVisibleSlot(targetId) then
+    issuedCommand := [
+      name |-> "SLOTS_SWAPPED",
+      sourceId |-> sourceId,
+      targetId |-> targetId
+    ];
+  end if;
+SwapSlotReturn:
+  return;
+end procedure;
+
+procedure BookmarkDrop(targetSlotId)
+begin
+BookmarkDropGuard:
+  if slotDragSourceId # NoSelection
+     /\ targetSlotId # slotDragSourceId
+     /\ IsVisibleSlot(targetSlotId) then
+    call SwapSlotContents(slotDragSourceId, targetSlotId);
+  end if;
+BookmarkDropClearSource:
+  slotDragSourceId := NoSelection;
+BookmarkDropReturn:
+  return;
+end procedure;
+
+procedure BookmarkDragEnd()
+begin
+BookmarkDragEndSource:
+  slotDragSourceId := NoSelection;
+BookmarkDragEndReturn:
+  return;
+end procedure;
+
+procedure ReleaseSyntheticClickGuard()
+begin
+BookmarkClickGuardRelease:
+  if suppressBookmarkClick
+     /\ slotDragSourceId = NoSelection
+     /\ PostDragClickOpportunityPassed() then
+    suppressBookmarkClick := FALSE;
+  end if;
+BookmarkGuardReturn:
+  return;
+end procedure;
+
+procedure PrepareDashboardFileDrop(slotId)
+begin
+FileDropResolve:
+  if IsVisibleSlot(slotId) then
+    if selectedSlotId # slotId then
+      call SetSelectedSlot(slotId, "ui-to-fsm");
+    end if;
+    result := TRUE;
+  else
+    result := FALSE;
+  end if;
+FileDropClearSlotDrag:
+  slotDragSourceId := NoSelection;
+FileDropPrepareReturn:
+  return;
+end procedure;
+
+procedure ApplySlotStyle(notify)
+begin
+StyleProjection:
+  effect := ApplyDashboardCssFromStyle(ReadActiveProjectSlotStyle());
+StyleNotify:
+  if notify then
+    issuedCommand := [name |-> "notify-layout"];
+  end if;
+StyleReturn:
+  return;
+end procedure;
+
+procedure ResolveSelectedChart()
+begin
+ResolveSelectedChartPath:
+  result := ResolveChartFromSelectedSlot(ReadActiveProject(), selectedSlotId);
+ResolveChartReturn:
+  return;
+end procedure;
+
+procedure UpdateGraphView()
+begin
+ResolveWorkspaceProjection:
+  result := ProjectWorkspaceFromCurrentSelection(selectedSlotId);
+RenderWorkspaceProjection:
+  effect := RenderWorkspaceFromAuthority(result);
+UpdateGraphReturn:
+  return;
+end procedure;
+
+procedure StartupCoreRuntime()
+begin
+StartupValidate:
+  assert ValidateWholeProject(ReadActiveProject());
+StartupZoom:
+  effect := ApplyDashboardZoomProjection();
+StartupController:
+  effect := InstallBookmarkAndDropController();
+StartupRender:
+  call RenderDashboard();
+StartupStyle:
+  call ApplySlotStyle(FALSE);
+StartupReady:
+  lifecycle := "ready";
+StartupAudit:
+  assert AuditProjectReferenceRuntimeInvariants();
+StartupResult:
+  result := "ready";
+StartupReturn:
+  return;
+end procedure;
+
+begin
+Main:
+  while TRUE do
+    either
+      call RenderDashboard();
+    or
+      with slotId = NextBookmarkClickSlot() do
+        call BookmarkClick(slotId);
+      end with;
+    or
+      with slotId = NextEmptySlotClickSlot() do
+        call EmptySlotClick(slotId);
+      end with;
+    or
+      with slotId = NextBookmarkDragStartSlot() do
+        call BookmarkDragStart(slotId);
+      end with;
+    or
