+CONSTANT NoValue
+
+(*
+--algorithm FastFigureApiUi
+variables
+  collisionDraft = NoValue,
+  resolver = NoValue,
+  preparedSlot = NoValue,
+  lastPersistentCommand = NoValue,
+  dragRuntimeActive = FALSE,
+  sidebarWidth = 0,
+  sidebarCollapsed = FALSE,
+  result = NoValue,
+  effect = NoValue;
+
+procedure SubscribeAppState(callback)
+begin
+SubscribeExternalStore:
+  result := RegisterAppFsmSubscriber(callback);
+SubscribeReturn:
+  return;
+end procedure;
+
+procedure ReadGraphData()
+variables
+  chart = NoValue,
+  objects = <<>>,
+  selectedIndex = NoValue,
+  currentCsv = NoValue,
+  objectCsv = NoValue,
+  currentColumns = <<>>,
+  objectColumns = <<>>;
+begin
+ReadGraphDataChart:
+  chart := ResolveSelectedChartForRead();
+ReadGraphDataObjects:
+  if chart # NoValue then
+    objects := chart.editor.objects;
+  end if;
+ReadGraphDataSelection:
+  selectedIndex := ReadGraphObjectSelectionIndex();
+ReadGraphDataCurrentCsv:
+  currentCsv := ResolveCsvFromCurrentAssetSelection();
+ReadGraphDataCurrentColumns:
+  if currentCsv # NoValue then
+    currentColumns := ColumnDefinitionsForCsv(currentCsv);
+  end if;
+ReadGraphDataObjectCsv:
+  if ValidGraphObjectIndex(objects, selectedIndex) then
+    objectCsv := ResolveProjectCsv(objects[selectedIndex].csvId);
+  end if;
+ReadGraphDataObjectColumns:
+  if objectCsv # NoValue then
+    objectColumns := ColumnDefinitionsForCsv(objectCsv);
+  end if;
+ReadGraphDataResult:
+  result := [
+    objects |-> objects,
+    selectedIndex |-> selectedIndex,
+    currentCsv |-> currentCsv,
+    columns |-> currentColumns,
+    objectColumns |-> objectColumns
+  ];
+ReadGraphDataReturn:
   return;
 end procedure;
 
