---- MODULE FastFigurePortableBuildPseudocode ----
EXTENDS Naturals, Sequences

\* Direct translation of Source Script r25 sourcescript/portable_build.py.
\* Portable build is a system-level packaging responsibility, not a Backend or Frontend child.

CONSTANTS ScriptSpecs, NoValue

(*
--algorithm FastFigurePortableBuild
variables
  htmlBytes = NoValue,
  outputBytes = NoValue,
  scriptIndex = 1,
  result = NoValue;

procedure Build(output)
variables spec = NoValue, sourceBytes = NoValue;
begin
BuildReadTemplate:
  htmlBytes := ReadBytes("Fast-figure.html") ||
  outputBytes := ReadBytes("Fast-figure.html") ||
  scriptIndex := 1;
BuildInlineLoop:
  while scriptIndex =< Len(ScriptSpecs) do
    spec := ScriptSpecs[scriptIndex];
    assert CountExactExternalTag(outputBytes, spec.externalTag) = 1;
    assert SourceFileExists(spec.source);
    sourceBytes := ReadBytes(spec.source);
    outputBytes := ReplaceTagWithInlineBytes(
      outputBytes,
      spec.externalTag,
      spec.inlineTag,
      sourceBytes);
    scriptIndex := scriptIndex + 1;
  end while;
BuildExternalTagCheck:
  assert NoDeclaredExternalScriptTagRemains(outputBytes);
BuildOutputParent:
  result := EnsureOutputParentExists(output);
BuildWrite:
  result := WriteBytes(output, outputBytes);
BuildResult:
  result := output;
BuildReturn:
  return;
end procedure;

begin
Main:
  call Build(DefaultOutputPath());
end algorithm;
*)
====
