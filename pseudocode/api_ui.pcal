---- MODULE FastFigureApiUiPseudocode ----
EXTENDS Naturals

\* r13 PlusCal pseudocode for sourcescript/api_ui.py.
\* Collision/form/sidebar values are UI-local and never project authority.

CONSTANT NoValue

(*
--algorithm FastFigureApiUi
variables
  collisionDraft = NoValue,
  resolver = NoValue,
  preparedSlot = NoValue,
  lastPersistentCommand = NoValue,
  dragRuntimeActive = FALSE,
  sidebarWidth = 0,
  sidebarCollapsed = FALSE,
  result = NoValue,
  effect = NoValue;

procedure SubscribeAppState(callback)
begin
SubscribeExternalStore:
  result := RegisterAppFsmSubscriber(callback);
SubscribeReturn:
  return;
end procedure;

procedure ChooseImportPlan(file, directory, reservedPaths)
variables model = NoValue, choice = NoValue;
begin
CollisionModel:
  model := CoreCollisionModel(file, directory, reservedPaths);
CollisionAvailable:
  if model.mode = "available" then
    result := CoreResolveImportPlan(model, "available", reservedPaths);
  else
    collisionDraft := model ||
    resolver := [file |-> file, directory |-> directory, reserved |-> reservedPaths];
    choice := AwaitCollisionModalOutcome();
    if choice = "rename" \/ choice = "replace" then
      result := CoreResolveImportPlan(model, choice, reservedPaths);
    else
      result := NoValue;
    end if;
    collisionDraft := NoValue ||
    resolver := NoValue;
  end if;
CollisionReturn:
  return;
end procedure;

procedure RunLifecycleTask(requestedLifecycle, eventName, task)
begin
DelegateLifecycle:
  result := AppFsmRun(requestedLifecycle, eventName, task);
LifecycleTelemetry:
  if TaskFailed(result) then
    effect := PublishDebugTelemetry(TaskError(result));
  end if;
LifecycleUiReturn:
  return;
end procedure;

procedure PrepareFileDrop(slotId)
begin
PrepareFileDropRuntime:
  result := SlotApiPrepareFileDrop(slotId);
PrepareFileDropState:
  if result then
    preparedSlot := slotId ||
    dragRuntimeActive := TRUE;
  else
    preparedSlot := NoValue;
  end if;
PrepareDropReturn:
  return;
end procedure;

procedure ImportExternalFile(file, slotId)
begin
PrepareExternalDrop:
  call PrepareFileDrop(slotId);
RunExternalImport:
  if result then
    call RunLifecycleTask(
      "importing",
      "SLOT_DROP_IMPORT",
      [command |-> "assets.importToSlot", file |-> file, slotId |-> slotId]);
  end if;
FinishExternalDrop:
  effect := SlotApiFinishFileDrop();
  dragRuntimeActive := FALSE ||
  preparedSlot := NoValue;
ExternalDropReturn:
  return;
end procedure;

procedure ConnectExistingAsset(path, kind, slotId)
begin
ExplicitAssetConnection:
  if AssetAndSlotConnectionInputsResolve(path, kind, slotId) then
    lastPersistentCommand := [
      name |-> "assets.connectToSlot",
      path |-> path,
      kind |-> kind,
      slotId |-> slotId
    ];
  end if;
ConnectAssetReturn:
  return;
end procedure;

procedure FastFigureApp()
begin
ReadAppearance:
  result := MantineProviderFromPersistentPalette(ReadAppearancePalette());
MountShell:
  result := MountFastFigureShell(result);
AppReturn:
  return;
end procedure;

procedure FastFigureShell(width, collapsed)
begin
UpdateSidebarLocalState:
  sidebarWidth := width ||
  sidebarCollapsed := collapsed;
ProjectSidebarGeometry:
  effect := ApplySidebarGeometryToRenderer(sidebarWidth, sidebarCollapsed);
ResizePlots:
  effect := RequestPlotResizeFromCurrentAuthority();
ShellReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with file = NextDroppedFile(), slotId = NextDropSlotId() do
        call ImportExternalFile(file, slotId);
      end with;
    or
      with path = NextAssetPath(), kind = NextAssetKind(), slotId = NextDropSlotId() do
        call ConnectExistingAsset(path, kind, slotId);
      end with;
    or
      call FastFigureApp();
    end either;
  end while;
end algorithm;
*)
====
