---- MODULE FastFigureApiUiPseudocode ----
EXTENDS Naturals

\* Direct translation of sourcescript/api_ui.py.
\* Collision/form/sidebar/drop-receiver values are UI-local and never project authority.

CONSTANT NoValue

(*
--algorithm FastFigureApiUi
variables
  collisionDraft = NoValue,
  resolver = NoValue,
  preparedSlot = NoValue,
  lastPersistentCommand = NoValue,
  dragRuntimeActive = FALSE,
  dashboardDropReceiver = "unmounted",
  dashboardDropReceiverCount = 0,
  activeDropEventId = NoValue,
  lastHandledDropEventId = NoValue,
  sidebarWidth = 0,
  sidebarCollapsed = FALSE,
  settingsOverlayHeight = NoValue,
  settingsOverlayResizeStartY = NoValue,
  settingsOverlayResizeStartHeight = NoValue,
  settingsOverlayResizeActive = FALSE,
  layoutSelection = {},
  result = NoValue,
  effect = NoValue;

procedure SetProjectName(name)
begin
ProjectNameDispatch:
  result := ApplicationDispatchProjectCommand(
    "PROJECT_NAME_CHANGED",
    [name |-> NormalizeProjectName(name)]);
ProjectNameReturn:
  return;
end procedure;

procedure SetSlotContentType(slotId, contentType)
begin
SlotTypeDispatch:
  result := ApplicationDispatchProjectCommand(
    "SLOT_TYPE_CHANGED",
    [slotId |-> slotId, type |-> NormalizeSlotContentType(contentType)]);
SlotTypeReturn:
  return;
end procedure;

procedure ResetSlots(slotIds)
begin
SlotsResetDispatch:
  result := ApplicationDispatchProjectCommand(
    "SLOTS_RESET",
    [slotIds |-> slotIds]);
SlotsResetReturn:
  return;
end procedure;

procedure InsertEmptyImage(slotId)
variables candidate = NoValue;
begin
EmptyImageBuild:
  candidate := BuildEmptyImageAndSlotCandidate(slotId);
EmptyImageDispatch:
  if candidate # NoValue then
    result := ApplicationDispatchProjectCommand(
      "SLOT_IMAGE_IMPORTED",
      [slotId |-> slotId, candidate |-> candidate]);
  end if;
EmptyImageReturn:
  return;
end procedure;

procedure SetAppearancePalette(values)
variables normalized = NoValue;
begin
AppearanceNormalize:
  normalized := NormalizeAppearancePalette(values);
AppearanceDispatch:
  result := ApplicationDispatchProjectCommand(
    "APPEARANCE_CHANGED",
    [palette |-> normalized]);
AppearanceReturn:
  return;
end procedure;

procedure ResetAppearancePalette()
begin
AppearanceResetDispatch:
  result := ApplicationDispatchProjectCommand(
    "APPEARANCE_CHANGED",
    [palette |-> DefaultAppearancePalette()]);
AppearanceResetReturn:
  return;
end procedure;

procedure SubscribeAppState(callback)
begin
SubscribeExternalStore:
  result := RegisterInterfaceFsmSubscriber(callback);
SubscribeReturn:
  return;
end procedure;

procedure ReadGraphData()
variables
  chart = NoValue,
  objects = <<>>,
  selectedIndex = NoValue,
  currentCsv = NoValue,
  objectCsv = NoValue,
  currentColumns = <<>>,
  objectColumns = <<>>;
begin
ReadGraphDataChart:
  chart := ResolveSelectedChartForRead();
ReadGraphDataObjects:
  if chart # NoValue then
    objects := chart.editor.objects;
  end if;
ReadGraphDataSelection:
  selectedIndex := ReadGraphObjectSelectionIndex();
ReadGraphDataCurrentCsv:
  currentCsv := ResolveCsvFromCurrentAssetSelection();
ReadGraphDataCurrentColumns:
  if currentCsv # NoValue then
    currentColumns := ColumnDefinitionsForCsv(currentCsv);
  end if;
ReadGraphDataObjectCsv:
  if ValidGraphObjectIndex(objects, selectedIndex) then
    objectCsv := ResolveProjectCsv(objects[selectedIndex].csvId);
  end if;
ReadGraphDataObjectColumns:
  if objectCsv # NoValue then
    objectColumns := ColumnDefinitionsForCsv(objectCsv);
  end if;
ReadGraphDataResult:
  result := [
    objects |-> objects,
    selectedIndex |-> selectedIndex,
    currentCsv |-> currentCsv,
    columns |-> currentColumns,
    objectColumns |-> objectColumns
  ];
ReadGraphDataReturn:
  return;
end procedure;

procedure ChooseImportPlan(file, directory, reservedPaths)
variables model = NoValue, choice = NoValue;
begin
CollisionModel:
  model := CoreCollisionModel(file, directory, reservedPaths);
CollisionAvailable:
  if model.mode = "available" then
    result := CoreResolveImportPlan(model, "available", reservedPaths);
  else
    collisionDraft := model ||
    resolver := [file |-> file, directory |-> directory, reserved |-> reservedPaths];
    choice := AwaitCollisionModalOutcome();
    if choice = "rename" \/ choice = "replace" then
      result := CoreResolveImportPlan(model, choice, reservedPaths);
    else
      result := NoValue;
    end if;
    collisionDraft := NoValue ||
    resolver := NoValue;
  end if;
CollisionReturn:
  return;
end procedure;

procedure RunLifecycleTask(requestedLifecycle, eventName, task)
begin
DelegateLifecycle:
  result := RunApplicationLifecycleTask(requestedLifecycle, eventName, task);
LifecycleTelemetry:
  if TaskFailed(result) then
    effect := PublishDebugTelemetry(TaskError(result));
  end if;
LifecycleUiReturn:
  return;
end procedure;

procedure PrepareFileDrop(slotId)
begin
PrepareFileDropRuntime:
  result := SlotApiPrepareFileDrop(slotId);
PrepareFileDropState:
  if result then
    preparedSlot := slotId ||
    dragRuntimeActive := TRUE;
  else
    preparedSlot := NoValue;
  end if;
PrepareDropReturn:
  return;
end procedure;

procedure ImportExternalFile(file, slotId)
begin
PrepareExternalDrop:
  call PrepareFileDrop(slotId);
RunExternalImport:
  if result then
    call RunLifecycleTask(
      "importing",
      "SLOT_DROP_IMPORT",
      [command |-> "assets.importToSlot", file |-> file, slotId |-> slotId]);
  end if;
FinishExternalDrop:
  effect := SlotApiFinishFileDrop();
  dragRuntimeActive := FALSE ||
  preparedSlot := NoValue;
ExternalDropReturn:
  return;
end procedure;

procedure MountDashboardDropReceiver()
begin
MountReceiver:
  if dashboardDropReceiver = "unmounted" then
    dashboardDropReceiver := "mounted" ||
    dashboardDropReceiverCount := 1;
  end if;
MountReceiverInvariant:
  assert dashboardDropReceiver = "mounted" /\ dashboardDropReceiverCount = 1;
MountReceiverReturn:
  return;
end procedure;

procedure RerenderDashboardDropReceiver()
begin
RerenderReceiverInvariant:
  assert dashboardDropReceiver = "mounted" /\ dashboardDropReceiverCount = 1;
RerenderReceiverContinuity:
  result := "continuous";
RerenderReceiverReturn:
  return;
end procedure;

procedure UnmountDashboardDropReceiver()
begin
UnmountReceiver:
  dashboardDropReceiver := "unmounted" ||
  dashboardDropReceiverCount := 0 ||
  activeDropEventId := NoValue;
UnmountReceiverReturn:
  return;
end procedure;

procedure DispatchExternalDrop(dropEventId, file, slotId)
begin
DispatchReceiverInvariant:
  assert dashboardDropReceiverCount \in {0, 1};
DispatchExternalDropOnce:
  if dashboardDropReceiver = "mounted"
     /\ dashboardDropReceiverCount = 1
     /\ DropAcceptingUiState()
     /\ dropEventId # lastHandledDropEventId
     /\ activeDropEventId = NoValue then
    activeDropEventId := dropEventId;
    call ImportExternalFile(file, slotId);
    lastHandledDropEventId := dropEventId ||
    activeDropEventId := NoValue;
  end if;
DispatchExternalDropReturn:
  return;
end procedure;

procedure CreateEmptyCsv()
variables createdCsv = NoValue;
begin
EmptyCsvCreate:
  createdCsv := AssetsCreateEmptyProjectCsv();
EmptyCsvSelect:
  if createdCsv # NoValue then
    result := AssetApiSelectCsv(CanonicalAssetPath(createdCsv));
    lastPersistentCommand := [
      name |-> "assets.createEmptyCsv",
      csvId |-> createdCsv.id
    ];
  end if;
EmptyCsvReturn:
  return;
end procedure;

procedure SelectProjectTreeNode(path)
variables node = NoValue;
begin
ProjectTreeSelectResolve:
  node := ResolveProjectTreeNodeFromCurrentVfs(path);
ProjectTreeSelect:
  if node # NoValue then
    effect := SelectProjectTreeNodeThroughExistingSelectionCommand(node);
  end if;
ProjectTreeSelectReturn:
  return;
end procedure;

procedure MoveProjectTreeNode(path, directory)
variables movePlan = NoValue;
begin
ProjectTreeMoveEligibility:
  if TreeMoveSourceEligible(path) then
    movePlan := AssetApiPlanMove(path, directory);
  else
    movePlan := NoValue;
  end if;
ProjectTreeMoveCommit:
  if movePlan # NoValue then
    lastPersistentCommand := [
      name |-> "assets.move",
      plan |-> movePlan
    ] ||
    effect := AssetApiMove(movePlan);
  end if;
ProjectTreeMoveReturn:
  return;
end procedure;

procedure OpenTrashAssetRowMenu(path)
variables asset = NoValue;
begin
TrashMenuResolve:
  asset := ResolveProjectAsset(path);
TrashMenuOpen:
  if asset # NoValue /\ IsTrashedAsset(asset) then
    effect := OpenRowActionMenu(path);
  end if;
TrashMenuReturn:
  return;
end procedure;

procedure ResolveSettingsOverlayMaximum()
begin
SettingsOverlayMaximum:
  result := CommonFastFigureSettingsOverlayMaximum();
SettingsOverlayMaximumCheck:
  assert result > MantineBuiltinMaximumSize();
SettingsOverlayMaximumReturn:
  return;
end procedure;

procedure StartSettingsOverlayResize(pointerY, currentHeight)
begin
SettingsOverlayResizeStart:
  settingsOverlayResizeStartY := pointerY ||
  settingsOverlayResizeStartHeight := currentHeight ||
  settingsOverlayResizeActive := TRUE;
SettingsOverlayResizeStartReturn:
  return;
end procedure;

procedure MoveSettingsOverlayResize(pointerY)
begin
SettingsOverlayResizeMove:
  if settingsOverlayResizeActive then
    settingsOverlayHeight := ClampSettingsOverlayHeight(
      settingsOverlayResizeStartHeight + pointerY - settingsOverlayResizeStartY);
    assert ProjectAuthorityUnchangedByOverlayResize();
  end if;
SettingsOverlayResizeMoveReturn:
  return;
end procedure;

procedure EndSettingsOverlayResize()
begin
SettingsOverlayResizeEnd:
  settingsOverlayResizeActive := FALSE ||
  settingsOverlayResizeStartY := NoValue ||
  settingsOverlayResizeStartHeight := NoValue;
SettingsOverlayResizeEndReturn:
  return;
end procedure;

procedure LayoutSlotClick(slotId)
begin
LayoutSlotToggle:
  if IsVisibleLayoutPreviewSlot(slotId) then
    layoutSelection := ToggleSetMember(layoutSelection, slotId);
  end if;
LayoutSlotNoProjectMutation:
  assert ProjectAuthorityUnchangedByLayoutSelection();
LayoutSlotReturn:
  return;
end procedure;

procedure LayoutBackgroundClick(targetKind)
begin
LayoutBackgroundClear:
  if targetKind = "preview-background" \/ targetKind = "modal-nonslot-background" then
    layoutSelection := {};
  end if;
LayoutBackgroundNoProjectMutation:
  assert ProjectAuthorityUnchangedByLayoutSelection();
LayoutBackgroundReturn:
  return;
end procedure;

procedure LayoutSelectionConsumer(command)
begin
LayoutSelectionConsume:
  effect := ExecuteLayoutSelectionCommand(command, layoutSelection);
LayoutSelectionReconcile:
  layoutSelection := ReconcileLayoutSelectionAfterCommand(command, layoutSelection);
LayoutSelectionConsumerReturn:
  return;
end procedure;

procedure ClearLayoutSelectionForGridOrClose()
begin
LayoutSelectionClear:
  layoutSelection := {};
LayoutSelectionClearReturn:
  return;
end procedure;

procedure ReadLayoutPreview(renderedWidth)
begin
LayoutPreviewRead:
  result := LayoutApiReadState(renderedWidth);
LayoutPreviewAspect:
  assert PreviewGeometryUsesRenderedWidthAndConfiguredAspect(
    result.previewGeometry,
    renderedWidth,
    result.slotStyle.aspect);
LayoutPreviewReturn:
  return;
end procedure;

procedure ConnectExistingAsset(path, kind, slotId)
begin
ExplicitAssetConnection:
  if AssetAndSlotConnectionInputsResolve(path, kind, slotId)
     /\ ~IsTrashedProjectAsset(path)
     /\ IsCsvOrImageAssetKind(kind) then
    lastPersistentCommand := [
      name |-> "assets.connectToSlot",
      path |-> path,
      kind |-> kind,
      slotId |-> slotId
    ];
  end if;
ConnectAssetReturn:
  return;
end procedure;

procedure FastFigureApp()
begin
ReadAppearance:
  result := MantineProviderFromPersistentPalette(ReadAppearancePalette());
MountShell:
  result := MountFastFigureShell(result);
MountDropReceiver:
  if dashboardDropReceiver = "unmounted" then
    call MountDashboardDropReceiver();
  end if;
AppReturn:
  return;
end procedure;

procedure FastFigureShell(width, collapsed)
begin
UpdateSidebarLocalState:
  sidebarWidth := width ||
  sidebarCollapsed := collapsed;
ProjectSidebarGeometry:
  effect := ApplySidebarGeometryToRenderer(sidebarWidth, sidebarCollapsed);
ResizePlots:
  effect := RequestPlotResizeFromCurrentAuthority();
ShellReturn:
  return;
end procedure;

begin
InitializeApp:
  call FastFigureApp();
Main:
  while TRUE do
    either
      with name = NextProjectNameInput() do
        call SetProjectName(name);
      end with;
    or
      with slotId = NextSelectedSlotId(),
           contentType = NextSlotContentType() do
        call SetSlotContentType(slotId, contentType);
      end with;
    or
      with slotIds = NextSlotResetIds() do
        call ResetSlots(slotIds);
      end with;
    or
      with slotId = NextEmptyImageTargetSlotId() do
        call InsertEmptyImage(slotId);
      end with;
    or
      with palette = NextAppearancePalette() do
        call SetAppearancePalette(palette);
      end with;
    or
      call ResetAppearancePalette();
    or
      with dropEventId = NextDropEventId(),
           file = NextDroppedFile(),
           slotId = NextDropSlotId() do
        call DispatchExternalDrop(dropEventId, file, slotId);
      end with;
    or
      with path = NextAssetPath(), kind = NextAssetKind(), slotId = NextDropSlotId() do
        call ConnectExistingAsset(path, kind, slotId);
      end with;
    or
      call CreateEmptyCsv();
    or
      with path = NextProjectTreeSelectionPath() do
        call SelectProjectTreeNode(path);
      end with;
    or
      with path = NextProjectTreeDragPath(),
           directory = NextProjectTreeDropDirectory() do
        call MoveProjectTreeNode(path, directory);
      end with;
    or
      with path = NextTrashedAssetMenuPath() do
        call OpenTrashAssetRowMenu(path);
      end with;
    or
      call ResolveSettingsOverlayMaximum();
    or
      with pointerY = NextOverlayResizePointerY(),
           currentHeight = CurrentSettingsOverlayHeight() do
        call StartSettingsOverlayResize(pointerY, currentHeight);
      end with;
    or
      with pointerY = NextOverlayResizePointerY() do
        call MoveSettingsOverlayResize(pointerY);
      end with;
    or
      call EndSettingsOverlayResize();
    or
      with slotId = NextLayoutPreviewSlotClick() do
        call LayoutSlotClick(slotId);
      end with;
    or
      with targetKind = NextLayoutBackgroundClickKind() do
        call LayoutBackgroundClick(targetKind);
      end with;
    or
      with command = NextLayoutSelectionCommand() do
        call LayoutSelectionConsumer(command);
      end with;
    or
      if LayoutGridChangedOrOverlayClosed() then
        call ClearLayoutSelectionForGridOrClose();
      end if;
    or
      with renderedWidth = CurrentLayoutPreviewRenderedWidth() do
        call ReadLayoutPreview(renderedWidth);
      end with;
    or
      call RerenderDashboardDropReceiver();
    end either;
  end while;
end algorithm;
*)
====
