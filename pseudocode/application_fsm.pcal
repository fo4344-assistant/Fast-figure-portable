CONSTANT NoValue

(*
--algorithm FastFigureApplicationOrchestration
variables
  projectResult = NoValue,
  interfaceState = NoValue,
  projectionEffect = NoValue,
  result = NoValue;

procedure DispatchInterfaceEvent(eventName, payload)
begin
InterfaceOnly:
  result := InterfaceFsmSend(eventName, payload);
InterfaceReturn:
  return;
end procedure;

procedure DispatchProjectCommand(eventName, payload)
begin
ProjectCommit:
  projectResult := ProjectEfsmSend(eventName, payload);
ProjectCommitGuard:
  assert projectResult.committed;
InterfaceReconciliation:
  interfaceState := InterfaceFsmReconcileProjectResult(eventName, projectResult);
RendererAfterReconciliation:
  projectionEffect := ApplyDashboardProjectionInvalidation(
    eventName,
    projectResult,
    interfaceState
  );
NoRecursiveMutation:
  assert RendererDidNotDispatchProjectOrInterfaceCommand(projectionEffect);
ApplicationResult:
  result := projectResult;
ApplicationReturn:
  return;
end procedure;

procedure RunLifecycleTask(lifecycleName, eventName, task)
begin
LifecycleDelegation:
  result := InterfaceFsmRunLifecycle(lifecycleName, eventName, task);
LifecycleReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with request = NextInterfaceOnlyRequest() do
        call DispatchInterfaceEvent(request.event, request.payload);
      end with;
    or
      with request = NextProjectMutationRequest() do
        call DispatchProjectCommand(request.event, request.payload);
      end with;
    end either;
  end while;
end algorithm;
*)
