---- MODULE FastFigureApplicationFsmPseudocode ----
EXTENDS Naturals

\* Direct r13 translation of the selection-command portion of
\* sourcescript/application_fsm.py. Resolver functions return NoSelection
\* when the requested current reference cannot be resolved.
CONSTANTS CsvRequests, ImageRequests, ObjectRequests,
          ResolveCsvPath, ResolveImagePath,
          ResolveObjectIndex, ResolveObjectCsvPath,
          NoSelection

(*
--algorithm FastFigureApplicationFsmSelection {
  variables assetSelection = "none",
            assetPath = NoSelection,
            graphObject = "none",
            graphObjectIndex = NoSelection;

  procedure SelectCsv(request) {
  ResolveCsv:
    with (csvPath = ResolveCsvPath[request]) {
      if (csvPath # NoSelection) {
      ClearObjectForCsv:
        graphObject := "none";
        graphObjectIndex := NoSelection;
      CommitCsvSelection:
        assetSelection := "csv";
        assetPath := csvPath;
      };
    };
    return;
  }

  procedure SelectObject(request) {
  ResolveObject:
    with (index = ResolveObjectIndex[request]) {
      if (index # NoSelection) {
      ResolveObjectCsv:
        with (csvPath = ResolveObjectCsvPath[index]) {
          if (csvPath # NoSelection) {
          ClearObjectForObject:
            graphObject := "none";
            graphObjectIndex := NoSelection;
          CommitObjectCsvSelection:
            assetSelection := "csv";
            assetPath := csvPath;
          CommitObjectSelection:
            graphObject := "selected";
            graphObjectIndex := index;
          };
        };
      };
    };
    return;
  }

  procedure SelectImage(request) {
  ResolveImage:
    with (imagePath = ResolveImagePath[request]) {
      if (imagePath # NoSelection) {
      ClearObjectForImage:
        graphObject := "none";
        graphObjectIndex := NoSelection;
      CommitImageSelection:
        assetSelection := "image";
        assetPath := imagePath;
      };
    };
    return;
  }

  SelectionLoop:
    while (TRUE) {
      either {
        with (request \in CsvRequests) {
          call SelectCsv(request);
        };
      } or {
        with (request \in ObjectRequests) {
          call SelectObject(request);
        };
      } or {
        with (request \in ImageRequests) {
          call SelectImage(request);
        };
      } or {
      ClearGraphObject:
        graphObject := "none";
        graphObjectIndex := NoSelection;
      } or {
      ClearAsset:
        assetSelection := "none";
        assetPath := NoSelection;
      };
    };
}
*)
====
