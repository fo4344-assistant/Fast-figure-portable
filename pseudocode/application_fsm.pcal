---- MODULE FastFigureApplicationFsmPseudocode ----
EXTENDS Naturals, Sequences

\* r17 PlusCal pseudocode for sourcescript/application_fsm.py.
\* Helper operators represent Source Script-defined resolution/candidate calculations.

CONSTANT NoSelection

(*
--algorithm FastFigureApplicationFsm
variables
  lifecycle = "booting",
  workspace = "project",
  overlay = "none",
  assetSelection = "none",
  assetPath = NoSelection,
  graphObject = "none",
  graphObjectIndex = NoSelection,
  direction = "fsm-to-model",
  revision = 0,
  error = NoSelection,
  projectAuthority = ReadActiveProject(),
  selectedSlotId = NoSelection,
  result = NoSelection,
  effect = NoSelection;

procedure PublishState()
begin
PublishRevision:
  revision := revision + 1;
PublishReturn:
  return;
end procedure;

procedure Transition(region, target, event, payload)
begin
TransitionMode:
  if CurrentRegionState(region) = target /\ ~RequestsReentry(payload) then
    effect := RunRegionUpdateHook(region, event, payload);
  else
    effect := RunRegionExitHook(region, event, payload);
    effect := SetRegionState(region, target);
    effect := RunRegionEntryHook(region, event, payload);
  end if;
TransitionDirection:
  direction := PayloadDirectionOrDefault(payload);
TransitionPublish:
  call PublishState();
TransitionReturn:
  return;
end procedure;

procedure ProcessRegion(region, event, payload)
variables handler = NoSelection;
begin
ResolveRegionHandler:
  handler := ResolveRegionHandler(region, event);
RunRegionHandler:
  if handler # NoSelection then
    effect := ApplyDeclaredHandlerAction(handler, payload);
  end if;
RegionTransition:
  if handler # NoSelection /\ HandlerHasTarget(handler) then
    call Transition(region, HandlerTarget(handler, payload), event, payload);
  end if;
ProcessRegionReturn:
  return;
end procedure;

procedure Send(event, payload)
variables handledBefore = HandlerCount();
begin
LifecycleRegion:
  call ProcessRegion("lifecycle", event, payload);
WorkspaceRegion:
  call ProcessRegion("workspace", event, payload);
OverlayRegion:
  call ProcessRegion("overlay", event, payload);
AssetRegion:
  call ProcessRegion("assetSelection", event, payload);
GraphObjectRegion:
  call ProcessRegion("graphObject", event, payload);
UnhandledEvent:
  if HandlerCount() = handledBefore then
    effect := RecordDebugWarning(event);
  end if;
SendReturn:
  return;
end procedure;

procedure Notify(objectName, event, payload)
begin
NotifyGuard:
  if lifecycle # "booting" /\ ~IsTransitionInProgress() then
    direction := "model-to-ui";
    if CurrentWorkspaceOrOverlaySubscribes(objectName) then
      effect := RunProjectionUpdate(objectName, event, payload);
    end if;
    revision := revision + 1;
  end if;
NotifyReturn:
  return;
end procedure;

procedure RunLifecycle(requestedLifecycle, event, task)
begin
LifecycleReadyGuard:
  if lifecycle = "ready" then
    lifecycle := requestedLifecycle;
  end if;
LifecycleTask:
  if lifecycle = requestedLifecycle then
    either
      result := ExecuteTaskResult(task);
    or
      error := ExecuteTaskFailure(task) ||
      lifecycle := "error";
    end either;
  end if;
LifecycleRestore:
  if lifecycle = requestedLifecycle \/ lifecycle = "error" then
    lifecycle := "ready";
  end if;
LifecycleReturn:
  return;
end procedure;

procedure SelectCsv(request)
variables csvPath = NoSelection;
begin
ResolveCsv:
  csvPath := ResolveCsvPath(request);
ClearObjectForCsv:
  if csvPath # NoSelection then
    graphObject := "none" ||
    graphObjectIndex := NoSelection;
  end if;
CommitCsvSelection:
  if csvPath # NoSelection then
    assetSelection := "csv" ||
    assetPath := csvPath;
  end if;
SelectCsvReturn:
  return;
end procedure;

procedure SelectObject(request)
variables index = NoSelection, csvPath = NoSelection;
begin
ResolveObjectIndex:
  index := ResolveObjectIndex(request);
ResolveObjectCsv:
  if index # NoSelection then
    csvPath := ResolveObjectCsvPath(index);
  end if;
ClearObjectForObject:
  if index # NoSelection /\ csvPath # NoSelection then
    graphObject := "none" ||
    graphObjectIndex := NoSelection;
  end if;
CommitObjectCsvSelection:
  if index # NoSelection /\ csvPath # NoSelection then
    assetSelection := "csv" ||
    assetPath := csvPath;
  end if;
CommitObjectSelection:
  if index # NoSelection /\ csvPath # NoSelection then
    graphObject := "selected" ||
    graphObjectIndex := index;
  end if;
SelectObjectReturn:
  return;
end procedure;

procedure SelectImage(request)
variables imagePath = NoSelection;
begin
ResolveImage:
  imagePath := ResolveImagePath(request);
ClearObjectForImage:
  if imagePath # NoSelection then
    graphObject := "none" ||
    graphObjectIndex := NoSelection;
  end if;
CommitImageSelection:
  if imagePath # NoSelection then
    assetSelection := "image" ||
    assetPath := imagePath;
  end if;
SelectImageReturn:
  return;
end procedure;

procedure ApplySlotSelection(payload)
variables slot = NoSelection;
begin
ResolveSlotSelection:
  if payload.slotId = NoSelection then
    slot := NoSelection;
  else
    slot := ResolveVisibleSlotFromCurrentProject(payload.slotId);
  end if;
CommitSlotSelection:
  if payload.slotId = NoSelection then
    selectedSlotId := NoSelection ||
    graphObject := "none" ||
    graphObjectIndex := NoSelection ||
    workspace := "project";
  elsif slot # NoSelection then
    if PayloadUsesUiToggle(payload) /\ selectedSlotId = slot.id then
      selectedSlotId := NoSelection ||
      graphObject := "none" ||
      graphObjectIndex := NoSelection ||
      workspace := "project";
    else
      selectedSlotId := slot.id ||
      workspace := IF slot.contentType = "image" THEN "slot.image" ELSE "slot.graph";
      if ~GraphObjectSelectionValidForSlot(slot, graphObjectIndex) then
        graphObject := "none" ||
        graphObjectIndex := NoSelection;
      end if;
    end if;
  end if;
SlotSelectionReturn:
  return;
end procedure;

procedure ApplyProjectLoaded(project)
variables candidate = project;
begin
ProjectLoadValidate:
  if HasWriteScope("project") /\ ValidateWholeProject(candidate) then
    projectAuthority := candidate;
    selectedSlotId := ReResolveOrClearSelectedSlot(candidate, selectedSlotId);
    assetPath := ReResolveOrClearAssetPath(candidate, assetPath);
    assetSelection := ReResolveOrClearAssetKind(candidate, assetPath);
    graphObjectIndex := ReResolveOrClearGraphObject(candidate, selectedSlotId, graphObjectIndex);
    graphObject := IF graphObjectIndex = NoSelection THEN "none" ELSE "selected";
    effect := ReleaseOldProjectResourcesAfterCommit();
    effect := ReprojectRendererFrom(candidate);
  end if;
ProjectLoadReturn:
  return;
end procedure;

procedure ApplyProjectNodeMoved(payload)
variables candidate = NoSelection;
begin
MoveResolveAndBuild:
  candidate := BuildCurrentValidatedMoveCandidate(payload, projectAuthority);
MoveCommit:
  if candidate # NoSelection then
    projectAuthority := candidate;
    assetPath := ReResolveOrClearAssetPath(candidate, assetPath);
    assetSelection := ReResolveOrClearAssetKind(candidate, assetPath);
    graphObjectIndex := ReResolveOrClearGraphObject(candidate, selectedSlotId, graphObjectIndex);
    graphObject := IF graphObjectIndex = NoSelection THEN "none" ELSE "selected";
    result := FinalMovePath(candidate);
  end if;
MoveReturn:
  return;
end procedure;

procedure ApplyGraphObjectsReplaced(payload)
variables candidate = NoSelection;
begin
GraphReplaceBuild:
  candidate := BuildValidatedGraphObjectReplacement(payload, projectAuthority);
GraphReplaceCommit:
  if candidate # NoSelection then
    projectAuthority := CommitChart(projectAuthority, candidate);
    if ~ValidGraphObjectIndex(candidate, graphObjectIndex) then
      graphObject := "none" ||
      graphObjectIndex := NoSelection;
    end if;
    result := candidate;
  end if;
GraphReplaceReturn:
  return;
end procedure;

procedure ApplySlotsReset(slotIds)
variables candidate = NoSelection;
begin
ResetBuild:
  candidate := BuildValidatedSlotsResetCandidate(slotIds, projectAuthority);
ResetCommit:
  if candidate # NoSelection then
    projectAuthority := candidate;
    graphObjectIndex := ReResolveOrClearGraphObject(candidate, selectedSlotId, graphObjectIndex);
    graphObject := IF graphObjectIndex = NoSelection THEN "none" ELSE "selected";
    result := candidate;
  end if;
ResetReturn:
  return;
end procedure;

procedure ApplySlotsSwapped(sourceId, targetId)
variables candidate = NoSelection;
begin
SwapBuild:
  candidate := BuildValidatedSlotLocalPayloadSwap(sourceId, targetId, projectAuthority);
SwapCommit:
  if candidate # NoSelection then
    projectAuthority := candidate;
    selectedSlotId := ReconcileSelectionAcrossSwap(selectedSlotId, sourceId, targetId);
    result := candidate;
  end if;
SwapReturn:
  return;
end procedure;

procedure ApplyCaptionText(target, text)
variables candidate = NoSelection;
begin
CaptionBuild:
  candidate := BuildExplicitCaptionOwnerCandidate(target, text, projectAuthority);
CaptionCommit:
  if candidate # NoSelection /\ ValidateWholeProject(candidate) then
    projectAuthority := candidate;
    result := candidate;
  end if;
CaptionReturn:
  return;
end procedure;

procedure ApplySlotCaptionsInserted(slotIds)
variables candidate = NoSelection;
begin
CaptionInsertBuild:
  candidate := BuildGlobalCaptionInsertionCandidate(slotIds, projectAuthority);
CaptionInsertCommit:
  if candidate # NoSelection /\ ValidateWholeProject(candidate) then
    projectAuthority := candidate;
    result := candidate;
  end if;
CaptionInsertReturn:
  return;
end procedure;

procedure ApplyGridLayout(rows, cols)
variables candidate = NoSelection;
begin
GridBuild:
  candidate := BuildGridResizeCandidate(rows, cols, projectAuthority);
GridCommit:
  if candidate # NoSelection /\ ValidateWholeProject(candidate) then
    projectAuthority := candidate;
    selectedSlotId := ReResolveOrClearSelectedSlot(candidate, selectedSlotId);
    result := candidate;
  end if;
GridReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with request = NextCsvSelectionRequest() do
        call SelectCsv(request);
      end with;
    or
      with request = NextObjectSelectionRequest() do
        call SelectObject(request);
      end with;
    or
      with request = NextImageSelectionRequest() do
        call SelectImage(request);
      end with;
    or
      with eventPayload = NextFsmEventPayload() do
        call Send(eventPayload.event, eventPayload);
      end with;
    end either;
  end while;
end algorithm;
*)
====
