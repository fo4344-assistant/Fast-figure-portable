---- MODULE FastFigureRendererRuntimePseudocode ----
EXTENDS Naturals

\* Direct translation of Source Script r25 sourcescript/renderer_runtime.py.
\* Renderer consumes Backend read projections, final Frontend state, and public actions only.

CONSTANT NoSelection

(*
--algorithm FastFigureRendererRuntime
variables
  projectProjection = NoSelection,
  interfaceState = NoSelection,
  frontendActions = NoSelection,
  slotDragSourceId = NoSelection,
  suppressBookmarkClick = FALSE,
  telemetryRevision = 0,
  statusText = "",
  debugEnabled = FALSE,
  result = NoSelection,
  effect = NoSelection;

procedure PublishTelemetry(patch)
begin
TelemetryPatch:
  effect := ApplyTelemetryProjectionPatch(patch);
TelemetryRevision:
  telemetryRevision := telemetryRevision + 1;
TelemetryReturn:
  return;
end procedure;

procedure SetDebug(enabled)
begin
DebugAuthority:
  debugEnabled := ToBoolean(enabled);
DebugProjection:
  call PublishTelemetry([debugEnabled |-> debugEnabled]);
DebugReturn:
  return;
end procedure;

procedure Status(message)
begin
StatusNormalize:
  statusText := NormalizeStatusText(message);
StatusProjection:
  call PublishTelemetry([status |-> statusText]);
StatusResult:
  result := statusText;
StatusReturn:
  return;
end procedure;

procedure RenderDashboard(suppliedProjectProjection, finalInterfaceState)
begin
RenderInput:
  assert IsImmutableBackendProjection(suppliedProjectProjection)
         /\ IsFrontendStateProjection(finalInterfaceState);
RenderGridAndStyle:
  effect := ProjectedLayoutToDashboardCss(suppliedProjectProjection);
RenderPurge:
  effect := PurgeDisconnectedPlotlyInstances();
RenderSlots:
  effect := RenderEveryVisibleSlotFromProjection(suppliedProjectProjection);
RenderGraphs:
  effect := RenderGraphSlotsFromResolvedProjection(suppliedProjectProjection);
RenderImages:
  effect := RenderImageSlotsFromProjectionCopies(suppliedProjectProjection);
RenderSelection:
  effect := ApplySelectedSlotClass(finalInterfaceState.selectedSlotId);
RenderAnnotations:
  effect := RenderLabelsAndCaptionsFromProjection(suppliedProjectProjection);
RenderNoAuthorityWrite:
  assert RendererDidNotReadOrMutateBackendAuthority();
RenderResult:
  result := "rendered";
RenderReturn:
  return;
end procedure;

procedure ApplyDashboardProjectionInvalidation(eventName, mutationResult, finalInterfaceState, suppliedProjectProjection)
variables projectionEffect = NoSelection;
begin
ProjectionEffectDecision:
  projectionEffect := ProjectionEffectFromCommittedProjectResult(
    eventName,
    mutationResult,
    finalInterfaceState
  );
ApplyProjection:
  if projectionEffect = "FULL_DASHBOARD" then
    call RenderDashboard(suppliedProjectProjection, finalInterfaceState);
  elsif projectionEffect = "TARGETED_PROJECTION" then
    effect := ApplyExistingTargetedProjection(
      eventName,
      mutationResult,
      suppliedProjectProjection,
      finalInterfaceState
    );
  end if;
NoRecursiveMutation:
  assert RendererDidNotDispatchBackendOrFrontendCommand();
ProjectionResult:
  result := projectionEffect;
ProjectionReturn:
  return;
end procedure;

procedure SetSelectedSlot(slotId, selectionDirection)
variables actionResult = NoSelection;
begin
PublicSelectionAction:
  actionResult := FrontendActionSlotsSelect(
    frontendActions,
    slotId,
    selectionDirection
  );
UpdateInputsAfterSelection:
  interfaceState := actionResult.interfaceState ||
  projectProjection := actionResult.projectProjection;
UpdateSelectedWorkspace:
  effect := RenderWorkspaceFromProjection(projectProjection, interfaceState);
ResizeAfterSelection:
  effect := RequestGraphViewResize();
SetSelectedResult:
  result := actionResult;
SetSelectedReturn:
  return;
end procedure;

procedure DashboardBackgroundClick()
begin
BackgroundDeselect:
  if interfaceState.selectedSlotId # NoSelection then
    call SetSelectedSlot(NoSelection, "fsm-to-model");
  end if;
BackgroundReturn:
  return;
end procedure;

procedure SlotSurfaceClick(slotId)
begin
SlotSurfaceResolve:
  if ProjectionContainsVisibleSlot(projectProjection, slotId) then
    if interfaceState.selectedSlotId # slotId then
      call SetSelectedSlot(slotId, "ui-to-fsm");
    else
      if ProjectionSlotHasInteractiveContent(projectProjection, slotId) then
        effect := PassSelectedContentInteractionToRenderer(slotId);
      else
        call SetSelectedSlot(slotId, "ui-to-fsm");
      end if;
    end if;
  end if;
SlotSurfaceReturn:
  return;
end procedure;

procedure BookmarkClick(slotId)
begin
BookmarkGuard:
  if ProjectionContainsVisibleSlot(projectProjection, slotId) then
    if suppressBookmarkClick then
      if slotDragSourceId = NoSelection then
        suppressBookmarkClick := FALSE;
      end if;
    else
      call SetSelectedSlot(slotId, "ui-to-fsm");
    end if;
  end if;
BookmarkReturn:
  return;
end procedure;

procedure BookmarkDragStart(slotId)
begin
BookmarkDragGuard:
  if ProjectionContainsVisibleSlot(projectProjection, slotId) then
    slotDragSourceId := slotId ||
    suppressBookmarkClick := TRUE;
  end if;
BookmarkDragStartReturn:
  return;
end procedure;

procedure SwapSlotContents(sourceId, targetId)
variables actionResult = NoSelection;
begin
PublicSwapAction:
  if sourceId # targetId
     /\ ProjectionContainsVisibleSlot(projectProjection, sourceId)
     /\ ProjectionContainsVisibleSlot(projectProjection, targetId) then
    actionResult := FrontendActionSlotsSwap(
      frontendActions,
      sourceId,
      targetId
    ) ||
    projectProjection := actionResult.projectProjection ||
    interfaceState := actionResult.interfaceState;
    call RenderDashboard(projectProjection, interfaceState);
  end if;
SwapNoRepeatMutation:
  assert RendererRefreshDidNotRepeatSlotSwap();
SwapSlotReturn:
  return;
end procedure;

procedure BookmarkDrop(targetSlotId)
begin
BookmarkDropGuard:
  if slotDragSourceId # NoSelection
     /\ targetSlotId # slotDragSourceId
     /\ ProjectionContainsVisibleSlot(projectProjection, targetSlotId) then
    call SwapSlotContents(slotDragSourceId, targetSlotId);
  end if;
BookmarkDropClearSource:
  slotDragSourceId := NoSelection;
BookmarkDropReturn:
  return;
end procedure;

procedure BookmarkDragEnd()
begin
BookmarkDragEndSource:
  slotDragSourceId := NoSelection;
BookmarkDragEndReturn:
  return;
end procedure;

procedure ReleaseSyntheticClickGuard()
begin
BookmarkClickGuardRelease:
  if suppressBookmarkClick
     /\ slotDragSourceId = NoSelection
     /\ PostDragClickOpportunityPassed() then
    suppressBookmarkClick := FALSE;
  end if;
BookmarkGuardReturn:
  return;
end procedure;

procedure PrepareDashboardFileDrop(slotId)
variables actionResult = NoSelection;
begin
ReusePublicSelectionAction:
  actionResult := FrontendActionSlotsSelect(frontendActions, slotId, "ui-to-fsm");
FileDropAccepted:
  if actionResult.accepted
     /\ actionResult.interfaceState.selectedSlotId = slotId then
    interfaceState := actionResult.interfaceState ||
    projectProjection := actionResult.projectProjection ||
    result := TRUE;
  else
    result := FALSE;
  end if;
FileDropClearSlotDrag:
  slotDragSourceId := NoSelection;
FileDropNoBackendResolve:
  assert RendererDidNotResolveBackendSlot();
FileDropPrepareReturn:
  return;
end procedure;

procedure ApplySlotStyle(suppliedProjectProjection, notify)
begin
StyleProjection:
  effect := ApplyDashboardCssFromProjectedStyle(suppliedProjectProjection);
StyleNotify:
  if notify then
    effect := FrontendProjectionNotification("layout", "model-to-ui", NoSelection);
  end if;
StyleReturn:
  return;
end procedure;

procedure ResolveSelectedChart(suppliedProjectProjection, finalInterfaceState)
begin
ResolveSelectedChartProjection:
  result := ResolveChartWithinProjection(
    suppliedProjectProjection,
    finalInterfaceState.selectedSlotId
  );
ResolveChartNoBackendRead:
  assert RendererDidNotReadBackendAuthority();
ResolveChartReturn:
  return;
end procedure;

procedure UpdateGraphView(suppliedProjectProjection, finalInterfaceState)
begin
ResolveWorkspaceProjection:
  result := WorkspaceProjectionFromInputs(
    suppliedProjectProjection,
    finalInterfaceState
  );
RenderWorkspaceProjection:
  effect := RenderWorkspaceProjection(result);
UpdateGraphReturn:
  return;
end procedure;

procedure StartupCoreRuntime(initialProjectProjection, initialInterfaceState, publicActions)
begin
StartupInputs:
  projectProjection := initialProjectProjection ||
  interfaceState := initialInterfaceState ||
  frontendActions := publicActions;
StartupValidateProjection:
  assert IsImmutableBackendProjection(projectProjection)
         /\ IsFrontendStateProjection(interfaceState);
StartupZoom:
  effect := ApplyDashboardZoomProjection();
StartupController:
  effect := InstallBookmarkAndDropController(frontendActions);
StartupRender:
  call RenderDashboard(projectProjection, interfaceState);
StartupStyle:
  call ApplySlotStyle(projectProjection, FALSE);
StartupLifecycleBoundary:
  effect := FrontendActionLifecycleReady(frontendActions);
StartupAudit:
  assert AuditProjectedReferenceRuntimeInvariants(projectProjection, interfaceState);
StartupNoSyntheticData:
  assert NoDefaultCsvOrFakeGraphObjectCreatedByRenderer();
StartupResult:
  result := "ready";
StartupReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      call RenderDashboard(projectProjection, interfaceState);
    or
      with slotId = NextBookmarkClickSlot() do
        call BookmarkClick(slotId);
      end with;
    or
      with slotId = NextSlotSurfaceClickSlot() do
        call SlotSurfaceClick(slotId);
      end with;
    or
      call DashboardBackgroundClick();
    or
      with slotId = NextBookmarkDragStartSlot() do
        call BookmarkDragStart(slotId);
      end with;
    or
      with slotId = NextBookmarkDropSlot() do
        call BookmarkDrop(slotId);
      end with;
    or
      call BookmarkDragEnd();
    or
      call ReleaseSyntheticClickGuard();
    end either;
  end while;
end algorithm;
*)
====
