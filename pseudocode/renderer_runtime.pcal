---- MODULE FastFigureRendererRuntimePseudocode ----
EXTENDS Naturals

\* r13 translation of sourcescript/renderer_runtime.py.
\* Renderer state is projection/runtime state, never persistent project authority.
CONSTANTS SlotIds, ContentSlots, EmptySlots, HiddenSlots, NoSelection

(*
--algorithm FastFigureRendererRuntime {
  variables selectedSlotId = NoSelection,
            slotDragSourceId = NoSelection,
            suppressBookmarkClick = FALSE,
            issuedCommand = NoSelection,
            telemetryRevision = 0,
            statusText = "",
            debugEnabled = FALSE,
            lifecycle = "booting",
            result = NoSelection;

  procedure PublishTelemetry(patch) {
  ApplyTelemetryPatch:
    ApplyTelemetryProjectionPatch(patch);
  IncrementTelemetryRevision:
    telemetryRevision := telemetryRevision + 1;
    return;
  }

  procedure SetDebug(enabled) {
  CommitDebugRuntimeAuthority:
    debugEnabled := ToBoolean(enabled);
  PublishDebugProjection:
    call PublishTelemetry([debugEnabled |-> debugEnabled]);
    return;
  }

  procedure Status(message) {
  NormalizeStatus:
    statusText := NormalizeStatusText(message);
  PublishStatus:
    call PublishTelemetry([status |-> statusText]);
    result := statusText;
    return;
  }

  procedure RenderDashboard() {
  ReadCurrentProject:
    with (project = ReadActiveProject()) {
    ApplyGridAndStyleProjection:
      ProjectLayoutToDashboardCss(project);
    PurgeStalePlots:
      PurgeDisconnectedPlotlyInstances();
    RenderVisibleSlots:
      RenderEveryVisibleSlotFromProject(project);
    RenderGraphs:
      RenderGraphSlotsFromReferencedCharts(project);
    RenderImages:
      RenderImageSlotsFromReferencedAssetsAndSlotSettings(project);
    ApplySelectionProjection:
      ApplySelectedSlotClass(selectedSlotId);
    RenderAnnotations:
      RenderLabelsAndCaptions(project);
    };
    result := "rendered";
    return;
  }

  procedure ToggleSlot(slotId) {
  ResolveToggleTarget:
    if (slotId \in SlotIds \ HiddenSlots) {
      if (selectedSlotId = slotId) {
      DeselectSlot:
        selectedSlotId := NoSelection;
      } else {
      SelectSlot:
        selectedSlotId := slotId;
      };
    };
  RefreshWorkspaceProjection:
    issuedCommand := [name |-> "SELECT_SLOT", slotId |-> selectedSlotId];
    RequestGraphViewAndResize();
    return;
  }

  procedure ContentBodyClick(slotId) {
  PreserveContentInteraction:
    skip;
    return;
  }

  procedure EmptySlotClick(slotId) {
  SelectEmptySlot:
    if (slotId \in EmptySlots) {
      call ToggleSlot(slotId);
    };
    return;
  }

  procedure BookmarkClick(slotId) {
  HandleBookmarkClick:
    if (~suppressBookmarkClick /\ slotId \in ContentSlots) {
      call ToggleSlot(slotId);
    };
    return;
  }

  procedure BookmarkDragStart(slotId) {
  StartBookmarkDrag:
    if (slotId \in ContentSlots) {
      slotDragSourceId := slotId;
      suppressBookmarkClick := TRUE;
    };
    return;
  }

  procedure BookmarkDrop(targetSlotId) {
  ResolveBookmarkDrop:
    if (slotDragSourceId # NoSelection
        /\ targetSlotId \in SlotIds \ HiddenSlots
        /\ targetSlotId # slotDragSourceId) {
    IssueSwapCommand:
      issuedCommand := [
        name |-> "SLOTS_SWAPPED",
        sourceId |-> slotDragSourceId,
        targetId |-> targetSlotId
      ];
    };
  ClearDragSource:
    slotDragSourceId := NoSelection;
    return;
  }

  procedure ReleaseSyntheticClickGuard() {
  ReleaseBookmarkClick:
    suppressBookmarkClick := FALSE;
    return;
  }

  procedure PrepareExternalFileDrop(slotId) {
  ResolveExternalDropTarget:
    if (slotId \in SlotIds \ HiddenSlots) {
      if (selectedSlotId # slotId) {
      SelectDropTargetWorkspace:
        call ToggleSlot(slotId);
      };
      result := TRUE;
    } else {
      result := FALSE;
    };
  ClearSlotDragSource:
    slotDragSourceId := NoSelection;
    return;
  }

  procedure ResolveSelectedChart() {
  ResolveSelectedSlot:
    with (slot = ResolveSlotFromActiveProject(selectedSlotId)) {
      if (slot # NoSelection /\ slot.chart # NoSelection) {
      ResolveReferencedChart:
        result := ResolveChartFromActiveProject(slot.chart);
      } else {
        result := NoSelection;
      };
    };
    return;
  }

  procedure UpdateGraphView() {
  ReResolveSelectedWorkspace:
    result := ProjectWorkspaceFromCurrentSelection(selectedSlotId);
  RenderWorkspaceFromAuthority:
    RenderWorkspaceProjection(result);
    return;
  }

  procedure ApplySlotStyle(notify) {
  ReadPersistentSlotStyle:
    with (style = ReadActiveProjectSlotStyle()) {
      ApplyStyleProjection:
        ApplyDashboardCssFromStyle(style);
    };
  OptionalLayoutNotification:
    if (notify) {
      issuedCommand := [name |-> "notify-layout"];
    };
    return;
  }

  procedure StartupCoreRuntime() {
  RequireValidExistingProject:
    assert ValidateWholeProject(ReadActiveProject());
  ApplyInitialZoom:
    ApplyDashboardZoomProjection();
  InstallSlotInteractionController:
    InstallBookmarkAndDropController();
  RenderExistingSlots:
    call RenderDashboard();
  ApplyInitialSlotStyle:
    call ApplySlotStyle(FALSE);
  EnterReadyLifecycle:
    lifecycle := "ready";
  AuditRuntimeInvariants:
    assert AuditProjectReferenceRuntimeInvariants();
  ReturnReadyRuntime:
    result := "ready";
    return;
  }

  Main:
    while (TRUE) {
      either {
        call RenderDashboard();
      } or {
        with (slotId \in ContentSlots) {
          call BookmarkClick(slotId);
        };
      } or {
        with (slotId \in EmptySlots) {
          call EmptySlotClick(slotId);
        };
      } or {
        call StartupCoreRuntime();
      };
    };
}
*)
====
