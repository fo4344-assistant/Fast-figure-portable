---- MODULE FastFigureRendererRuntimePseudocode ----
EXTENDS Naturals

\* r13 PlusCal pseudocode for sourcescript/renderer_runtime.py.

CONSTANT NoSelection

(*
--algorithm FastFigureRendererRuntime
variables
  selectedSlotId = NoSelection,
  slotDragSourceId = NoSelection,
  suppressBookmarkClick = FALSE,
  issuedCommand = NoSelection,
  telemetryRevision = 0,
  statusText = "",
  debugEnabled = FALSE,
  lifecycle = "booting",
  result = NoSelection,
  effect = NoSelection;

procedure PublishTelemetry(patch)
begin
TelemetryPatch:
  effect := ApplyTelemetryProjectionPatch(patch);
TelemetryRevision:
  telemetryRevision := telemetryRevision + 1;
TelemetryReturn:
  return;
end procedure;

procedure SetDebug(enabled)
begin
DebugAuthority:
  debugEnabled := ToBoolean(enabled);
DebugProjection:
  call PublishTelemetry([debugEnabled |-> debugEnabled]);
DebugReturn:
  return;
end procedure;

procedure Status(message)
begin
StatusNormalize:
  statusText := NormalizeStatusText(message);
StatusProjection:
  call PublishTelemetry([status |-> statusText]);
StatusResult:
  result := statusText;
StatusReturn:
  return;
end procedure;

procedure RenderDashboard()
begin
RenderGridAndStyle:
  effect := ProjectLayoutToDashboardCss(ReadActiveProject());
RenderPurge:
  effect := PurgeDisconnectedPlotlyInstances();
RenderSlots:
  effect := RenderEveryVisibleSlotFromProject(ReadActiveProject());
RenderGraphs:
  effect := RenderGraphSlotsFromReferencedCharts(ReadActiveProject());
RenderImages:
  effect := RenderImageSlotsFromReferencedAssetsAndSlotSettings(ReadActiveProject());
RenderSelection:
  effect := ApplySelectedSlotClass(selectedSlotId);
RenderAnnotations:
  effect := RenderLabelsAndCaptions(ReadActiveProject());
RenderResult:
  result := "rendered";
RenderReturn:
  return;
end procedure;

procedure SetSelectedSlot(slotId, selectionDirection)
begin
EmitSelectSlot:
  issuedCommand := [
    name |-> "SELECT_SLOT",
    slotId |-> slotId,
    direction |-> selectionDirection
  ];
ResolveSelectionAfterEvent:
  selectedSlotId := ReadSelectedSlotIdFromFsm();
UpdateSelectedWorkspace:
  call UpdateGraphView();
ResizeAfterSelection:
  effect := RequestGraphViewResize();
SetSelectedReturn:
  return;
end procedure;

procedure ContentBodyClick(slotId)
begin
ContentPassThrough:
  skip;
ContentReturn:
  return;
end procedure;

procedure EmptySlotClick(slotId)
begin
EmptySelect:
  if IsVisibleEmptySlot(slotId) then
    call SetSelectedSlot(slotId, "ui-to-fsm");
  end if;
EmptyReturn:
  return;
end procedure;

procedure BookmarkClick(slotId)
begin
BookmarkSelect:
  if ~suppressBookmarkClick /\ IsVisibleContentSlot(slotId) then
    call SetSelectedSlot(slotId, "ui-to-fsm");
  end if;
BookmarkReturn:
  return;
end procedure;

procedure BookmarkDragStart(slotId)
begin
BookmarkDragGuard:
  if IsVisibleContentSlot(slotId) then
    slotDragSourceId := slotId ||
    suppressBookmarkClick := TRUE;
  end if;
BookmarkDragStartReturn:
  return;
end procedure;

procedure SwapSlotContents(sourceId, targetId)
begin
EmitSlotSwap:
  if sourceId # targetId /\ IsVisibleSlot(sourceId) /\ IsVisibleSlot(targetId) then
    issuedCommand := [
      name |-> "SLOTS_SWAPPED",
      sourceId |-> sourceId,
      targetId |-> targetId
    ];
  end if;
SwapSlotReturn:
  return;
end procedure;

procedure BookmarkDrop(targetSlotId)
begin
BookmarkDropGuard:
  if slotDragSourceId # NoSelection
     /\ targetSlotId # slotDragSourceId
     /\ IsVisibleSlot(targetSlotId) then
    call SwapSlotContents(slotDragSourceId, targetSlotId);
  end if;
BookmarkDropClearSource:
  slotDragSourceId := NoSelection;
BookmarkDropReturn:
  return;
end procedure;

procedure ReleaseSyntheticClickGuard()
begin
BookmarkClickGuardRelease:
  suppressBookmarkClick := FALSE;
BookmarkGuardReturn:
  return;
end procedure;

procedure PrepareDashboardFileDrop(slotId)
begin
FileDropResolve:
  if IsVisibleSlot(slotId) then
    if selectedSlotId # slotId then
      call SetSelectedSlot(slotId, "ui-to-fsm");
    end if;
    result := TRUE;
  else
    result := FALSE;
  end if;
FileDropClearSlotDrag:
  slotDragSourceId := NoSelection;
FileDropPrepareReturn:
  return;
end procedure;

procedure ApplySlotStyle(notify)
begin
StyleProjection:
  effect := ApplyDashboardCssFromStyle(ReadActiveProjectSlotStyle());
StyleNotify:
  if notify then
    issuedCommand := [name |-> "notify-layout"];
  end if;
StyleReturn:
  return;
end procedure;

procedure ResolveSelectedChart()
begin
ResolveSelectedChartPath:
  result := ResolveChartFromSelectedSlot(ReadActiveProject(), selectedSlotId);
ResolveChartReturn:
  return;
end procedure;

procedure UpdateGraphView()
begin
ResolveWorkspaceProjection:
  result := ProjectWorkspaceFromCurrentSelection(selectedSlotId);
RenderWorkspaceProjection:
  effect := RenderWorkspaceFromAuthority(result);
UpdateGraphReturn:
  return;
end procedure;

procedure StartupCoreRuntime()
begin
StartupValidate:
  assert ValidateWholeProject(ReadActiveProject());
StartupZoom:
  effect := ApplyDashboardZoomProjection();
StartupController:
  effect := InstallBookmarkAndDropController();
StartupRender:
  call RenderDashboard();
StartupStyle:
  call ApplySlotStyle(FALSE);
StartupReady:
  lifecycle := "ready";
StartupAudit:
  assert AuditProjectReferenceRuntimeInvariants();
StartupResult:
  result := "ready";
StartupReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      call RenderDashboard();
    or
      with slotId = NextBookmarkClickSlot() do
        call BookmarkClick(slotId);
      end with;
    or
      with slotId = NextEmptySlotClickSlot() do
        call EmptySlotClick(slotId);
      end with;
    or
      call StartupCoreRuntime();
    end either;
  end while;
end algorithm;
*)
====
