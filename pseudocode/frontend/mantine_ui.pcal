---- MODULE FastFigureFrontendMantineUiR38 ----
EXTENDS Naturals, Reals, Sequences, FiniteSets
\* Direct Source Script translation; Plan027 supplements current-authority display/input procedures.
\* FastFigureApi is the supplied public action surface; no Backend import.
\* UI drafts/resolvers/selection/geometry below live only within component lifetime.
\* BindComponentEvent(component,event,handler): associates a defined procedure reference
\* with that component event, invokes it once with the event's arguments, and propagates
\* its result/failure. BindComponentRenderRead(reader) calls reader for each render.
\* BindComponentPublicMethods(component,methods): binds the named public methods
\* as reads/actions of that component, forwarding each call's declared arguments.
\* This is function binding; each public method owns its input/return/failure algorithm.
\* These platform bindings retain no Project mutation input or display-state authority.
CONSTANT NoValue
SettingsOverlayNames == {"layout","label","caption","print"}
ComponentOwners == [
  FastFigureToolbar |-> "overlay toggle / selected target / explicit whole rendering",
  FastFigureDataActions |-> "asset import / slot reset/delete / ordinary empty CSV",
  FastFigureImageEditor |-> "image preview/settings",
  FastFigureProjectDataTree |-> "VFS projection / selection / move / drop / menu",
  FastFigureProjectActions |-> "project name / FFPX",
  FastFigureGraphDataEditor |-> "CSV/header/object",
  FastFigureGraphLayoutEditor |-> "chart title/global/axis",
  FastFigureGraphPaletteActions |-> "object colors",
  FastFigureGraphFileActions |-> "FFSX/Plotly / editable flag",
  FastFigurePaletteActions |-> "UI palette draft/apply/reset",
  FastFigureStatusDebug |-> "status/debug/log display",
  FastFigureReadmeOverlay |-> "README modal",
  FastFigureLabelOverlay |-> "label settings / position",
  FastFigureCaptionOverlay |-> "global or selected-slot caption / explicit insert",
  FastFigurePrintOverlay |-> "raster form / save/capture",
  FastFigureLayoutOverlay |-> "grid/style/zoom / local merge/split selection",
  FastFigureDashboardFileDrop |-> "one continuous external drop channel",
  FastFigureShell |-> "AppShell / sidebar / composition"]

(* --algorithm FrontendMantineUi
variables result = NoValue,
  collisionModel = NoValue, collisionResolver = NoValue,
  layoutSelectedSlotIds = {}, settingsOverlayHeight = NoValue,
  folding = [],
  sidebarGeometry = InitialSessionSidebarGeometry(), lastWorkspaceSize = NoValue,
  dropMounted = FALSE, dropAllowed = FALSE, dropReceiver = NoValue;

procedure readProjectAssetDisplay()
variables nodes = NoValue, slots = NoValue;
begin
OneMetadataReadPerPurpose:
  nodes := InvokePublicApi("assets.readTree",[]);
  slots := InvokePublicApi("slots.readDisplay",[]);
  result := [nodes |-> nodes,slotRows |-> slots]; return;
end procedure;

procedure readAssetRowDisplay(node)
begin
AlreadySuppliedMetadata:
  result := [referenceCount |-> node.referenceCount,rowCount |-> IF node.kind = "csv" THEN node.rowCount ELSE NoValue];
  return;
end procedure;

\* UiCommand instances are component-owned references. Callback invocation/await
\* captures {threw,failure,value}; it calls once synchronously before awaiting.
\* BoundProcedure captures only declared arguments; it is function binding.
procedure UiCommand_create(readCurrent,prepare,invoke,stepSize)
variables command = NoValue;
begin
CreateOwnedControl:
  command := NewUiCommandInstance(); command.readCurrent := readCurrent;
  command.prepare := prepare; command.invoke := invoke; command.stepSize := stepSize;
  command.text := ""; command.editTarget := NoValue;
  command.editing := FALSE; command.composing := FALSE; command.running := FALSE; command.active := TRUE;
  result := command; return;
end procedure;

procedure UiCommand_input(command,text,composing)
variables current = NoValue;
begin
RetainLexicalInput:
  if ~command.active \/ command.running then result := command.text; return; end if;
  current := InvokeCallback(command.readCurrent,<<>>);
  if current.target = NoValue then call UiCommand_cancel(command); result := command.text; return; end if;
  if command.editing /\ command.editTarget # current.target then
    command.editing := FALSE; command.composing := FALSE; command.editTarget := NoValue;
  end if;
  command.editTarget := current.target; command.editing := TRUE;
  command.text := text; command.composing := composing;
  PreserveWidgetCursorSelectionAndRawText(command,text);
  result := command.text; return;
end procedure;

procedure UiCommand_refresh(command,target)
variables current = NoValue;
begin
RefreshSameActiveTarget:
  if command.active /\ ~command.editing then
    current := InvokeCallback(command.readCurrent,<<>>);
    if current.target = target /\ command.prepare # NoValue then
      command.text := DisplayTextForOfficialValue(current.value);
      DisplayOfficialControlValue(command,current.value);
    end if;
  end if;
  result := current; return;
end procedure;

procedure UiCommand_cancel(command)
variables current = NoValue;
begin
CancelPendingEdit:
  command.editing := FALSE; command.composing := FALSE; command.editTarget := NoValue; command.text := "";
  if command.active then
    current := InvokeCallback(command.readCurrent,<<>>);
    command.text := DisplayTextForOfficialValue(current.value);
    if command.prepare # NoValue then DisplayOfficialControlValue(command,current.value); end if;
  end if;
  result := command.text; return;
end procedure;

procedure UiCommand_sendCurrent(command,value,target,current)
variables completion = NoValue, refresh = NoValue;
begin
OneJudgmentCurrent:
  if ~command.active \/ command.running \/ ~current.ready \/ current.target = NoValue \/ current.target # target then
    result := NoValue; return;
  end if;
  if command.prepare # NoValue /\ current.value = value then
    command.text := DisplayTextForOfficialValue(current.value);
    DisplayOfficialControlValue(command,current.value); result := NoValue; return;
  end if;
OneInvocationAndEveryExitCleanup:
  command.running := TRUE;
  completion := InvokeAndAwaitCallbackOnceCaptured(command.invoke,<<value,target,current.companions>>);
  command.running := FALSE;
  refresh := CaptureOriginalFailureOfProcedure(UiCommand_refresh,<<command,target>>);
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  if refresh.threw then PropagateOriginalFailure(refresh.failure); end if;
  result := completion.value; return;
end procedure;

procedure UiCommand_send(command,value,target)
variables current = NoValue;
begin
OneCurrentRead:
  if ~command.active \/ command.running then result := NoValue; return; end if;
  current := InvokeCallback(command.readCurrent,<<>>);
  if target = NoValue then target := current.target; end if;
  call UiCommand_sendCurrent(command,value,target,current); return;
end procedure;

procedure UiCommand_commit(command)
variables current = NoValue, prepared = NoValue;
begin
OneCompletedEdit:
  if ~command.active \/ ~command.editing \/ command.running \/ command.composing then result := NoValue; return; end if;
  current := InvokeCallback(command.readCurrent,<<>>);
  if current.target = NoValue \/ current.target # command.editTarget then
    call UiCommand_cancel(command); result := NoValue; return;
  end if;
  prepared := InvokeCallback(command.prepare,<<command.text,current.value>>);
  if ~prepared[1] then call UiCommand_cancel(command); result := NoValue; return; end if;
  command.editing := FALSE; command.composing := FALSE;
  call UiCommand_sendCurrent(command,prepared[2],command.editTarget,current);
  return;
end procedure;

procedure UiCommand_step(command,direction)
variables current = NoValue, parsed = NoValue, value = NoValue;
begin
OneStepCurrent:
  if ~command.active \/ command.running \/ command.composing \/ command.stepSize = NoValue then result := NoValue; return; end if;
  current := InvokeCallback(command.readCurrent,<<>>);
  if current.target = NoValue then call UiCommand_cancel(command); result := NoValue; return; end if;
  if command.editing /\ command.editTarget # current.target then command.editing := FALSE; command.composing := FALSE; end if;
  value := current.value;
  if command.editing then
    call prepareNumericInput(command.text,current.value,FALSE,NoValue); parsed := result;
    if parsed[1] then value := parsed[2]; end if;
  end if;
  if ~IsFiniteNumber(value) then value := 0; end if;
  value := IF direction = "increase" THEN value+command.stepSize ELSE value-command.stepSize;
  command.text := CompleteDecimalText(value); command.editTarget := current.target;
  command.editing := FALSE; command.composing := FALSE;
  call UiCommand_sendCurrent(command,value,current.target,current); return;
end procedure;

procedure UiCommand_dispose(command)
begin
EndControlLifetime:
  call UiCommand_cancel(command); command.active := FALSE;
  RemoveOnlyThisControlEventsAndSubscriptions(command); result := NoValue; return;
end procedure;


procedure prepareNumericInput(text,current,allowEmpty,emptyValue)
variables trimmed = TrimWhitespace(text), value = NoValue;
begin
EmptyAndCompleteDecimal:
  if trimmed = "" then
    result := IF allowEmpty THEN <<TRUE,emptyValue>> ELSE <<FALSE,current>>; return;
  end if;
  \* Full-string lexical match: optional sign; digits with at most one dot and at
  \* least one digit; optional e/E plus optional sign plus one or more digits.
  if ~FullStringMatches(trimmed,"[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?") then
    result := <<FALSE,current>>; return;
  end if;
  value := ParseCompleteDecimal(trimmed);
  result := IF IsFiniteNumber(value) THEN <<TRUE,value>> ELSE <<FALSE,current>>;
  \* Field-specific range/integer rules stay in the existing API/Backend owner.
  return;
end procedure;

procedure changeLayoutGridDimension(dimension,value,companion)
variables current = companion, rows = NoValue, cols = NoValue, range = NoValue;
begin
ConfirmedFiniteValueAndCurrentCompanion:
  Require(dimension \in {"rows","cols"} /\ IsFiniteNumber(value));
  if current = NoValue then current := InvokePublicApi("layout.readControls",[]); end if;
  rows := current.gridRows; cols := current.gridCols;
  range := IF dimension = "rows" THEN current.gridLimits.gridRows ELSE current.gridLimits.gridCols;
  value := Maximum(range[1],Minimum(range[2],value));
  if dimension = "rows" then rows := value; else cols := value; end if;
  result := InvokePublicApi("layout.setGrid",[rows |-> rows,cols |-> cols]);
  if result # FALSE then
    \* The committed command's layout display has already refreshed the UI.
    layoutSelectedSlotIds := {};
  end if;
  \* Synchronous read/dispatch, unchanged Backend integer/validation/commit.
  \* Rejection/exception preserves the previous value and local selection.
  return;
end procedure;

procedure handleDebugToggle()
variables enabled = FALSE;
begin
OwnerReadNotDisplayProjection:
  call readDebugEnabled(); enabled := result;
  call setDebugEnabled(~enabled);
  \* Same synchronous click, no callback/await between read and explicit bool setter.
  \* Setter writes owner then calls the mounted display setter.
  return;
end procedure;

procedure bindUiDisplay(elements)
begin
ReturnMountElementSetters:
  \* The supplied elements are this App's display setters, not a Project store.
  result := [selection |-> BoundProcedure(DisplaySelection,<<elements>>),assetSelection |-> elements.assetSelection,
    graphObject |-> elements.graphObject,overlay |-> elements.overlay,
    lifecycle |-> elements.lifecycle,taskError |-> elements.taskError,
    projectName |-> BoundProcedure(DisplayProjectName,<<elements>>),assetTree |-> BoundProcedure(DisplayAssetTree,<<elements>>),
    slotConnections |-> BoundProcedure(DisplaySlotConnections,<<elements>>),csvOptions |-> BoundProcedure(DisplayCsvOptions,<<elements>>),
    csv |-> BoundProcedure(DisplayCsv,<<elements>>),slot |-> BoundProcedure(DisplaySlot,<<elements>>),graph |-> BoundProcedure(DisplayGraph,<<elements>>),image |-> BoundProcedure(DisplayImage,<<elements>>),
    layout |-> BoundProcedure(DisplayLayout,<<elements>>),labels |-> BoundProcedure(DisplayLabels,<<elements>>),
    captions |-> BoundProcedure(DisplayCaptions,<<elements>>),
    printSettings |-> BoundProcedure(DisplayPrint,<<elements>>),palette |-> elements.palette,zoom |-> elements.zoom,
    statusDisplay |-> [statusText |-> elements.statusText,debugEnabled |-> elements.debugEnabled,
      debugLines |-> elements.debugLines]];
  \* Status text is shown as supplied. DebugEnabled sets label and pressed;
  \* debugLines joins supplied lines with newlines. Both debugLines and lifecycle
  \* recompute save/clear availability from the displayed lines and busy lifecycle.
  \* No status/debug setter reads Project.
  return;
end procedure;

procedure DisplayProjectName(elements)
begin
ApplyOfficialRead:
  SetProjectName(elements,InvokePublicApi("project.readName",[]));
  result := NoValue;
  return;
end procedure;

