---- MODULE FastFigureFrontendMantineUiR38 ----
EXTENDS Naturals, Reals, Sequences, FiniteSets
\* Direct Source Script translation; Plan027 supplements current-authority display/input procedures.
\* FastFigureApi is the supplied public action surface; no Backend import.
\* UI drafts/resolvers/selection/geometry below live only within component lifetime.
\* ReactUseSyncExternalStore(subscribe,getSnapshot): React registers subscribe's listener,
\* compares getSnapshot's scalar revision with the previous revision, schedules render
\* on a difference, and calls the returned unsubscribe on component teardown.
\* BindComponentEvent(component,event,handler): associates a defined procedure reference
\* with that component event, invokes it once with the event's arguments, and propagates
\* its result/failure. BindComponentRenderRead(reader) calls reader for each render.
\* BindComponentPublicMethods(component,methods): binds the named public methods
\* as reads/actions of that component, forwarding each call's declared arguments.
\* This is function binding; each public method owns its input/return/failure algorithm.
\* These platform bindings retain no Project mutation input or display-state authority.
CONSTANT NoValue
SettingsOverlayNames == {"layout","label","caption","print"}
ComponentOwners == [
  FastFigureToolbar |-> "overlay toggle / selected target / explicit whole rendering",
  FastFigureDataActions |-> "asset import / slot reset/delete / ordinary empty CSV",
  FastFigureImageEditor |-> "image preview/settings",
  FastFigureProjectDataTree |-> "VFS projection / selection / move / drop / menu",
  FastFigureProjectActions |-> "project name / FFPX",
  FastFigureGraphDataEditor |-> "CSV/header/object",
  FastFigureGraphLayoutEditor |-> "chart title/global/axis",
  FastFigureGraphPaletteActions |-> "object colors",
  FastFigureGraphFileActions |-> "FFSX/Plotly / editable flag",
  FastFigurePaletteActions |-> "UI palette draft/apply/reset",
  FastFigureStatusDebug |-> "status/debug telemetry/log",
  FastFigureReadmeOverlay |-> "README modal",
  FastFigureLabelOverlay |-> "label settings / position",
  FastFigureCaptionOverlay |-> "global or selected-slot caption / explicit insert",
  FastFigurePrintOverlay |-> "raster form / save/capture",
  FastFigureLayoutOverlay |-> "grid/style/zoom / local merge/split selection",
  FastFigureDashboardFileDrop |-> "one continuous external drop channel",
  FastFigureShell |-> "AppShell / sidebar / composition"]

(* --algorithm FrontendMantineUi
variables result = NoValue,
  collisionModel = NoValue, collisionResolver = NoValue,
  layoutSelectedSlotIds = {}, settingsOverlayHeight = NoValue,
  folding = [],
  sidebarGeometry = InitialSessionSidebarGeometry(),
  dropMounted = FALSE, dropAllowed = FALSE, dropReceiver = NoValue;

procedure readProjectAssetDisplay()
variables nodes = NoValue, layout = NoValue;
begin
OfficialReadsInOneSynchronousDisplay:
  nodes := InvokePublicApi("assets.readTree",[]);
  layout := InvokePublicApi("layout.readState",[]);
  result := [nodes |-> nodes,slotRows |-> layout.visibleSlots];
  \* No await/callback/command between reads, retained mirror or flat public tree contract.
  \* Canonical node kind/asset supplies directory and CSV/image UI candidates.
  \* Slot rows consume Backend assetDisplay, including empty and embedded rows.
  return;
end procedure;

procedure readAssetRowDisplay(node)
variables target = NoValue, rows = NoValue, header = NoValue;
begin
OfficialReferenceCountNotSlotDisplayDeduplication:
  target := InvokePublicApi("assets.readDeletionTarget",[path |-> node.path]);
  if node.kind = "csv" then
    header := TryScalarNumber(FieldOrNoValue(node.asset,"headerLines"));
    rows := Maximum(0,Len(node.asset.rows) - (IF header.valid THEN header.value ELSE 0));
  end if;
  result := [referenceCount |-> IF target = NoValue THEN 0 ELSE target.referenceCount,rowCount |-> rows];
  \* Display arithmetic only. No new parser, collection ownership or mutation.
  return;
end procedure;

\* UiCommand instances are component-owned references. Callback invocation/await
\* captures {threw,failure,value}; it calls once synchronously before awaiting.
\* BoundProcedure captures only declared arguments; it is function binding.
procedure UiCommand_create(readTarget,readValue,prepare,invoke,stepSize)
variables command = NoValue;
begin
CreateOwnedControl:
  command := NewUiCommandInstance();
  command.readTarget := readTarget; command.readValue := readValue;
  command.prepare := prepare; command.invoke := invoke; command.stepSize := stepSize;
  command.text := ""; command.editTarget := NoValue;
  command.editing := FALSE; command.composing := FALSE;
  command.running := FALSE; command.active := TRUE;
  result := command; return;
end procedure;

procedure UiCommand_input(command,text,composing)
variables target = NoValue;
begin
RetainLexicalInput:
  if ~command.active \/ command.running then result := command.text; return; end if;
  target := InvokeCallback(command.readTarget,<<>>);
  if target = NoValue then call UiCommand_cancel(command); result := command.text; return; end if;
  if command.editing /\ command.editTarget # target then call UiCommand_cancel(command); end if;
  if ~command.editing then command.editTarget := target; command.editing := TRUE; end if;
  command.text := text; command.composing := composing;
  PreserveWidgetCursorSelectionAndRawText(command,text);
  result := command.text; return;
end procedure;

procedure UiCommand_refresh(command,target)
variables current = NoValue;
begin
RefreshOnlySameLiveTarget:
  if command.active /\ command.readValue # NoValue
     /\ InvokeCallback(command.readTarget,<<>>) = target then
    current := InvokeCallback(command.readValue,<<target>>);
    command.text := DisplayTextForOfficialValue(current);
    DisplayOfficialControlValue(command,current);
  end if;
  result := current; return;
end procedure;

procedure UiCommand_cancel(command)
variables target = NoValue, current = "";
begin
CancelPendingEdit:
  command.editing := FALSE; command.composing := FALSE;
  command.editTarget := NoValue; command.text := "";
  if command.active then
    target := InvokeCallback(command.readTarget,<<>>);
    if target # NoValue /\ command.readValue # NoValue then
      current := InvokeCallback(command.readValue,<<target>>);
    end if;
    command.text := DisplayTextForOfficialValue(current);
    if command.readValue # NoValue then DisplayOfficialControlValue(command,current); end if;
  end if;
  \* In-flight invocation and its running flag are settled by that invocation.
  result := current; return;
end procedure;

procedure UiCommand_send(command,value,target)
variables state = NoValue, currentTarget = NoValue, completion = NoValue, refresh = NoValue;
begin
CurrentReadyTarget:
  if ~command.active \/ command.running then result := NoValue; return; end if;
  call ApplicationInterface_readState(); state := result;
  if state.lifecycle # "ready" then result := NoValue; return; end if;
  currentTarget := InvokeCallback(command.readTarget,<<>>);
  if currentTarget = NoValue \/ (target # NoValue /\ currentTarget # target) then
    result := NoValue; return;
  end if;
  if command.readValue # NoValue then
    if InvokeCallback(command.readValue,<<currentTarget>>) = value then
      call UiCommand_refresh(command,currentTarget); result := NoValue; return;
    end if;
  end if;
OneInvocationAndEveryExitCleanup:
  command.running := TRUE;
  completion := InvokeAndAwaitCallbackOnceCaptured(command.invoke,<<currentTarget,value>>);
  command.running := FALSE;
  \* Invocation enters the existing API synchronously; its lifecycle remains API-owned.
  refresh := CaptureOriginalFailureOfProcedure(UiCommand_refresh,<<command,currentTarget>>);
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  if refresh.threw then PropagateOriginalFailure(refresh.failure); end if;
  result := completion.value; return;
end procedure;

procedure UiCommand_commit(command)
variables state = NoValue, target = NoValue, current = NoValue, prepared = NoValue;
begin
OneCompletedEdit:
  if ~command.active \/ ~command.editing \/ command.running \/ command.composing then
    result := NoValue; return;
  end if;
  call ApplicationInterface_readState(); state := result;
  target := command.editTarget;
  if state.lifecycle # "ready" \/ target = NoValue
     \/ InvokeCallback(command.readTarget,<<>>) # target then
    call UiCommand_cancel(command); result := NoValue; return;
  end if;
  current := InvokeCallback(command.readValue,<<target>>);
  prepared := InvokeCallback(command.prepare,<<command.text,current>>);
  if ~prepared[1] then
    call UiCommand_cancel(command); ShowInvalidNumericInputNotice(command);
    result := NoValue; return;
  end if;
  command.editing := FALSE; command.composing := FALSE;
  \* Enter clears editing before send; subsequent blur cannot send this edit again.
  call UiCommand_send(command,prepared[2],target);
  \* Same-target official refresh is performed by send; retain the API result/failure.
  ReportRequestedAndAppliedValueWhenCorrected(command,target,prepared[2]);
  return;
end procedure;

procedure UiCommand_step(command,direction)
variables target = NoValue, current = NoValue, parsed = NoValue, value = NoValue;
begin
OneWidgetIncrement:
  if ~command.active \/ command.running \/ command.composing \/ command.stepSize = NoValue then
    result := NoValue; return;
  end if;
  target := InvokeCallback(command.readTarget,<<>>);
  if target = NoValue then call UiCommand_cancel(command); result := NoValue; return; end if;
  if command.editing /\ command.editTarget # target then call UiCommand_cancel(command); end if;
  current := InvokeCallback(command.readValue,<<target>>);
  if command.editing then
    call prepareNumericInput(command.text,current,FALSE,NoValue); parsed := result;
    if parsed[1] then current := parsed[2]; end if;
  end if;
  if ~IsFiniteNumber(current) then current := 0; end if;
  value := IF direction = "increase" THEN current + command.stepSize ELSE current - command.stepSize;
  call UiCommand_input(command,CompleteDecimalText(value),FALSE);
  call UiCommand_commit(command);
  \* Widget onChange is suppressed for this same step; each real repeat is a new step.
  return;
end procedure;

procedure UiCommand_dispose(command)
begin
EndThisControlLifetime:
  call UiCommand_cancel(command);
  command.active := FALSE;
  RemoveOnlyThisControlEventsAndSubscriptions(command);
  result := NoValue; return;
end procedure;

procedure prepareNumericInput(text,current,allowEmpty,emptyValue)
variables trimmed = TrimWhitespace(text), value = NoValue;
begin
EmptyAndCompleteDecimal:
  if trimmed = "" then
    result := IF allowEmpty THEN <<TRUE,emptyValue>> ELSE <<FALSE,current>>; return;
  end if;
  \* Full-string lexical match: optional sign; digits with at most one dot and at
  \* least one digit; optional e/E plus optional sign plus one or more digits.
  if ~FullStringMatches(trimmed,"[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?") then
    result := <<FALSE,current>>; return;
  end if;
  value := ParseCompleteDecimal(trimmed);
  result := IF IsFiniteNumber(value) THEN <<TRUE,value>> ELSE <<FALSE,current>>;
  \* Field-specific range/integer rules stay in the existing API/Backend owner.
  return;
end procedure;

procedure changeLayoutGridDimension(dimension,value)
variables current = NoValue, rows = NoValue, cols = NoValue, range = NoValue;
begin
ConfirmedFiniteValueAndCurrentCompanion:
  Require(dimension \in {"rows","cols"} /\ IsFiniteNumber(value));
  current := InvokePublicApi("layout.readState",[]);
  rows := current.gridRows; cols := current.gridCols;
  range := IF dimension = "rows" THEN current.gridLimits.gridRows ELSE current.gridLimits.gridCols;
  value := Maximum(range[1],Minimum(range[2],value));
  if dimension = "rows" then rows := value; else cols := value; end if;
  result := InvokePublicApi("layout.setGrid",[rows |-> rows,cols |-> cols]);
  if result # FALSE then
    layoutSelectedSlotIds := {}; DisplayOfficialLayout(result);
  end if;
  \* Synchronous read/dispatch, unchanged Backend integer/validation/commit.
  \* Rejection/exception preserves the previous value and local selection.
  return;
end procedure;

procedure handleDebugToggle()
variables enabled = FALSE;
begin
OwnerReadNotDisplayProjection:
  call readDebugEnabled(); enabled := result;
  call setDebugEnabled(~enabled);
  \* Same synchronous click, no callback/await between read and explicit bool setter.
  \* Setter alone writes owner then publishes; UI only displays telemetry.
  return;
end procedure;

procedure subscribeAppState(onStoreChange)
begin
DirectFsmExternalStore:
  call ApplicationInterface_subscribe(onStoreChange);
  \* Return unsubscribe. No React project store or subscription-driven Project write.
  return;
end procedure;

procedure getAppStateSnapshot()
begin
CurrentRevisionNumber:
  call ApplicationInterface_readState(); result := result.revision;
  return;
end procedure;

procedure useAppState()
begin
RevisionSubscriptionAndFreshRenderRead:
  \* React hook plumbing receives these defined procedure references.
  ReactUseSyncExternalStore(subscribeAppState,getAppStateSnapshot);
  call ApplicationInterface_readState();
  return;
end procedure;

procedure addSelectedGraphObject()
variables state = NoValue, context = NoValue, slotId = NoValue;
begin
CurrentReadySlotAndCsv:
  call ApplicationInterface_readState(); state := result;
  slotId := state.selectedSlotId;
  if state.lifecycle # "ready" \/ slotId = NoValue then result := NoValue; return; end if;
  context := InvokePublicApi("graphs.readData",[]);
  if context.currentCsv = NoValue then result := NoValue; return; end if;
  if context.chart # NoValue then
    if context.chart.editor.editable = FALSE then result := NoValue; return; end if;
  end if;
  result := InvokePublicApi("graphs.addObject",[slotId |-> slotId,csvId |-> context.currentCsv.id]);
  return;
end procedure;

procedure importSelectedSlotFile(file)
variables state = NoValue, slotId = NoValue;
begin
CaptureFileReceiptTarget:
  if file = NoValue then result := NoValue; return; end if;
  call ApplicationInterface_readState(); state := result;
  slotId := state.selectedSlotId;
  if slotId = NoValue then result := NoValue; return; end if;
  result := InvokePublicApi("graphs.importFile",[slotId |-> slotId,file |-> file]);
  \* The public import lifecycle owns the await; slotId remains this operation's input.
  return;
end procedure;

procedure setSelectedGraphEditable(editable)
variables state = NoValue, context = NoValue, slotId = NoValue;
begin
CurrentSlotAndOwningChart:
  call ApplicationInterface_readState(); state := result;
  slotId := state.selectedSlotId;
  if slotId = NoValue then result := NoValue; return; end if;
  context := InvokePublicApi("graphs.readData",[]);
  if context.chart = NoValue then result := NoValue; return; end if;
  result := InvokePublicApi("graphs.setEditable",[slotId |-> slotId,chartId |-> context.chart.id,editable |-> editable]);
  return;
end procedure;

procedure updateSelectedGraphLayout(values)
variables state = NoValue, context = NoValue, slotId = NoValue;
begin
CurrentReadySlotAndLayoutInput:
  call ApplicationInterface_readState(); state := result;
  slotId := state.selectedSlotId;
  if state.lifecycle # "ready" \/ slotId = NoValue then result := NoValue; return; end if;
  context := InvokePublicApi("graphs.readData",[]);
  if context.chart = NoValue then result := NoValue; return; end if;
  result := InvokePublicApi("graphs.updateLayout",[slotId |-> slotId,chartId |-> context.chart.id,values |-> values]);
  return;
end procedure;

procedure useProjectAssetImportCollision()
begin
ReturnLifetimeScopedPair:
  result := [choosePlan |-> "ChooseImportCollision",modal |-> CurrentCollisionModal(collisionModel,collisionResolver)];
  return;
end procedure;

procedure ChooseImportCollision(file,directory,reservedPaths)
variables model = NoValue, completion = NoValue;
begin
ReadThroughPublicApi:
  model := InvokePublicApi("assets.collisionModel",[file |-> file,directory |-> directory,reservedPaths |-> reservedPaths]);
NoModalWhenAvailable:
  if model.mode = "available" then
    result := InvokePublicApi("assets.resolveImportPlan",[model |-> model,choice |-> "available",reservedPaths |-> reservedPaths]);
    return;
  end if;
OneResolverForThisModalLifetime:
  collisionModel := model;
  collisionResolver := NewModalLifetimePromiseResolver();
  ShowCollisionModal(model,collisionResolver);
  completion := AwaitExplicitChoiceOrModalClose(collisionResolver);
  collisionModel := NoValue;
  collisionResolver := NoValue;
CancelHasNoPlanOrMutation:
  if ~completion.hasExplicitChoice then result := NoValue; return; end if;
  \* Escape/outside/close/unmount all use this same no-choice completion.
  result := InvokePublicApi("assets.resolveImportPlan",[model |-> model,choice |-> completion.choice,reservedPaths |-> reservedPaths]);
  return;
end procedure;

procedure MantineUi_runLifecycleTask(lifecycle,eventName,task)
begin
ApplicationOwnsCallbackAndTransitions:
  call ApplicationAdapter_runLifecycleTask(lifecycle,eventName,task);
  \* Optional UI error telemetry does not create rollback/retry authority.
  return;
end procedure;

procedure LinearSrgbChannel(c)
begin
DeclaredTransferFunction:
  if c <= 0.04045 then result := c / 12.92;
  else result := ((c + 0.055) / 1.055) ^ 2.4; end if;
  return;
end procedure;

\* Private display expansion of FastFigureApp step 5, called on each editor render.
procedure ReadGraphObjectOptions()
variables editor = NoValue, options = <<>>, i = 1, object = NoValue,
          title = "", identity = "", label = "";
begin
SameOfficialChartAndObjects:
  editor := InvokePublicApi("graphs.readData",[]);
  if editor.chart = NoValue then result := options; return; end if;
  title := editor.chart.editor.title;
  while i <= Len(editor.objects) do
    object := editor.objects[i];
    identity := IF object.legendName # "" THEN object.legendName ELSE object.x \o " · " \o object.y;
    label := Text(i) \o ". " \o (IF title = "" THEN identity ELSE title \o " — " \o identity);
    options := Append(options,[value |-> i-1,label |-> label,title |-> title,identity |-> identity]);
    i := i + 1;
  end while;
  result := options;
  \* Rendering wraps title, preserves a readable identity part and exposes the full accessible name.
  \* No stored display field, trace legend change or replacement selection value.
  return;
end procedure;

\* Private UI-local interaction expansion of FastFigureApp step 6.
procedure ToggleUiFold(key)
begin
OneGroupOnly:
  Require(key \in DOMAIN folding);
  if folding[key] then MoveContainedFocusToGroupHeadingIfNeeded(key); end if;
  folding[key] := ~folding[key];
  UpdateGroupExpandedAndContentLink(key,folding[key]);
  result := folding[key]; return;
end procedure;

\* Component-local expansions of Source FastFigureApp 14-16.
procedure ReadNumericControl(group,field,axis)
variables state = NoValue, view = NoValue, target = NoValue, value = NoValue;
begin
ReadOfficialCurrentField:
  call ApplicationInterface_readState(); state := result;
  if group = "image" then
    view := InvokePublicApi("images.readEditor",[]);
    if state.selectedSlotId # NoValue /\ view # NoValue then
      target := <<group,state.selectedSlotId,view.imageId,field>>; value := view.settings[field];
    end if;
  elsif group \in {"csv","object"} then
    view := InvokePublicApi("graphs.readData",[]);
    if group = "csv" /\ view.currentCsv # NoValue then
      target := <<group,view.currentCsv.id,field>>; value := view.currentCsv.headerLines;
    elsif group = "object" /\ view.chart # NoValue /\ view.selectedIndex # NoValue then
      if view.chart.editor.editable then
        target := <<group,state.selectedSlotId,view.chart.id,view.selectedIndex,field>>;
        value := view.objects[view.selectedIndex+1][field];
      end if;
    end if;
  elsif group \in {"axis","global"} then
    view := InvokePublicApi("graphs.readLayout",[]);
    if state.selectedSlotId # NoValue /\ view # NoValue then
      target := <<group,state.selectedSlotId,view.chartId,axis,field>>;
      value := IF group = "axis" THEN view.axes[axis][field] ELSE view.globalSettings[field];
    end if;
  elsif group = "labels" then
    view := InvokePublicApi("labels.readState",[]);
    target := <<group,field>>; value := view.settings[field];
  elsif group = "captions" then
    view := InvokePublicApi("captions.readGlobal",[]);
    target := <<group,"global",field>>; value := view.settings[field];
  elsif group = "print" then
    view := InvokePublicApi("print.readSettings",[]);
    target := <<group,field>>; value := view[field];
  elsif group = "layout" then
    view := InvokePublicApi("layout.readState",[]); target := <<group,field>>;
    if field = "rows" then value := view.gridRows;
    elsif field = "cols" then value := view.gridCols;
    elsif field = "zoom" then value := view.zoom;
    else value := view.slotStyle[field]; end if;
  end if;
  result := [target |-> target,value |-> value]; return;
end procedure;

procedure NumericControlTarget(group,field,axis)
begin
CurrentIdentityTuple:
  call ReadNumericControl(group,field,axis); result := result.target; return;
end procedure;

procedure NumericControlValue(group,field,axis,target)
variables current = NoValue;
begin
SameFieldCurrentValue:
  call ReadNumericControl(group,field,axis); current := result;
  result := IF current.target = target THEN current.value ELSE NoValue; return;
end procedure;

procedure PrepareControlNumeric(group,field,text,current)
variables allowEmpty = FALSE, emptyValue = "";
begin
ExistingEmptyMeaning:
  allowEmpty := (group = "axis" /\ field \in {"min","max","tick"})
             \/ (group = "global" /\ field \in {"titleFontSize","legendFontSize"})
             \/ (group = "print" /\ field = "height");
  if group = "print" /\ field = "height" then emptyValue := NoValue; end if;
  call prepareNumericInput(text,current,allowEmpty,emptyValue); return;
end procedure;

procedure InvokeNumericControl(group,field,axis,target,value)
variables patch = [], current = NoValue, axes = [];
begin
OnlyNewFieldAndExplicitIdentity:
  patch[field] := value;
  if group = "image" then
    result := InvokePublicApi("images.setSettings",[slotId |-> target[2],values |-> patch]);
  elsif group = "csv" then
    result := InvokePublicApi("graphs.setHeaderLines",[csvId |-> target[2],headerLines |-> value]);
  elsif group = "object" then
    result := InvokePublicApi("graphs.setObjectValues",[chartId |-> target[3],index |-> target[4],values |-> patch]);
  elsif group = "axis" then
    axes[axis] := patch; call updateSelectedGraphLayout([globalSettings |-> [axes |-> axes]]);
  elsif group = "global" then call updateSelectedGraphLayout([globalSettings |-> patch]);
  elsif group = "labels" then
    if field = "fontSize" then result := InvokePublicApi("labels.setSettings",[values |-> patch]);
    else
      current := InvokePublicApi("labels.readState",[]);
      result := InvokePublicApi("labels.setPosition",[x |-> IF field = "x" THEN value ELSE current.settings.x,
        y |-> IF field = "y" THEN value ELSE current.settings.y]);
    end if;
  elsif group = "captions" then result := InvokePublicApi("captions.setSettings",[values |-> patch]);
  elsif group = "print" then
    if field = "height" then
      patch := [height |-> value,heightMode |-> IF value = NoValue THEN "auto" ELSE "explicit"];
    end if;
    result := InvokePublicApi("print.setSettings",[values |-> patch]);
  elsif group = "layout" then
    if field \in {"rows","cols"} then call changeLayoutGridDimension(field,value);
    elsif field = "zoom" then result := InvokePublicApi("layout.setZoom",[value |-> value]);
    else result := InvokePublicApi("layout.setStyle",[values |-> patch]); end if;
  end if;
  \* Preserve existing owner rules: imageSettings limits; normalizeCsvHeaderLines;
  \* GRAPH_STYLE_LIMITS; normalizeAxisSettings/divide=0 -> 1; normalizeGlobalSettings;
  \* labels/captions/export/layout limits and integerization; FSM zoom 50..200.
  return;
end procedure;

procedure BindNumericField(group,field,axis)
variables command = NoValue, control = NoValue;
begin
OneInstancePerMountedField:
  control := CurrentComponentNumericControl(group,field,axis);
  if control = NoValue then result := NoValue; return; end if;
  command := ExistingUiCommandOfControlOrNone(control);
  if command = NoValue then
    call UiCommand_create(BoundProcedure(NumericControlTarget,<<group,field,axis>>),
      BoundProcedure(NumericControlValue,<<group,field,axis>>),
      BoundProcedure(PrepareControlNumeric,<<group,field>>),
      BoundProcedure(InvokeNumericControl,<<group,field,axis>>),ExistingWidgetStep(control));
    command := result; AttachUiCommandToControl(control,command);
  end if;
  BindRawInputAndCompositionTo(control,command,UiCommand_input);
  BindEnterAndBlurTo(control,command,UiCommand_commit);
  BindEscapeTo(control,command,UiCommand_cancel);
  BindIncrementDecrementAndArrowTo(control,command,UiCommand_step);
  DisableWidgetBlurClampLeadingZeroRewriteAndDuplicateChange(control);
  KeepEditingTextCursorSelectionAndFocusOnOrdinaryRender(control,command);
  BindTargetChangeLifecycleNotReadyAndOverlayCloseTo(control,command,UiCommand_cancel);
  BindUnmountTo(control,command,UiCommand_dispose);
  \* Composition Enter stays with IME; later confirmation commits. Label pointer
  \* positioning retains the existing direct interaction path.
  result := command; return;
end procedure;

procedure BindAllNumericFields()
variables groups = <<"image","csv","object","axis","global","labels","captions","print","layout">>,
  fields = <<>>, axes = <<>>, gi = 1, fi = 1, ai = 1, group = "";
begin
ComponentLocalBindings:
  while gi <= Len(groups) do
    group := groups[gi]; axes := <<NoValue>>;
    if group = "image" then fields := <<"scale","x","y">>;
    elsif group = "csv" then fields := <<"headerLines">>;
    elsif group = "object" then fields := <<"lineWidth","markerSize","barOpacity","barLineWidth">>;
    elsif group = "axis" then
      fields := <<"min","max","tick","divide","titleSize","fontSize","lineWidth">>;
      axes := <<"xBottom","xTop","yLeft","yRight">>;
    elsif group = "global" then fields := <<"titleFontSize","legendFontSize">>;
    elsif group = "labels" then fields := <<"fontSize","x","y">>;
    elsif group = "captions" then fields := <<"fontSize","lineHeight">>;
    elsif group = "print" then fields := <<"dpi","width","height">>;
    else fields := <<"rows","cols","referenceWidth","gap","outerMargin","radius","aspect","zoom">>; end if;
    ai := 1;
    while ai <= Len(axes) do
      fi := 1;
      while fi <= Len(fields) do
        call BindNumericField(group,fields[fi],axes[ai]); fi := fi + 1;
      end while;
      ai := ai + 1;
    end while;
    gi := gi + 1;
  end while;
  \* Expansion of 54 Source controls at their component locations. The local
  \* iteration is notation, with no persistent command/range registration.
  result := NoValue; return;
end procedure;

procedure UiCommand_bindAction(control,readTarget,invoke)
variables command = NoValue;
begin
ExistingActionCallbacks:
  command := ExistingUiCommandOfControlOrNone(control);
  if command = NoValue then
    call UiCommand_create(readTarget,NoValue,NoValue,invoke,NoValue);
    command := result; AttachUiCommandToControl(control,command);
  end if;
  command.readTarget := readTarget; command.invoke := invoke;
  \* Re-render updates callbacks while retaining the same local command instance.
  BindActionEventToSend(control,command,UiCommand_send);
  BindTargetChangeLifecycleNotReadyAndOverlayCloseTo(control,command,UiCommand_cancel);
  BindUnmountTo(control,command,UiCommand_dispose);
  \* Source component 3-10 supplies its official current-target/enabled callback
  \* and existing helper/API argument callback; this binding forwards them.
  \* File receipt retains user activation and the existing target capture time.
  result := command; return;
end procedure;

procedure FastFigureApp()
variables palette = NoValue, shades = <<>>, i = 1, channels = <<>>, linear = <<>>,
          luminance = 0, contrast = "", theme = NoValue, css = NoValue, tree = NoValue,
          controls = <<"Button","ActionIcon","Input","Select","NumberInput","ColorInput">>,
          groups = <<"global","objects","x","y","xBottom","xTop","yLeft","yRight","objectType","uiColors","debug">>;
begin
CurrentReadNotDraftOrMirror:
  palette := InvokePublicApi("appearance.readPalette",[]);
  while i <= 10 do shades := Append(shades,palette.uiColor); i := i + 1; end while;
ContrastFromCurrentUiColor:
  channels := HexChannelsDividedBy255(palette.uiColor); i := 1;
  while i <= 3 do call LinearSrgbChannel(channels[i]); linear := Append(linear,result); i := i + 1; end while;
  luminance := 0.2126 * linear[1] + 0.7152 * linear[2] + 0.0722 * linear[3];
  contrast := IF luminance > 0.179 THEN "#000000" ELSE "#FFFFFF";
ThemeAndCssProjection:
  theme := ExistingFastFigureCommonTheme();
  i := 1;
  while i <= Len(controls) do
    UseCommonRoleHeightFontPaddingRadiusInThemeAndDefaultProps(theme,controls[i]);
    RemoveSameRoleInstanceSizeOverrides(controls[i]); i := i + 1;
  end while;
  ApplyCommonInputWidthsRowGapAndInputBottomAlignment(
    <<"graphData","objects","axes","layout","labels","captions","print","assets">>);
  WrapEachInputTogetherWithItsLabelWhenRowIsNarrow();
  PreserveTextRendererShapeAndResizeHandleDimensions();
  ApplyExistingModalCenteredEscapeOutsideDefaultsAndCommonSettingsMaximum(theme);
  i := 1;
  while i <= Len(groups) do
    if ~HasField(folding,groups[i]) then folding[groups[i]] := groups[i] \in {"global","objects"}; end if;
    BindKeyboardAccessibleGroupHeading(groups[i],folding[groups[i]],ToggleUiFold);
    i := i + 1;
  end while;
  ComposeFoldHierarchy([global |-> <<"x","y">>,x |-> <<"xBottom","xTop">>,
    y |-> <<"yLeft","yRight">>,objects |-> <<"objectType">>]);
  BindFourAxisContentsToTheirExistingGlobalSettingsFields();
  KeepObjectXYSideSelectorsInsideObjectSettings();
  \* uiColors/debug are independent groups. Folding never changes project, selection or debugEnabled.
  theme.colors.ffui := shades; theme.primaryColor := "ffui"; theme.colorScheme := "light";
  css := [body |-> palette.uiBackgroundColor,text |-> palette.fontColor,
    defaultColor |-> palette.fontColor,primaryLightColor |-> palette.fontColor,
    default |-> palette.uiSurfaceColor,defaultBorder |-> palette.uiColor,
    primaryFilled |-> palette.uiColor,dimmed |-> palette.uiMutedColor,
    placeholder |-> palette.uiSubtleColor,disabled |-> palette.uiDisabledBgColor,
    disabledBorder |-> palette.uiDisabledBgColor,disabledColor |-> palette.uiDisabledTextColor,
    defaultHover |-> SrgbMix(palette.uiColor,0.12,palette.uiSurfaceColor),
    filledHover |-> SrgbMix(palette.uiColor,0.75,"#64748B"),
    primaryLight |-> SrgbMix(palette.uiColor,0.18,"transparent"),
    primaryLightHover |-> SrgbMix(palette.uiColor,0.24,"transparent"),primaryContrast |-> contrast];
  AliasFfuiFilledFilledHoverLightLightHoverLightColorContrastToPrimaryVariables(css);
  ReplaceOnlyBlackAlphaThemeShadowColorsWithSameAlphaUiShadowMix(theme,palette.uiShadowColor);
  \* Preserve shadow geometry. Graph paperColor != UI surface/background.
OneExistingRoot:
  BindNumericFieldCreationAndRenderHook(BindAllNumericFields);
  call FastFigureShell(); tree := result;
  \* The hook runs at each component's control creation/render, preserving its
  \* existing command instance; it is not a post-mount global control registry.
  result := RenderMantineProviderToExistingReactRoot(theme,css,tree);
  return;
end procedure;

procedure FastFigureShell()
begin
NoProjectStoreInShell:
  ApplySessionSidebarGeometryCss(sidebarGeometry);
  \* Procedure references bind component events to the current-input algorithms above.
  BindComponentEvent("FastFigureGraphDataEditor","addObject",addSelectedGraphObject);
  BindComponentEvent("FastFigureGraphFileActions","fileReceived",importSelectedSlotFile);
  BindComponentEvent("FastFigureGraphFileActions","editableChanged",setSelectedGraphEditable);
  BindComponentEvent("FastFigureGraphLayoutEditor","settingsChanged",updateSelectedGraphLayout);
  BindComponentRenderReadFor("FastFigureGraphDataEditor","objectOptions",ReadGraphObjectOptions);
  BindComponentEvent("FastFigureLayoutOverlay","previewWidthMeasured",RenderLayoutPreview);
  BindWorkspaceSizeChangeToSuppliedTransformAction(transformWorkspace);
  \* Size/sidebar changes only read structure and transform existing content pixels.
  BindComponentRenderRead(useAppState);
  BindComponentRenderReadFor("FastFigureProjectDataTree","assetDisplay",readProjectAssetDisplay);
  BindComponentEvent("FastFigureStatusDebug","debugClicked",handleDebugToggle);
  BindComponentPublicMethods("FastFigureToolbar",<<"slots.readSelected","workspace.render">>);
  PlaceExistingStandardButtonImmediatelyLeftOfPrint("FastFigureToolbar","렌더링","workspace.render");
  BindWholeRenderButtonReadyDisabledRunningAndKeyboardStateThroughExistingUiCommand();
  \* Same Button/theme/height/padding as neighbouring controls; no local style variant.
  BindComponentPublicMethods("FastFigureDataActions",<<"assets.importFiles","slots.reset","assets.delete">>);
  BindComponentPublicMethods("FastFigureImageEditor",<<"images.readEditor","images.setSettings","images.insertEmpty">>);
  BindComponentPublicMethods("FastFigureProjectDataTree",<<"assets.selectCsv","assets.selectImage","assets.selectDirectory",
    "assets.planMove","assets.move","assets.createDirectory","assets.delete","assets.emptyTrash",
    "assets.download","assets.draggableAsset","assets.connectToSlot">>);
  BindComponentPublicMethods("FastFigureProjectActions",<<"project.readName","project.setName","project.importFile","project.exportFile">>);
  BindComponentPublicMethods("FastFigureGraphDataEditor",<<"graphs.readData","graphs.selectCsv","graphs.setHeaderLines",
    "graphs.selectObject","graphs.setObjectValues","graphs.moveObject","graphs.deleteObject","assets.createEmptyCsv">>);
  BindComponentPublicMethods("FastFigureGraphLayoutEditor",<<"graphs.readLayout">>);
  BindComponentPublicMethods("FastFigureGraphPaletteActions",<<"graphs.readPalette","graphs.applyPalette">>);
  BindComponentPublicMethods("FastFigureGraphFileActions",<<"graphs.exportFfsx","graphs.exportPlotlyJson">>);
  BindComponentPublicMethods("FastFigurePaletteActions",<<"appearance.readPalette","appearance.setPalette","appearance.resetPalette">>);
  BindComponentPublicMethods("FastFigureLabelOverlay",<<"labels.readState","labels.setEnabled","labels.setSettings",
    "labels.setPosition","labels.resetPosition","labels.finishPositionInteraction">>);
  BindComponentPublicMethods("FastFigureCaptionOverlay",<<"captions.readGlobal","captions.readSlot","captions.setGlobalText",
    "captions.setSlotText","captions.setName","captions.setNameBold","captions.setSettings","captions.setEnabled","captions.insertSlotCaptions">>);
  BindComponentPublicMethods("FastFigurePrintOverlay",<<"print.readSettings","print.setSettings","print.save","print.capture">>);
  BindComponentPublicMethods("FastFigureLayoutOverlay",<<"layout.readState","layout.setStyle","layout.setZoom",
    "layout.resetZoom","layout.mergeSlots","layout.splitSlots">>);
  \* Bind each declared command control through UiCommand after its existing
  \* target/invoke callbacks above are supplied. Public reads remain direct;
  \* folds, collision responses and Modal-local controls keep UI-only handlers.
  BindDeclaredComponentActionControls(ComponentOwners,UiCommand_bindAction);
  result := ComposeExistingAppShellHeaderNavbarMainAndOverlayComponents(ComponentOwners);
  return;
end procedure;

procedure ResizeSidebar(newGeometry)
begin
SessionGeometryThenReusePixels:
  sidebarGeometry := NormalizeSessionSidebarGeometry(newGeometry);
  ApplySessionSidebarGeometryCss(sidebarGeometry);
  call transformWorkspace();
  result := NoValue;
  return;
end procedure;

procedure ConfigureSettingsOverlay(overlay)
begin
OneSharedMaximumNotFourIndependentWidths:
  if overlay \in SettingsOverlayNames then
    SetOverlayMaximum(overlay,CommonFastFigureSettingsMaximumLargerThanMantineMaximumToken());
    InstallCommonBottomVerticalResize(overlay,"ResizeSettingsOverlay");
  end if;
  \* Concrete CSS/token is lower-layer primitive. README does not auto-inherit.
  result := NoValue;
  return;
end procedure;

procedure ResizeSettingsOverlay(overlay,height)
begin
LocalHeightNotProjectOrPreviewWidthCommand:
  Require(overlay \in SettingsOverlayNames);
  settingsOverlayHeight := NormalizeComponentHeight(height);
  ApplyLocalOverlayHeight(overlay,settingsOverlayHeight);
  result := NoValue;
  return;
end procedure;

procedure LayoutSelectionInteraction(event)
begin
ControlConsumesSelectionBeforeParentClear:
  if IsLayoutSlotSurfaceClick(event) then
    layoutSelectedSlotIds := ToggleSetMember(layoutSelectedSlotIds,event.slotId);
    StopParentBackgroundClearForSameInteraction(event);
  elsif IsMergeOrSplitControl(event) then
    ConsumeCurrentSetForOfficialMergeOrSplit(layoutSelectedSlotIds,event);
    StopParentBackgroundClearForSameInteraction(event);
  elsif IsPreviewNonSlotBackgroundOrLayoutModalNonSlotContentBackground(event)
     \/ IsGridShapeChange(event) \/ IsLayoutOverlayClose(event) then
    layoutSelectedSlotIds := {};
  end if;
  result := layoutSelectedSlotIds;
  return;
end procedure;

procedure RenderLayoutPreview(previewHost,actualRenderedWidth)
variables layoutRead = NoValue, frameView = NoValue, i = 1, slot = NoValue, width = NoValue;
begin
CurrentPreviewQuery:
  width := IF PositiveFinite(actualRenderedWidth) THEN actualRenderedWidth ELSE NoValue;
  call readLayoutApiState(width); layoutRead := result;
  SetPreviewHostWidthAndOuterHorizontalScroll(previewHost,layoutRead.previewGeometry.width);
  call renderDashboardFrame(previewHost,
    [gridRows |-> layoutRead.gridRows,gridCols |-> layoutRead.gridCols,slotStyle |-> layoutRead.slotStyle],
    layoutRead.visibleSlots,layoutRead.previewGeometry);
  frameView := result;
LocalDecorationsAndInteraction:
  while i <= Len(layoutRead.visibleSlots) do
    slot := layoutRead.visibleSlots[i];
    ClearPreviousPreviewDecorations(frameView.slots[slot.id].decoration);
    if ~layoutRead.slotStyle.showBorders then
      DrawInnerDashedBoundary(frameView.slots[slot.id].decoration,slot,layoutRead.previewGeometry.radius);
    end if;
    DrawCoordinatesSelectionAndFocusWithoutChangingGeometry(frameView.slots[slot.id].decoration,
                                                           slot,slot.id \in layoutSelectedSlotIds);
    \* Selection/focus are distinct inner emphasis; current spans/radius are used.
    \* showBorders TRUE removes dashes without changing frame/content geometry.
    BindPreviewSlotClick(frameView.slots[slot.id].frame,slot.id,LayoutSelectionInteraction);
    i := i + 1;
  end while;
  InstallHostScopedPreviewCleanup(previewHost,frameView);
  \* Width/viewport changes requery. Modal vertical resize changes only local height.
  \* Cleanup releases only these frames/listeners; no actual dashboard generation/Plotly/decode effects.
  result := frameView;
  return;
end procedure;

procedure MaintainDashboardDropReceiver(mounted,allowed,currentCallback)
begin
ContinuousExactlyOneLogicalReceiver:
  dropMounted := mounted; dropAllowed := allowed;
  if dropMounted /\ dropAllowed then
    dropReceiver := InstallOrUpdateOneReceiverWithoutGapOrDuplicate(dropReceiver,currentCallback);
  else
    UninstallLogicalReceiver(dropReceiver); dropReceiver := NoValue;
  end if;
  \* Ordinary rerender/local update/callback replacement never creates a receive gap.
  result := NoValue;
  return;
end procedure;

procedure DashboardExternalFileDrop(file,slotId,choosePlan)
variables accepted = FALSE, completion = NoValue;
begin
PrepareSelectionOnly:
  accepted := InvokePublicApi("slots.prepareFileDrop",[slotId |-> slotId]);
  if ~accepted then result := FALSE; return; end if;
PublicImportLifecycleExactlyOnce:
  \* Public binding of assets.importToSlot owns MantineUi_runLifecycleTask.
  \* Do NOT wrap that binding in another MantineUi_runLifecycleTask.
  completion := CaptureOriginalFailureOfPublicApi("assets.importToSlot",[file |-> file,slotId |-> slotId,planImport |-> choosePlan]);
DropFinally:
  InvokePublicApi("slots.finishFileDrop",[]);
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  result := completion.value;
  return;
end procedure;

procedure ProjectTreeAction(action,node,target)
begin
TrashTreeSelectionNotSlotConnection:
  if action = "select" then
    result := InvokePublicApi("assets.select",[kind |-> node.kind,path |-> node.path]);
  elsif action = "move" then
    Require(~node.fixed);
    \* Trash descendants are valid move SOURCES if current VFS preconditions pass.
    result := InvokePublicApi("assets.planMove",[path |-> node.path,directory |-> target.path]);
    result := InvokePublicApi("assets.move",[plan |-> result,useUniqueName |-> ExplicitUserMoveChoice()]);
  elsif action = "connect-to-slot" then
    Require(node.kind \in {"csv","image"} /\ ~node.trashed);
    result := InvokePublicApi("assets.connectToSlot",[path |-> node.path,kind |-> node.kind,slotId |-> target.id]);
  end if;
  \* Selecting/starting drag is not implicit connection or original-location restore.
  return;
end procedure;

procedure InsertEmptyCsvFromGraphDataControl()
begin
OrdinaryCsvThenSelectNotCreateGraph:
  result := InvokePublicApi("assets.createEmptyCsv",[]);
  \* Graph creation only later via existing graphs.addObject command routes.
  return;
end procedure;

