---- MODULE FastFigureFrontendRendererR38 ----
EXTENDS Naturals, Reals, Sequences
\* Direct Source Script translation; Plan027 supplements current-authority display/input procedures.
\* No Backend/Application imports; supplied immutable inputs/actions only.
\* Local surface/instance/generation and status/debug variables are Source runtime
\* bookkeeping, never mirrored Project/FSM data or mutation candidates.
\* Await/captured original failure, measurement, DOM/Plotly/paint/bytes/resource
\* primitives are platform-neutral; semantic branch/order/cleanup is explicit below.
CONSTANT NoValue, DebugDataOmitted
(* --algorithm FrontendRenderer
variables result = NoValue,
  statusText = "", debugEnabled = FALSE, debugLines = <<>>, debugSequence = 0,
  statusDisplay = NoValue,
  workspaceLifetime = 0, slotOperations = [], graphInstances = [], imageSurfaces = [],
  dragSource = NoValue, suppressBookmarkClick = FALSE;

procedure syncDashboardCaption(captionState)
begin
SuppliedCaptionOnlyNoBackendQueryOrPersistentWrite:
  ApplyCaptionHostsFromSuppliedTextNameSettingsEnabled(captionState);
  result := NoValue; return;
end procedure;

procedure setStatusDisplay(display)
begin
ConnectOrDetach:
  statusDisplay := display;
  if display # NoValue then
    InvokeCallback(display.statusText,<<statusText>>);
    InvokeCallback(display.debugEnabled,<<debugEnabled>>);
    InvokeCallback(display.debugLines,<<DetachedReadOnlyArray(debugLines)>>);
  end if;
  result := NoValue; return;
end procedure;

procedure readDebugEnabled()
begin
RuntimeOwnerRead:
  result := debugEnabled;
  \* Pure current scalar read. No publish, mirror, Project access or callback.
  return;
end procedure;

procedure setDebugEnabled(enabled)
begin
SessionAuthorityThenDisplay:
  debugEnabled := IsBooleanTrue(enabled);
  if statusDisplay # NoValue then InvokeCallback(statusDisplay.debugEnabled,<<debugEnabled>>); end if;
  \* Display failures propagate without reverting the owner value.
  result := debugEnabled;
  return;
end procedure;

procedure status(message)
variables text = "";
begin
StatusNotTaskOutcome:
  text := IF message = NoValue THEN "" ELSE StringRepresentation(message);
  statusText := text;
  if statusDisplay # NoValue then InvokeCallback(statusDisplay.statusText,<<text>>); end if;
  result := text; return;
end procedure;

procedure debugLog(event,data,level)
variables detached = NoValue, serialization = NoValue, line = "";
begin
EnabledOnly:
  if ~debugEnabled then result := NoValue; return; end if;
  \* Omitted data is DebugDataOmitted, omitted level is "debug".
  if data = DebugDataOmitted then detached := [];
  elsif IsError(data) then detached := [name |-> ErrorName(data),message |-> ErrorMessage(data),stack |-> ErrorStack(data)];
  else
    serialization := CaptureJsonDetach(data);
    if serialization.failed then
      detached := [serializationError |-> ErrorMessage(serialization.error),value |-> StringRepresentation(data)];
    else detached := serialization.value; end if;
  end if;
AppendAndDisplayLog:
  debugSequence := debugSequence + 1;
  line := JoinWithSpaces(<<ZeroPadAtLeastFourDigits(debugSequence),CurrentUtcTimeHHmmssSSS(),
    Uppercase(level),event,SerializeJson(detached)>>);
  InvokeConsoleLevelOrDebug(level,<<"[chart-builder]",event,detached>>);
  debugLines := LastAtMost(Append(debugLines,line),500);
  if statusDisplay # NoValue then InvokeCallback(statusDisplay.debugLines,<<DetachedReadOnlyArray(debugLines)>>); end if;
  result := NoValue; return;
end procedure;

procedure clearDebugOutput()
begin
ClearWithoutDisabling:
  debugSequence := 0; debugLines := <<>>;
  if statusDisplay # NoValue then InvokeCallback(statusDisplay.debugLines,<<DetachedReadOnlyArray(debugLines)>>); end if;
  result := NoValue; return;
end procedure;

procedure saveDebugOutput()
variables data = NoValue, text = "", stamp = "", url = NoValue;
begin
ExportOwnerLog:
  auditApp("debug:save");
  data := [build |-> APP_BUILD,userAgent |-> CurrentUserAgent(),location |-> CurrentLocationHref()];
  call debugLog("debugLog:save",data,"debug");
  text := JoinWithNewlines(debugLines);
  url := CreateTemporaryUrl(Utf8TextPlainBlob(text));
  stamp := ReplaceColonAndDotWithHyphen(CurrentUtcIsoTimestamp());
  RequestDownload(url,Concat("chart-builder-debug-",stamp,".log"));
  RevokeUrlInDeferredZeroDelayCallback(url);
  result := NoValue; return;
end procedure;

procedure applyDashboardProjectionInvalidation(event,mutationResult,interfaceState,projectProjection)
begin
ReleaseOnlyInvalidOwnedAssociations:
  CleanupRemovedOrReplacedSurfaceOwners(graphInstances,imageSurfaces,projectProjection.visibleSlots);
  if projectProjection.operation = "workspace-structure" then
    call applyWorkspaceTransform(projectProjection,interfaceState); result := "STRUCTURE"; return;
  end if;
  if mutationResult.projectionEffect.pathOnly /\ ~mutationResult.projectionEffect.referencesRemoved then
    result := "NONE"; return;
  end if;
  if interfaceState.selectedSlotId = NoValue \/ projectProjection.targetSlot = NoValue then
    result := "NONE"; return;
  end if;
  if projectProjection.targetSlot.id # interfaceState.selectedSlotId then result := "NONE"; return; end if;
  call renderDashboard(projectProjection,interfaceState); result := "SELECTED_SLOT";
  \* Common UI CSS and official editor reads keep their existing paths.
  \* Other slots and the global caption wait for the explicit whole-content action.
  return;
end procedure;

procedure renderDashboardFrame(host,layout,visibleSlots,geometry)
variables frameView = [grid |-> host,slots |-> []], i = 1, slot = NoValue, refs = NoValue;
begin
SuppliedGridGeometry:
  SetHostBorderBoxWidthHeight(host,geometry.width,geometry.height);
  SetEqualFractionGridRowsColumns(host,layout.gridRows,layout.gridCols);
  SetGridGapPaddingAndRadius(host,geometry.gap,geometry.outerMargin,0);
  DrawOuterDecorationWithoutChangingInnerGeometry(host);
HostScopedSlotFrames:
  while i <= Len(visibleSlots) do
    slot := visibleSlots[i];
    refs := ReuseOrCreateSameIdFrameContentAndDecoration(host,slot.id);
    PlaceFrameAtRowColumnAndSpans(refs.frame,slot.row,slot.col,slot.rowSpan,slot.colSpan);
    SetFrameMinDimensionsAndRadius(refs.frame,0,0,geometry.radius);
    ApplySharedSlotBorderBackgroundBoxSizingAndContentLayout(refs,layout.slotStyle.showBorders);
    PreserveExistingContentChildren(refs.content);
    KeepDecorationOutsideLayoutSizing(refs.decoration);
    frameView.slots[slot.id] := refs; i := i + 1;
  end while;
  DetachFramesWhoseIdsAreAbsent(host,visibleSlots);
  result := frameView;
  \* This host's structure only. Caller owns content/listeners and resource cleanup.
  \* No Plotly/decode/selection/session/generation/resize effects.
  return;
end procedure;

procedure renderDashboard(projectProjection,interfaceState)
variables slot = NoValue, frameView = NoValue;
begin
SelectedCurrentOwnerOnly:
  CleanupRemovedOrReplacedSurfaceOwners(graphInstances,imageSurfaces,projectProjection.visibleSlots);
  UpdateSelectionDecorationAndInteractionOnly(interfaceState);
  if interfaceState.selectedSlotId = NoValue then result := NoValue; return; end if;
  slot := projectProjection.targetSlot;
  if slot = NoValue then result := NoValue; return; end if;
  if slot.id # interfaceState.selectedSlotId then result := NoValue; return; end if;
PrepareOrCheckSameGrid:
  if WorkspaceHasNoContentFrame() then
    call renderDashboardFrame(CurrentDashboardHost(),projectProjection.layout,
                              projectProjection.visibleSlots,projectProjection.geometry);
    frameView := result;
  elsif ~CanReuseCurrentGridAndTargetPlacement(projectProjection,slot.id) then
    ShowWholeRenderingRequiredWithoutChangingValidContent();
    result := WholeRenderingRequired(); return;
  end if;
OneTargetPresentation:
  call presentSlotContent(slot,interfaceState,projectProjection.geometry);
  ApplyOnlyTargetLabelsCaptionAndDecoration(slot,projectProjection,interfaceState);
  return;
end procedure;

procedure presentSlotContent(slot,interfaceState,geometry)
variables host = NoValue, identity = NoValue, operation = 0, instance = NoValue,
          completion = NoValue, baseSize = NoValue, lifetime = workspaceLifetime;
begin
CurrentSlotAssociation:
  host := CurrentContentHostOfSlot(slot.id);
  identity := [host |-> host,slotId |-> slot.id,contentType |-> slot.content.contentType,
               chartId |-> slot.content.chart,imageId |-> slot.content.imageId];
  ReleaseOnlyReplacedAssociationForSlot(graphInstances,imageSurfaces,identity);
  operation := FieldOrDefault(slotOperations,slot.id,0) + 1;
  slotOperations[slot.id] := operation;
SameHostPendingAndExecutionCheck:
  AwaitPreviousPendingOfThisHostWithoutChangingOtherHosts(host);
  if lifetime # workspaceLifetime \/ slotOperations[slot.id] # operation
     \/ ~CurrentHostAssociationMatches(identity) then result := NoValue; return; end if;
  baseSize := CurrentContentWidthHeight(host);
  if IsGraphSlotWithFigure(slot) then
    instance := CurrentGraphInstanceForIdentity(graphInstances,identity);
    if instance = NoValue then instance := InstallGraphInstance(host,identity); end if;
    graphInstances[host] := [identity |-> identity,instance |-> instance,lifetime |-> lifetime,operation |-> operation];
    completion := StartGraphPresentationWithCompletion(slot.figure,instance,
      [callback |-> "CompleteGraphRender",host |-> host,slotId |-> slot.id,
       chartId |-> slot.content.chart,lifetime |-> lifetime,operation |-> operation,baseSize |-> baseSize]);
  elsif IsImageSlotWithView(slot) then
    completion := StartImageDecodeWithSurfaceOwnedCopiedBytesOrPureUrl(host,slot.imageView,slot.content.imageSettings,
      [callback |-> "CompleteImageRender",host |-> host,slotId |-> slot.id,input |-> slot.imageView,
       lifetime |-> lifetime,operation |-> operation,baseSize |-> baseSize]);
  else
    ReleaseOnlySlotContentResources(graphInstances,imageSurfaces,slot.id);
    ApplyEmptySlotSurface(host,slot); completion := CompletedPresentation(host);
  end if;
  KeepThisHostPendingUntilItsCompletion(host,completion);
  UpdateOnlyThisSlotSelectionBoundaryBookmarkAndFocus(slot,interfaceState,geometry.radius,4);
  result := completion;
  \* Base size is the owned render-resource size, not a Project read value.
  \* No content render schedules a later Plotly resize.
  return;
end procedure;

procedure Renderer_renderWholeWorkspace(projectProjection,interfaceState)
variables frameView = NoValue, i = 1, completions = <<>>;
begin
OnlyExplicitWholeInput:
  Require(projectProjection.operation = "whole-workspace");
  CleanupRemovedOrReplacedSurfaceOwners(graphInstances,imageSurfaces,projectProjection.visibleSlots);
  call renderDashboardFrame(CurrentDashboardHost(),projectProjection.layout,
                            projectProjection.visibleSlots,projectProjection.geometry);
  frameView := result;
  while i <= Len(projectProjection.contentSlots) do
    call presentSlotContent(projectProjection.contentSlots[i],interfaceState,projectProjection.geometry);
    completions := Append(completions,result); i := i + 1;
  end while;
  ApplySuppliedWholeLabelsAndSlotCaptions(frameView,projectProjection,interfaceState);
  call syncDashboardCaption(projectProjection.annotations.captions);
  result := AwaitOnlyThisActionCompletionsWithOriginalFailures(completions);
  return;
end procedure;

procedure applyWorkspaceTransform(projectProjection,interfaceState)
variables frameView = NoValue, i = 1, slot = NoValue, surface = NoValue,
  size = NoValue, scaleX = 1, scaleY = 1;
begin
StructureAndOwnerCleanupOnly:
  CleanupRemovedOrReplacedSurfaceOwners(graphInstances,imageSurfaces,projectProjection.visibleSlots);
  if WorkspaceHasNoContentFrame() then
    call renderDashboardFrame(CurrentDashboardHost(),projectProjection.layout,
                              projectProjection.visibleSlots,projectProjection.geometry);
    UpdateSelectionDecorationAndInteractionOnly(interfaceState);
    result := CurrentDashboardHost(); return;
  end if;
  if ~CanSafelyReuseExistingGridAndSpans(projectProjection) then
    ShowWholeRenderingRequiredWithoutChangingValidContent();
    result := CurrentDashboardHost(); return;
  end if;
  call renderDashboardFrame(CurrentDashboardHost(),projectProjection.layout,
                            projectProjection.visibleSlots,projectProjection.geometry);
  frameView := result;
TransformExistingPixels:
  while i <= Len(projectProjection.visibleSlots) do
    slot := projectProjection.visibleSlots[i];
    surface := CurrentRenderedSurfaceOfSlotOrNone(slot.id);
    if surface # NoValue then
      size := CurrentContentWidthHeight(frameView.slots[slot.id].content);
      if PositiveFinite(surface.baseWidth) /\ PositiveFinite(surface.baseHeight) then
        scaleX := size.width / surface.baseWidth; scaleY := size.height / surface.baseHeight;
        ApplyOwnedContentCssTranslationAndScale(surface,scaleX,scaleY,"top-left");
        SetPointerInverseOfCurrentTranslationAndScale(surface,scaleX,scaleY);
      end if;
    end if;
    i := i + 1;
  end while;
  UpdateSelectionDecorationAndInteractionOnly(interfaceState);
  result := CurrentDashboardHost();
  \* Reuses current graph/image pixels, fonts and strokes. No Plotly/decode/resize.
  return;
end procedure;

procedure clearWorkspacePresentation()
begin
WorkspaceReplacementLifetime:
  workspaceLifetime := workspaceLifetime + 1;
  ReleaseOnlyWorkspaceOwnedGraphsImagesHandlesAndListeners(graphInstances,imageSurfaces);
  graphInstances := []; imageSurfaces := []; slotOperations := [];
  ClearOnlyWorkspaceFramesAndSelectionDecoration();
  result := NoValue;
  \* Independent export task hosts and resources remain owned by those tasks.
  return;
end procedure;

procedure CompleteGraphRender(host,slotId,chartId,lifetime,operation,baseSize,completion)
begin
OnlyCurrentSameSlotCompletion:
  if lifetime # workspaceLifetime \/ FieldOrDefault(slotOperations,slotId,0) # operation
     \/ ~SameLiveGraphHostSlotChartOperation(graphInstances,host,slotId,chartId,operation) then
    ReleaseOnlyCompletionTemporaryResources(completion); result := NoValue; return;
  end if;
  if completion.threw then
    ReleaseOnlyCompletionTemporaryResources(completion); PropagateOriginalFailure(completion.failure);
  end if;
  ApplyCompletedPresentationToCurrentHostOnly(host,completion);
  SetThisSurfaceBaseRenderSize(host,baseSize);
  ApplyCssScaleToLatestHostSizeWithInversePointerCoordinates(host,baseSize);
  result := NoValue; return;
end procedure;

procedure CompleteImageRender(host,slotId,imageInput,lifetime,operation,baseSize,completion)
begin
OnlyCurrentSameImageInput:
  if lifetime # workspaceLifetime \/ FieldOrDefault(slotOperations,slotId,0) # operation
     \/ ~SameCurrentImageSurfaceInput(host,slotId,imageInput,operation) then
    ReleaseOnlyCompletionTemporaryResources(completion); result := NoValue; return;
  end if;
  if completion.threw then
    ReleaseOnlyCompletionTemporaryResources(completion); PropagateOriginalFailure(completion.failure);
  end if;
  InstallCompletedImageOnCurrentSurface(host,completion);
  SetThisSurfaceBaseRenderSize(host,baseSize);
  ApplyCssScaleToLatestHostSizeWithInversePointerCoordinates(host,baseSize);
  result := NoValue; return;
end procedure;

procedure setSelectedSlot(slotId,direction,frontendActions)
begin
SuppliedSelectionActionOnce:
  result := InvokeSuppliedAction(frontendActions.slots.select,[slotId |-> slotId,direction |-> direction]);
  \* Application already performs the selected-slot presentation after reconciliation.
  return;
end procedure;

procedure installSlotClickController(frontendActions)
begin
InstallExistingControllerHandlers:
  InstallDashboardClickHandler("HandleSlotClick",frontendActions);
  InstallBookmarkDragHandlers("StartBookmarkDrag","EndBookmarkDrag","ConsumePostDragClick",frontendActions);
  \* OS DataTransfer files go to Mantine file drop, NOT this bookmark handler.
  result := InstalledDashboardInteractionController();
  return;
end procedure;

procedure HandleSlotClick(event,interactionView,frontendActions)
variables slot = NoValue, selected = interactionView.selectedSlotId;
begin
ControllerBoundary:
  if ~InsideDashboardInteractionController(event) then result := NoValue; return; end if;
  if IsBookmarkClick(event) /\ suppressBookmarkClick then
    ConsumeEvent(event); suppressBookmarkClick := FALSE; result := NoValue; return;
  end if;
  slot := VisibleSlotInInteractionProjection(event,interactionView);
Background:
  if slot = NoValue then
    if selected # NoValue then call setSelectedSlot(NoValue,"fsm-to-model",frontendActions); end if;
    result := NoValue; return;
  end if;
SelectionBeforeContent:
  if slot.id # selected then call setSelectedSlot(slot.id,"ui-to-fsm",frontendActions);
  elsif IsBookmarkClick(event) then call setSelectedSlot(slot.id,"ui-to-fsm",frontendActions);
  elsif HasGraphContent(slot) then LeaveEventToPlotlyInteraction(event);
  elsif HasImageContent(slot) then LeaveEventToImageInteraction(event);
  else call setSelectedSlot(slot.id,"ui-to-fsm",frontendActions); end if;
  result := NoValue;
  return;
end procedure;

procedure StartBookmarkDrag(source)
begin
SuppressSameInteractionCycleClick:
  dragSource := source;
  suppressBookmarkClick := TRUE;
  result := NoValue;
  return;
end procedure;

procedure EndBookmarkDrag(target,frontendActions)
variables source = dragSource;
begin
DragSourceCleanupNotClickSuppressionCleanup:
  dragSource := NoValue;
  if source # NoValue /\ target # NoValue then call swapSlotContents(source,target,frontendActions); end if;
  ScheduleCleanupAfterPostDragClickDispatchOpportunity("ConsumePostDragClick");
  result := NoValue;
  return;
end procedure;

procedure ConsumePostDragClick(event)
begin
OneClickOrAfterItsOpportunity:
  if event # NoValue /\ suppressBookmarkClick then ConsumeEvent(event); end if;
  suppressBookmarkClick := FALSE;
  result := NoValue;
  return;
end procedure;

procedure swapSlotContents(source,target,frontendActions)
begin
SwapOnlyExplicitIds:
  result := InvokeSuppliedAction(frontendActions.slots.swap,[sourceSlotId |-> source.id,targetSlotId |-> target.id]);
  \* Application owns the one structural CSS update; do not repeat it here.
  return;
end procedure;

procedure finishDashboardFileDropInteraction()
begin
IdempotentCurrentDragOnly:
  CleanupCurrentDragHoverAndBookkeeping();
  dragSource := NoValue;
  \* Do NOT clear suppressBookmarkClick before post-drag click opportunity.
  result := NoValue;
  return;
end procedure;

procedure Renderer_prepareDashboardFileDrop(slotId,frontendActions)
begin
UsePrepareNotToggleSelect:
  result := InvokeSuppliedAction(frontendActions.slots.prepareFileDrop,[slotId |-> slotId]);
  return;
end procedure;

procedure applyUiPalette(projectProjection)
variables palette = projectProjection;
\* Application supplies the ui-palette query result or whole renderer result.appearance.uiPalette.
\* Workspace graph figures are applied only within the permitted selected or explicit whole scope.
begin
FiveLegacyCssVariables:
  SetCssVariables(["--ui-color" |-> palette.uiColor,"--paper" |-> palette.uiBackgroundColor,
     "--ui-subtle" |-> palette.uiSubtleColor,"--ink" |-> palette.fontColor,"--graph-bg" |-> palette.paperColor]);
  result := CurrentPaletteCssProjection();
  return;
end procedure;

procedure applySlotStyle(projectProjection,interfaceState)
variables styleView = NoValue;
begin
ReuseCurrentPixelsForStyleGeometry:
  call applyWorkspaceTransform(projectProjection,interfaceState); styleView := result;
  result := styleView; return;
end procedure;

procedure resolveSelectedChart(projectProjection,interfaceState)
begin
OneCallSuppliedRelation:
  result := SuppliedResolvedChartForSelectedSlotOrNone(projectProjection,interfaceState.selectedSlotId);
  return;
end procedure;

procedure updateGraphView(projectProjection,interfaceState)
begin
SelectedContentWithCurrentInteraction:
  UpdateSelectionDecorationAndInteractionOnly(interfaceState);
  call renderDashboard(projectProjection,interfaceState); return;
end procedure;

procedure startupCoreRuntime(projectProjection,interfaceState,frontendActions)
variables clickController = NoValue, dropController = NoValue;
begin
ControllersBeforeBlankStructure:
  call installSlotClickController(frontendActions); clickController := result;
  dropController := InstallExistingPublicDropController(frontendActions);
  call applyWorkspaceTransform(projectProjection,interfaceState);
  AuditSuppliedProjectReferenceRuntimeProjectionContracts(projectProjection,interfaceState);
  result := RendererRuntimeWithOwnedControllers(clickController,dropController);
  \* Initial startup prepares structure and interaction only.
  return;
end procedure;

procedure readDashboardRenderedWidth()
variables measured = MeasureCurrentDashboardBoundingWidthOrNone();
begin
OneShotCaptureScalar:
  result := IF PositiveFinite(measured) THEN measured ELSE NoValue;
  return;
end procedure;

procedure downloadExportPayload(payload)
variables owned = NoValue, bytes = NoValue, completion = NoValue;
begin
CopiedDataOnly:
  completion := CaptureOriginalFailureOfPayloadEncoding(payload,"ZIP STORE if entries; otherwise copied bytes");
  if completion.threw then goto DownloadCleanup; end if;
  bytes := completion.value;
  completion := CaptureOriginalFailureOfCreatingDownloadResource(bytes,payload.name,payload.mime);
  if completion.threw then goto DownloadCleanup; end if;
  owned := completion.value;
OneBrowserHandoff:
  completion := CaptureOriginalFailureOfOneBrowserHandoff(owned);
DownloadCleanup:
  if owned # NoValue then ReleaseThisDownloadResourceAfterSafeByteConsumptionOpportunity(owned,completion); end if;
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  result := NoValue;
  \* No disk acknowledgement or imaginary observable-cancel outcome.
  return;
end procedure;

procedure exportCaptionLayout(snapshot,measureText)
variables caption = snapshot.annotations.captions, style = snapshot.captionReferenceStyle,
          referenceWidth = snapshot.layout.slotStyle.referenceWidth, available = 0,
          lineHeight = 0, prefix = "", prefixWidth = 0, paragraphs = <<>>, words = <<>>,
          lines = <<>>, line = "", proposed = "", firstLine = TRUE,
          pi = 1, wi = 1, budget = 0, completion = NoValue;
begin
DisabledIsZeroNotBlankLine:
  if ~caption.enabled then result := [lines |-> <<>>,height |-> 0,gap |-> 0]; return; end if;
SameFontForMeasurementAndPaint:
  completion := AwaitRequiredResolvedFontOrOriginalFailure(caption.settings.fontFamily);
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  available := Maximum(style.minimumTextWidth,referenceWidth - 2 * style.padding);
  lineHeight := caption.settings.fontSize * caption.settings.lineHeight;
  if caption.name # "" then
    prefix := caption.name \o " ";
    prefixWidth := InvokeMeasureText(measureText,prefix,caption.settings.fontFamily,caption.settings.fontSize,
       IF caption.nameBold THEN 700 ELSE 400);
  end if;
  paragraphs := SplitNewlinesPreservingEmptyParagraphs(caption.text);
  \* afterText is stored separately and never implicitly appended here.
EachParagraph:
  while pi <= Len(paragraphs) do
    words := NonemptyWhitespaceSeparatedWords(paragraphs[pi]);
    wi := 1; line := "";
EachWord:
    while wi <= Len(words) do
      proposed := IF line = "" THEN words[wi] ELSE line \o " " \o words[wi];
      budget := Maximum(style.minimumTextWidth,available - IF firstLine THEN prefixWidth ELSE 0);
      if InvokeMeasureText(measureText,proposed,caption.settings.fontFamily,caption.settings.fontSize,400) > budget
         /\ line # "" then
        lines := Append(lines,[text |-> line,prefix |-> IF firstLine THEN prefix ELSE "",prefixWidth |-> IF firstLine THEN prefixWidth ELSE 0]);
        firstLine := FALSE;
        line := "";
        \* Retry SAME word, not drop it. Overlong word on empty line is retained/clipped.
      else
        line := proposed;
        wi := wi + 1;
      end if;
    end while;
ParagraphBreakEvenWhenBlank:
    lines := Append(lines,[text |-> line,prefix |-> IF firstLine THEN prefix ELSE "",prefixWidth |-> IF firstLine THEN prefixWidth ELSE 0]);
    firstLine := FALSE;
    pi := pi + 1;
  end while;
SharedLinesForMeasureAndPaint:
  result := [referenceWidth |-> referenceWidth,lines |-> lines,padding |-> style.padding,
    lineHeight |-> lineHeight,fontFamily |-> caption.settings.fontFamily,fontSize |-> caption.settings.fontSize,
    prefixWeight |-> IF caption.nameBold THEN 700 ELSE 400,bodyWeight |-> 400,
    height |-> 2 * style.padding + Len(lines) * lineHeight + style.borderHeight,gap |-> style.dashboardGap];
  return;
end procedure;

procedure renderDashboardTarget(snapshot,statusSink)
variables owned = <<>>, completion = NoValue, caption = NoValue, geometry = NoValue,
          referenceWidth = snapshot.layout.slotStyle.referenceWidth,
          width = snapshot.export.width, scale = 0, referenceHeight = 0, totalHeight = 0,
          dashboardHeight = 0, image = NoValue, payload = NoValue, output = NoValue;
begin
CaptionMeasuredOnceAtReferenceWidth:
  completion := CaptureOriginalFailureOfCallingExportCaptionLayout(snapshot);
  if completion.threw then goto TargetCleanup; end if;
  caption := completion.value;
UniformReferenceScaleNotDpiScale:
  scale := width / referenceWidth;
  referenceHeight := referenceWidth / snapshot.layout.slotStyle.aspect;
  if snapshot.export.heightMode = "auto" then
    totalHeight := Ceiling((referenceHeight + caption.height + caption.gap) * scale);
    dashboardHeight := referenceHeight * scale;
  else
    totalHeight := snapshot.export.height;
    dashboardHeight := totalHeight - (caption.height + caption.gap) * scale;
  end if;
RejectBeforeDownload:
  if ~SuppliedRasterDimensionAndAreaLimitsAllow(snapshot.rasterLimits,Round(width),Round(totalHeight)) then
    output := [outcome |-> "rejected",reason |-> "raster-limit"]; goto TargetCleanup;
  end if;
  if dashboardHeight <= 0 then output := [outcome |-> "rejected",reason |-> "caption-height"]; goto TargetCleanup; end if;
  geometry := [width |-> width,height |-> dashboardHeight,scale |-> scale,
    outerMargin |-> Minimum(snapshot.layout.slotStyle.outerMargin * scale,Minimum(width,dashboardHeight) * 0.49),
    gap |-> snapshot.layout.slotStyle.gap * scale,radius |-> snapshot.layout.slotStyle.radius * scale];
  geometry.colWidth := (width - 2 * geometry.outerMargin - geometry.gap * (snapshot.layout.gridCols - 1)) / snapshot.layout.gridCols;
  geometry.rowHeight := (dashboardHeight - 2 * geometry.outerMargin - geometry.gap * (snapshot.layout.gridRows - 1)) / snapshot.layout.gridRows;
  if geometry.colWidth <= 0 \/ geometry.rowHeight <= 0 then
    output := [outcome |-> "rejected",reason |-> "grid-geometry"]; goto TargetCleanup;
  end if;
RenderSuppliedFiguresAndImagesAtTarget:
  completion := CaptureOriginalFailureOfCreatingTaskRenderHosts(Round(width),Round(totalHeight),
                  [includeEditorDecorations |-> FALSE]);
  \* Only task hosts exclude selection/bookmark emphasis and preview dashes.
  if completion.threw then goto TargetCleanup; end if;
  owned := Append(owned,completion.value);
  completion := CaptureOriginalFailureOfRenderingVisibleSuppliedSlotFiguresAndImages(snapshot,geometry,scale,owned,statusSink);
  if completion.threw then goto TargetCleanup; end if;
  \* Figure-copy font/line/marker/image presentation scale; no Backend CSV transform.
SameReferenceLabelsCaption:
  completion := CaptureOriginalFailureOfPaintingSuppliedLabelsAndCaptionLines(snapshot,caption,geometry,scale,owned);
  if completion.threw then goto TargetCleanup; end if;
  completion := CaptureOriginalFailureOfEncodingPngOrJpegWithDpiMetadata(owned,snapshot.export.format,snapshot.export.dpi);
  if completion.threw then goto TargetCleanup; end if;
  payload := completion.value;
  completion := CaptureOriginalFailureOfCallingDownloadExportPayload(payload);
  if completion.threw then goto TargetCleanup; end if;
  output := [outcome |-> "saved",width |-> Round(width),height |-> Round(totalHeight),automaticHeight |-> snapshot.export.heightMode = "auto"];
TargetCleanup:
  ReleaseOnlyTaskOwnedRenderHostsPlotsImagesAndUrls(owned);
  if completion # NoValue then if completion.threw then PropagateOriginalFailure(completion.failure); end if; end if;
  result := output;
  \* saved = handoff, not disk confirmation; status failure cannot undo a handed-off file.
  return;
end procedure;

procedure renderDashboardCurrent(snapshot,statusSink)
variables viewport = NoValue, owned = <<>>, completion = NoValue, output = NoValue;
begin
OneShotCurrentSizeNotPersistentPreset:
  viewport := MeasureCurrentRenderedViewportOnce();
  if ~SuppliedRasterDimensionAndAreaLimitsAllow(snapshot.rasterLimits,viewport.width,viewport.height) then
    result := [outcome |-> "rejected",reason |-> "raster-limit"]; return;
  end if;
  completion := CaptureOriginalFailureOfCurrentSurfaceCapture(snapshot,viewport,statusSink,owned,
                  [includeEditorDecorations |-> FALSE]);
  \* Capture-only exclusion preserves live selection and its decoration.
  if ~completion.threw then
    completion := CaptureOriginalFailureOfEncodingPngOrJpegWithDpiMetadata(completion.value,snapshot.export.format,snapshot.export.dpi);
    if ~completion.threw then
      completion := CaptureOriginalFailureOfCallingDownloadExportPayload(completion.value);
      if ~completion.threw then output := [outcome |-> "saved",width |-> Round(viewport.width),height |-> Round(viewport.height),automaticHeight |-> FALSE]; end if;
    end if;
  end if;
CaptureFinally:
  ReleaseOnlyTaskOwnedRenderHostsPlotsImagesAndUrls(owned);
  if completion.threw then PropagateOriginalFailure(completion.failure); end if;
  result := output;
  \* Do not retain snapshot/viewport for another task or store geometry in Project.
  return;
end procedure;

