---- MODULE FastFigureBackendProjectEFSMR38 ----
EXTENDS Naturals, Integers, Sequences

\* Active direct Source r38 translation; see the translation review for scope/evidence.
\* This part translates the common transaction, actual-result formation and
\* the original-index cascade filter and explicit command-domain dispatch.
\* Remaining candidate helper bindings / asset cascade integration need fidelity review.
\* No Frontend imports/calls. activeProject is the sole Backend authority binding.
\* CurrentAuthorityReference is the existing ProjectObject INTERNAL STATE reference,
\* not a new persisted revision/token, snapshot store, or ProjectObject field.
\* Qualified source method projectEFSM.send is ProjectStateMachine_send below.
CONSTANT NoValue, BackendSettings
PROJECT_COMMANDS == {
 "PROJECT_LOADED", "PROJECT_NAME_CHANGED", "PROJECT_DIRECTORY_CREATED", "PROJECT_NODE_MOVED",
 "PROJECT_TRASH_EMPTIED", "ASSETS_IMPORTED", "DATA_OBJECT_CREATED", "DATA_OBJECT_REPLACED",
 "DATA_OBJECT_DELETED", "IMAGE_OBJECT_CREATED", "IMAGE_OBJECT_REPLACED", "IMAGE_OBJECT_DELETED",
 "SLOT_TYPE_CHANGED", "SLOTS_RESET", "SLOTS_SWAPPED", "SLOT_IMAGE_LINKED", "SLOT_IMAGE_SETTINGS_CHANGED",
 "SLOT_DATA_CONNECTED", "SLOT_IMAGE_IMPORTED", "SLOT_CHART_IMPORTED", "GRAPH_OBJECTS_REPLACED",
 "CHART_LAYOUT_CHANGED", "CHART_MODEL_REPLACED", "GRID_LAYOUT_CHANGED", "LAYOUT_STYLE_CHANGED",
 "SLOTS_MERGED", "SLOTS_SPLIT", "CAPTION_TEXT_INPUT", "SLOT_CAPTIONS_INSERTED",
 "CAPTION_SETTINGS_CHANGED", "LABEL_SETTINGS_CHANGED", "LABEL_POSITION_CHANGED",
 "APPEARANCE_CHANGED", "EXPORT_SETTINGS_CHANGED"}

ASSET_COMMANDS == {"PROJECT_LOADED","PROJECT_NAME_CHANGED","PROJECT_DIRECTORY_CREATED","PROJECT_NODE_MOVED",
 "PROJECT_TRASH_EMPTIED","ASSETS_IMPORTED","DATA_OBJECT_CREATED","DATA_OBJECT_REPLACED","DATA_OBJECT_DELETED",
 "IMAGE_OBJECT_CREATED","IMAGE_OBJECT_REPLACED","IMAGE_OBJECT_DELETED"}
\* Source graph edit operations, not a generic replacement-array public API:
GRAPH_OPERATIONS == {"graphs.addObject", "graphs.moveObject", "graphs.setObjectValues",
                     "graphs.deleteObject", "graphs.applyPalette"}
\* Command-private optional lookup; no required-slot exception for Source swap noops.
FindByIdOrNone(slots,id) ==
  LET matches == {i \in 1..Len(slots) : slots[i].id = id}
  IN IF matches = {} THEN None ELSE slots[CHOOSE i \in matches : TRUE]
\* No successful hint/map may be present in a failed outcome.

(* --algorithm BackendProjectEFSM
variables result = NoValue;

\* Private expansions of Source-declared settings calculations. They receive
\* only the current command owner's settings plus NEW supplied fields, not a
\* Frontend/read projection. Their result is candidate data, never a commit.
procedure NormalizeImageEditsInAttempt(current,edits)
variables copy = DeepCopy(current), fields = <<"scale","x","y">>, i = 1,
          key = "", number = NoValue, bounds = NoValue;
begin
OnlyDeclaredFit:
  if HasField(edits,"fit") then
    if edits.fit \in {"contain","cover","manual"} then copy.fit := edits.fit; end if;
  end if;
ManualNumbersOnly:
  if copy.fit = "manual" then
    while i <= Len(fields) do
      key := fields[i];
      if HasField(edits,key) then
        \* TryScalarNumber distinguishes invalid from valid zero. No truthiness.
        number := TryScalarNumber(edits[key]);
        if number.valid then
          if IsFinite(number.value) then
            bounds := BackendSettings.defaults.limits.imageSettings[key];
            copy[key] := Maximum(bounds[1],Minimum(bounds[2],number.value));
          end if;
        end if;
      end if;
      i := i + 1;
    end while;
  end if;
ImageEditReturn:
  result := copy;
  return;
end procedure;

procedure buildSlotCommandCandidate(event,payload,state)
variables slot = NoValue, other = NoValue, i = 1, keys = <<>>, csv = NoValue,
          image = NoValue, imported = NoValue, imageId = NoValue, defaults = NoValue;
begin
ResolveCurrentCandidateSlot:
  if HasField(payload,"slotId") then
    call resolveVisibleSlot(payload.slotId,state); slot := result;
    if slot = NoValue then result := NoValue; return; end if;
  end if;
ApplyOnlySlotCommand:
  if event = "SLOT_TYPE_CHANGED" then
    slot.content.contentType := IF payload.contentType = "image" THEN "image" ELSE "graph";
  elsif event = "SLOTS_RESET" then
    keys := payload.slotIds;
    while i <= Len(keys) do
      call resolveVisibleSlot(keys[i],state); slot := result;
      if slot = NoValue then result := NoValue; return; end if;
      call Slot___init__(slot.id,slot.row,slot.col); defaults := result;
      RemoveOnlyChartOwnedBySlot(state,slot.id);
      ReplaceSlotLocalPayloadOnly(state,slot.id,DeepCopy(defaults.content),DeepCopy(defaults.caption));
      i := i + 1;
    end while;
  elsif event = "SLOTS_SWAPPED" then
    call resolveVisibleSlot(payload.sourceSlotId,state); slot := result;
    call resolveVisibleSlot(payload.targetSlotId,state); other := result;
    if slot = NoValue \/ other = NoValue then result := NoValue; return; end if;
    if slot.id = other.id then result := NoValue; return; end if;
    SwapCompleteSlotLocalPayloadWithoutChangingGeometryOrIdentity(state,slot.id,other.id);
  elsif event = "SLOT_IMAGE_LINKED" then
    image := ImageById(state,payload.imageId);
    if slot.content.contentType # "image" \/ image = NoValue then result := NoValue; return; end if;
    slot.content.imageId := image.id;
  elsif event = "SLOT_IMAGE_SETTINGS_CHANGED" then
    if slot.content.contentType # "image" then result := NoValue; return; end if;
    call NormalizeImageEditsInAttempt(slot.content.imageSettings,payload.settings);
    slot.content.imageSettings := result;
  elsif event = "SLOT_DATA_CONNECTED" then
    csv := ResolveCurrentCsvFromExplicitIdOrPath(state,payload);
    if slot.content.contentType # "graph" \/ csv = NoValue then result := NoValue; return; end if;
    if slot.content.chart # NoValue then
      if FieldOrNoValue(payload,"operation") = "graphs.addObject" \/
         ~ChartById(state,slot.content.chart).editor.editable then result := NoValue; return; end if;
    end if;
    call connectDataToSlotModel(slot,csv.rows,csv.name,csv,state); state := result;
  elsif event = "SLOT_IMAGE_IMPORTED" then
    if slot.content.contentType # "image" then result := NoValue; return; end if;
    imageId := state.nextId.image;
    call buildAssetCommandCandidate("IMAGE_OBJECT_CREATED",ImageCreateFieldsWithCurrentVfsLocation(payload,BackendSettings.defaults.vfs.image),state,NoValue);
    state := result[1];
    if state = NoValue then result := NoValue; return; end if;
    call resolveVisibleSlot(payload.slotId,state); slot := result;
    slot.content.imageId := imageId;
    RemoveOnlyChartOwnedBySlot(state,slot.id); slot.content.chart := NoValue;
  elsif event = "SLOT_CHART_IMPORTED" then
    if IsFfsxPackage(payload.file) then
      call ffsxReadSlot(payload.file); imported := result;
      call applyFfsxSlot(imported,slot,state); state := result;
    else
      call parsePlotlyToEditor(ParseUtf8JsonFromCopiedFileBytes(payload.file),state.nextId.chart); imported := result;
      state.nextId.chart := state.nextId.chart + 1;
      RemoveOnlyChartOwnedBySlot(state,slot.id);
      state.charts := Append(state.charts,imported); slot.content.chart := imported.id;
    end if;
  end if;
  result := state; return;
end procedure;

procedure collectTargetSlotAssetLinks(slotIds,state)
variables ids = SequenceOfSet(slotIds), links = <<>>, i = 1, j = 1,
          slot = NoValue, chart = NoValue, csvId = NoValue;
begin
ReadOnlyTargetLinksWithMultiplicity:
  while i <= Len(ids) do
    call resolveVisibleSlot(ids[i],state); slot := result;
    if slot # NoValue then
      if slot.content.imageId # NoValue then links := Append(links,<<"image",slot.content.imageId>>); end if;
      if slot.content.chart # NoValue then
        chart := ChartById(state,slot.content.chart);
        if chart # NoValue then
          call chartUsesConversionView(chart);
          if ~result then
            j := 1;
            while j <= Len(chart.editor.objects) do
              csvId := FieldOrNoValue(chart.editor.objects[j],"csvId");
              if csvId # NoValue then links := Append(links,<<"csv",csvId>>); end if;
              j := j + 1;
            end while;
          end if;
        end if;
      end if;
    end if;
    i := i + 1;
  end while;
  result := SortLexicographically(links); return;
end procedure;

procedure CalculateSourceCommandCandidate(event,payload,sourceState)
variables candidate = DeepCopy(sourceState), retainedOriginalIndicesByChart = [],
          outcome = NoValue, assetFacts = NoValue;
begin
DomainBranchNotAlternativeMutationEntry:
  \* Reference to Source's attempt-local mutable array, not a persisted field.
  assetFacts := NewMutableArray();
  \* Call-local Source command calculation. No commit or Frontend access.
  if event \in ASSET_COMMANDS then
    call buildAssetCommandCandidate(event,payload,candidate,assetFacts); outcome := result;
    candidate := outcome[1];
    retainedOriginalIndicesByChart := outcome[2];
  elsif event \in {"GRAPH_OBJECTS_REPLACED","CHART_LAYOUT_CHANGED","CHART_MODEL_REPLACED"} then
    call buildGraphCommandCandidate(event,payload,candidate); candidate := result;
  elsif event \in {"SLOT_DATA_CONNECTED","SLOT_CHART_IMPORTED","SLOT_TYPE_CHANGED","SLOTS_RESET","SLOTS_SWAPPED",
                    "SLOT_IMAGE_LINKED","SLOT_IMAGE_SETTINGS_CHANGED","SLOT_IMAGE_IMPORTED"} then
    call buildSlotCommandCandidate(event,payload,candidate); candidate := result;
  else
    call buildLayoutCommandCandidate(event,payload,candidate); candidate := result;
  end if;
CandidateAndAttemptFacts:
  result := [candidate |-> candidate,retainedOriginalIndicesByChart |-> retainedOriginalIndicesByChart,
             assetFacts |-> ReadArrayEntriesInOrder(assetFacts)];
  return;
end procedure;

procedure BuildActualChanged(event,payload,pre,post,assetFacts)
variables changed = [], inputs = <<>>, before = NoValue, after = NoValue, a = NoValue,
  refs = <<>>, ref = NoValue, owner = NoValue, slot = NoValue,
  owners = <<>>, i = 1, j = 1;
begin
ActualPrePostDifferences:
  changed := [slotIds |-> ChangedIdentitySequence(pre.slots,post.slots),
              chartIds |-> ChangedIdentitySequence(pre.charts,post.charts),
              csvIds |-> ChangedIdentitySequence(pre.assets.csvFiles,post.assets.csvFiles),
              imageIds |-> ChangedIdentitySequence(pre.assets.images,post.assets.images),
              assets |-> <<>>];
  if event = "PROJECT_LOADED" then result := changed; return; end if;
  if event \in {"PROJECT_NODE_MOVED","ASSETS_IMPORTED"} then
    inputs := DeepCopy(assetFacts);
  else
    for kind \in {"csv","image"} do
      before := IF kind = "csv" THEN pre.assets.csvFiles ELSE pre.assets.images;
      after := IF kind = "csv" THEN post.assets.csvFiles ELSE post.assets.images;
      for node \in SequenceSet(after) do
        if ~HasId(before,node.id) then
          inputs := Append(inputs,[role |-> "created",kind |-> kind,id |-> node.id,path |-> CanonicalAssetPath(node)]);
        elsif (event = "DATA_OBJECT_REPLACED" /\ kind = "csv" \/ event = "IMAGE_OBJECT_REPLACED" /\ kind = "image")
          /\ node.id = payload.id then
          inputs := Append(inputs,[role |-> "updated",kind |-> kind,id |-> node.id,path |-> CanonicalAssetPath(node)]);
        end if;
      end for;
      for node \in SequenceSet(before) do
        if ~HasId(after,node.id) then
          inputs := Append(inputs,[role |-> "deleted",kind |-> kind,id |-> node.id,path |-> CanonicalAssetPath(node),name |-> node.name]);
        end if;
      end for;
    end for;
    before := CanonicalDirectoryPaths(pre.fileSystem.directories);
    after := CanonicalDirectoryPaths(post.fileSystem.directories);
    for path \in (after \ before) do
      inputs := Append(inputs,[role |-> "created",kind |-> "directory",id |-> NoValue,path |-> path]);
    end for;
    for path \in (before \ after) do
      inputs := Append(inputs,[role |-> "deleted",kind |-> "directory",id |-> NoValue,path |-> path]);
    end for;
  end if;
OwnersFromCommittedReferences:
  while i <= Len(inputs) do
    a := inputs[i];
    if a.role # "deleted" /\ a.kind \in {"csv","image"} then
      call collectAssetReferences(IF a.kind = "csv" THEN {a.id} ELSE {},
                                  IF a.kind = "image" THEN {a.id} ELSE {},post);
      refs := result; j := 1; owners := <<>>;
      while j <= Len(refs) do
        ref := refs[j];
        if a.kind = "csv" then
          call resolveOwningSlot(ref.chartId,post); slot := result;
          owner := [slotId |-> slot.id,chartId |-> ref.chartId];
        else
          owner := [slotId |-> ref.slotId,chartId |-> NoValue];
        end if;
        if owner \notin SequenceSet(owners) then owners := Append(owners,owner); end if;
        j := j + 1;
      end while;
      a.owners := owners;
    end if;
    changed.assets := Append(changed.assets,a); i := i + 1;
  end while;
  result := changed; return;
end procedure;

procedure VisualCommitFacts(source)
variables render = [layout |-> DeepCopy(source.layout),annotations |-> DeepCopy(source.annotations),appearance |-> DeepCopy(source.appearance),
                    slots |-> <<>>,charts |-> <<>>,csv |-> <<>>,images |-> <<>>],
          refs = <<>>, i = 1, j = 1, slot = NoValue, chart = NoValue, csv = NoValue, image = NoValue;
begin
VisiblePersistentInputsNotFrontendState:
  while i <= Len(source.slots) do
    slot := source.slots[i];
    if ~slot.hidden then
      refs := Append(refs,<<"slot",slot.id>>); render.slots := Append(render.slots,DeepCopy(slot));
      if slot.content.contentType = "graph" /\ slot.content.chart # NoValue then
        chart := ChartById(source,slot.content.chart); Require(chart # NoValue);
        refs := Append(refs,<<"chart",slot.id,chart.id>>); render.charts := Append(render.charts,DeepCopy(chart));
        call chartUsesConversionView(chart);
        if ~result then
          j := 1;
          while j <= Len(chart.editor.objects) do
            csv := CsvById(source,chart.editor.objects[j].csvId); Require(csv # NoValue);
            refs := Append(refs,<<"csv",chart.id,csv.id>>);
            render.csv := Append(render.csv,[id |-> csv.id,rows |-> DeepCopy(csv.rows),headerLines |-> csv.headerLines]); j := j + 1;
          end while;
        end if;
      elsif slot.content.contentType = "image" /\ slot.content.imageId # NoValue then
        image := ImageById(source,slot.content.imageId); Require(image # NoValue);
        refs := Append(refs,<<"image",slot.id,image.id>>);
        render.images := Append(render.images,[id |-> image.id,bytesBase64 |-> image.bytesBase64,mime |-> image.mime]);
      end if;
    end if;
    i := i + 1;
  end while;
  result := [render |-> render,references |-> refs]; return;
end procedure;

procedure CalculateProjectionEffect(event,pre,post)
variables before = NoValue, after = NoValue, removed = FALSE, i = 1,
          tree = {"PROJECT_NAME_CHANGED","PROJECT_DIRECTORY_CREATED","PROJECT_NODE_MOVED","PROJECT_TRASH_EMPTIED","ASSETS_IMPORTED",
                  "DATA_OBJECT_CREATED","DATA_OBJECT_REPLACED","DATA_OBJECT_DELETED","IMAGE_OBJECT_CREATED","IMAGE_OBJECT_REPLACED","IMAGE_OBJECT_DELETED"};
begin
SameCommitPrePostOnly:
  call VisualCommitFacts(pre); before := result;
  call VisualCommitFacts(post); after := result;
MultisetReferencesNotMoveIndices:
  while i <= Len(before.references) do
    if CountEqualItems(before.references,before.references[i]) > CountEqualItems(after.references,before.references[i]) then removed := TRUE; end if;
    i := i + 1;
  end while;
  result := [referencesRemoved |-> removed,pathOnly |-> event \in tree /\ before.render = after.render];
  return;
end procedure;

procedure AssetReferenceKeys(state)
variables refs = <<>>, keys = <<>>, i = 1, ref = NoValue;
begin
CollectCurrentAssetReferences:
  call collectAssetReferences({a.id : a \in SequenceSet(state.assets.csvFiles)},
                              {a.id : a \in SequenceSet(state.assets.images)},state);
  refs := result;
ReferenceMultiplicity:
  while i <= Len(refs) do
    ref := refs[i];
    if ref.kind = "csv" then keys := Append(keys,<<"csv",ref.chartId,ref.assetId>>);
    else keys := Append(keys,<<"image",ref.slotId,ref.assetId>>); end if;
    i := i + 1;
  end while;
  result := keys;
  return;
end procedure;

procedure buildProjectMutationResult(event,payload,pre,post,retainedOriginalIndicesByChart,assetFacts)
variables hints = [], maps = <<>>, i = 1, j = 1, changed = [], graphCount = 0, imageCount = 0,
  projectionEffect = NoValue, beforeRefs = <<>>, afterRefs = <<>>, seen = {}, key = NoValue, removed = 0,
  chart = NoValue, indices = <<>>, k = 0, n = 0, fromIndex = NoValue, toIndex = NoValue,
  linked = <<>>, csvIds = {}, imageIds = {}, refs = <<>>, asset = NoValue, targets = {},
  slot = NoValue, beforeLinks = <<>>, linksChanged = FALSE, csvChanged = FALSE,
  removedCharts = <<>>, appended = <<>>, oldSlot = NoValue, oldChart = NoValue, newChart = NoValue,
  targetSlotId = FieldOrNoValue(payload,"targetSlotId"), operation = FieldOrNoValue(payload,"operation");
begin
FactsOfThisSuccessfulAttemptOnly:
  call BuildActualChanged(event,payload,pre,post,assetFacts); changed := result;
  call AssetReferenceKeys(pre); beforeRefs := result;
  call AssetReferenceKeys(post); afterRefs := result;
  while i <= Len(beforeRefs) do
    key := beforeRefs[i];
    if key \notin seen then
      seen := seen \cup {key};
      removed := Maximum(0,CountEqualItems(beforeRefs,key) - CountEqualItems(afterRefs,key));
      if key[1] = "csv" then graphCount := graphCount + removed;
      else imageCount := imageCount + removed; end if;
    end if;
    i := i + 1;
  end while;
ActualMovedOrRemovedLinks:
  i := 1;
  while i <= Len(changed.assets) do
    asset := changed.assets[i];
    if asset.role \in {"moved","deleted"} then
      if asset.kind = "csv" then csvIds := csvIds \cup {asset.id};
      elsif asset.kind = "image" then imageIds := imageIds \cup {asset.id}; end if;
    end if;
    i := i + 1;
  end while;
  if csvIds # {} \/ imageIds # {} then
    call collectAssetReferences(csvIds,imageIds,pre); refs := result;
    i := 1;
    while i <= Len(changed.assets) do
      asset := changed.assets[i];
      if asset.role \in {"moved","deleted"} then
        if \E ref \in SequenceSet(refs): ref.kind = asset.kind /\ ref.assetId = asset.id then
          linked := Append(linked,<<asset.kind,asset.id>>);
        end if;
      end if;
      i := i + 1;
    end while;
  end if;
CompareOnlyTargetedSlotLinks:
  if event \in {"SLOT_TYPE_CHANGED","SLOTS_RESET","SLOT_IMAGE_LINKED","SLOT_IMAGE_IMPORTED",
                 "SLOT_CHART_IMPORTED","CHART_MODEL_REPLACED","SLOTS_MERGED","SLOTS_SPLIT","GRID_LAYOUT_CHANGED"}
     \/ (event = "ASSETS_IMPORTED" /\ targetSlotId # NoValue) then
    targets := SequenceSet(changed.slotIds);
    if FieldOrNoValue(payload,"slotId") # NoValue then targets := targets \cup {payload.slotId}; end if;
    if targetSlotId # NoValue then targets := targets \cup {targetSlotId}; end if;
    if event = "CHART_MODEL_REPLACED" then
      call resolveOwningSlot(payload.chartId,pre); slot := result;
      if slot # NoValue then targets := targets \cup {slot.id}; end if;
      call resolveOwningSlot(payload.chartId,post); slot := result;
      if slot # NoValue then targets := targets \cup {slot.id}; end if;
    end if;
    call collectTargetSlotAssetLinks(targets,pre); beforeLinks := result;
    call collectTargetSlotAssetLinks(targets,post); linksChanged := beforeLinks # result;
  end if;
ActualCsvRebindAndAppend:
  if event = "GRAPH_OBJECTS_REPLACED" /\ operation = "graphs.setObjectValues" then
    oldChart := ChartById(pre,payload.chartId); newChart := ChartById(post,payload.chartId);
    csvChanged := oldChart.editor.objects[payload.index+1].csvId # newChart.editor.objects[payload.index+1].csvId;
  end if;
  if event = "ASSETS_IMPORTED" /\ targetSlotId # NoValue then
    call resolveVisibleSlot(targetSlotId,pre); oldSlot := result;
    call resolveVisibleSlot(targetSlotId,post); slot := result;
    if oldSlot # NoValue /\ slot # NoValue then
      if oldSlot.content.chart # NoValue /\ oldSlot.content.chart = slot.content.chart then
        oldChart := ChartById(pre,slot.content.chart); newChart := ChartById(post,slot.content.chart);
        if Len(newChart.editor.objects) > Len(oldChart.editor.objects) then appended := <<newChart.id>>; end if;
      end if;
    end if;
  end if;
RetainedOriginalIndices:
  for chartId \in Domain(retainedOriginalIndicesByChart) do
    if ChartById(post,chartId) # NoValue then
      chart := ChartById(pre,chartId);
      indices := Repeat(NoValue,Len(chart.editor.objects)); j := 1;
      while j <= Len(retainedOriginalIndicesByChart[chartId]) do
        indices[retainedOriginalIndicesByChart[chartId][j]+1] := j - 1;
        j := j + 1;
      end while;
      removedCharts := Append(removedCharts,chartId);
      maps := Append(maps,[chartId |-> chartId,indices |-> indices]);
    end if;
  end for;
  indices := <<>>;
CommittedMoveCorrespondence:
  if event = "GRAPH_OBJECTS_REPLACED" /\ FieldOrNoValue(payload,"operation") = "graphs.moveObject" then
    chart := ChartById(pre,payload.chartId);
    Require(chart # NoValue /\ UniqueChartOwnerExists(post,chart.id));
    n := Len(chart.editor.objects); fromIndex := payload.from; toIndex := payload.to;
    \* Same validated payload and actual pre/post of this committed attempt.
    while k < n do
      if k = fromIndex then indices := Append(indices,toIndex);
      elsif fromIndex < toIndex /\ fromIndex < k /\ k <= toIndex then indices := Append(indices,k-1);
      elsif toIndex < fromIndex /\ toIndex <= k /\ k < fromIndex then indices := Append(indices,k+1);
      else indices := Append(indices,k); end if;
      k := k + 1;
    end while;
    maps := Append(maps,[chartId |-> chart.id,indices |-> indices]);
  end if;
SelectionHintsFromCommittedTargets:
  if event = "PROJECT_LOADED" then hints.resetInterfaceSelection := TRUE;
  elsif event = "SLOTS_SWAPPED" then hints.swapSlotIds := <<payload.sourceSlotId,payload.targetSlotId>>;
  elsif event = "SLOTS_MERGED" then
    hints.mergeSlotIds := payload.slotIds; hints.anchorId := VisibleMergeAnchorOfCommittedTargets(post,payload.slotIds);
  elsif event = "PROJECT_NODE_MOVED" then
    i := 1;
    while i <= Len(changed.assets) do
      asset := changed.assets[i];
      if asset.role = "moved" /\ asset.oldPath = payload.path then
        hints.movedPathFrom := asset.oldPath; hints.movedPathTo := asset.path;
        if ~InTrashSubtree(asset.oldPath,BackendSettings.defaults.vfs.trash) /\
          InTrashSubtree(asset.path,BackendSettings.defaults.vfs.trash) then hints.enteringTrash := TRUE; end if;
      end if;
      i := i + 1;
    end while;
  elsif event = "SLOT_DATA_CONNECTED" /\ operation = "graphs.addObject" then
    call resolveVisibleSlot(payload.slotId,post); slot := result;
    chart := ChartById(post,slot.content.chart);
    hints.chartId := chart.id; hints.selectedIndexHint := Len(chart.editor.objects)-1;
  elsif event = "GRAPH_OBJECTS_REPLACED" /\ operation \in {"graphs.addObject","graphs.setObjectValues","graphs.deleteObject"} then
    if operation = "graphs.addObject" /\ FieldOrNoValue(payload,"chartId") = NoValue then
      call resolveVisibleSlot(payload.slotId,post); slot := result;
      chart := ChartById(post,slot.content.chart);
    else chart := ChartById(post,payload.chartId); end if;
    hints.chartId := chart.id;
    hints.selectedIndexHint := CASE operation = "graphs.addObject" -> Len(chart.editor.objects)-1
      [] operation = "graphs.setObjectValues" -> payload.index [] OTHER -> NoValue;
  end if;
  if Len(maps) > 0 then hints.graphObjectIndexMaps := maps; end if;
ProjectionFromActualMutation:
  call CalculateProjectionEffect(event,pre,post); projectionEffect := result;
  changed.linkedAssetMovesOrRemovals := linked;
  changed.targetSlotReferencesChanged := linksChanged;
  changed.graphObjectCsvChanged := csvChanged;
  changed.removedObjectChartIds := removedCharts;
  changed.appendedObjectChartIds := appended;
  result := ImmutableCopy([event |-> event,committed |-> TRUE,changed |-> changed,
    removedGraphReferenceCount |-> graphCount,resetImageSlotCount |-> imageCount,
    selectionHints |-> hints,projectionEffect |-> projectionEffect]); return;
end procedure;

procedure UncommittedUnchanged(event)
begin
  result := ImmutableCopy([event |-> event,committed |-> FALSE,changed |-> []]);
  return;
end procedure;

procedure ProjectStateMachine_send(event, payload)
variables source = NoValue, sourceState = NoValue, resolved = NoValue, calculation = NoValue,
          candidate = NoValue, transactionOutcome = NoValue, pre = NoValue, post = NoValue, i = 1,
          retainedOriginalIndicesByChart = [], assetFacts = <<>>;
begin
DeclaredMutationEntry:
  if event \notin PROJECT_COMMANDS then RejectDeclaredCommandUnchanged(event); end if;
  \* No Application-provided full candidate/model/current objects; only identities,
  \* new edit values/raw files and completed collision choices are admissible.
  assert DeclaredPayloadAndWritableScope(event, payload);
ReResolveCurrentAuthority:
  source := activeProject;
  sourceState := source._state;
  resolved := ResolveCommandInputsAndPreconditions(event, payload, sourceState);
  if resolved.rejected then call UncommittedUnchanged(event); return; end if;
CalculateWithoutAuthorityWrites:
  \* Mechanical exception/await adapter invokes CalculateSourceCommandCandidate
  \* exactly once for THIS attempt and observes returned noncommit versus throw.
  \* It is not a command engine, public envelope, persisted task, or second owner.
  transactionOutcome := AwaitSourceCalculationCapturingOnlyReturnOrThrow(
    CalculateSourceCommandCandidate,event,payload,sourceState);
DistinguishFailureFromSuccessfulCandidate:
  if transactionOutcome.threw then
    PropagateOriginalFailure(transactionOutcome.failure);
  end if;
RevalidateAfterFileWait:
  \* Domain calculation re-resolves current VFS/target/references/collision/next-id
  \* after its await and validates completed replace choices against same id/path.
  \* No UI resolver callback, silent rename/replace selection, partial write or rollback.
  if ~SameReference(activeProject,source) \/ ~SameReference(activeProject._state,sourceState) then
    goto ReResolveCurrentAuthority;
  end if;
  calculation := transactionOutcome.calculation;
  candidate := calculation.candidate;
  if candidate = NoValue then call UncommittedUnchanged(event); return; end if;
  retainedOriginalIndicesByChart := calculation.retainedOriginalIndicesByChart;
  assetFacts := calculation.assetFacts;
ValidateWholeCandidate:
  i := 1;
  while i <= Len(candidate.slots) do
    call normalizeSlotContent(candidate.slots[i]); candidate.slots[i] := result;
    i := i + 1;
  end while;
  call normalizeProjectSettings(candidate); candidate := result;
  call validateProjectObjectState(candidate, TRUE);
CommitExactlyOnce:
  \* Final freshness comparison + synchronous validated state replacement is ONE
  \* Source transaction boundary; implementation/optional verification must not
  \* introduce a yield/interleaving inside it. It is not a new lock/FSM/state.
  if ~SameReference(activeProject,source) \/ ~SameReference(activeProject._state,sourceState) then
    goto ReResolveCurrentAuthority;
  end if;
  pre := sourceState;
  call ProjectObject_initialize(candidate);
  post := activeProject._state;
FormActualImmutableResult:
  call buildProjectMutationResult(event,payload,pre,post,retainedOriginalIndicesByChart,assetFacts);
  \* Move uses the same validated chartId/from/to without intervening callbacks/commands.
  \* Rejection, same-position no-op and validation failure produce no success map.
  \* ActualSelectionHints uses same original-index filter/actual reference set:
  \* append -> actual append index; move -> full old-to-new map; edit -> same index;
  \* direct delete -> explicit none; palette/no hint -> omitted key.
  \* Cascade maps are recalculated on retry, include only affected retained charts,
  \* and exclude noneditable imported conversion views using graph validator scope.
  \* No Frontend state read/write, reconciliation, renderer invocation or extra commit.
ReturnMutationResult:
  return;
end procedure;

begin
ModuleDefinitions:
  skip;
end algorithm; *)
