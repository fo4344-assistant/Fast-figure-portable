---- MODULE FastFigureAssetsFilesPseudocode ----
EXTENDS Naturals, Sequences, FiniteSets

\* r18 PlusCal pseudocode for sourcescript/assets_files.py.
\* Persistent mutations are candidate-first and commit once after validation.

CONSTANT NoReference

(*
--algorithm FastFigureAssetsFiles
variables
  projectAuthority = ReadActiveProject(),
  candidate = NoReference,
  command = NoReference,
  result = NoReference;

procedure NormalizePath(value, isDirectory)
begin
NormalizeProjectPath:
  result := NormalizeSlashAbsoluteProjectPath(value, isDirectory);
PathSegments:
  assert ~ContainsDotOrDotDotSegment(result)
         /\ EveryPathSegmentUsesProjectNameRules(result);
NormalizePathReturn:
  return;
end procedure;

procedure AssetPath(asset)
begin
RecomputeAssetPath:
  result := JoinCanonicalAssetDirectoryAndName(asset.directory, asset.name);
AssetPathReturn:
  return;
end procedure;

procedure ResolveVfs(pathValue, state)
variables canonical = NoReference;
begin
ResolveNormalize:
  canonical := NormalizeProjectPathValue(pathValue);
ResolveUniqueVfsObject:
  result := ResolveUniqueDirectoryCsvOrImage(canonical, state);
ResolveVfsReturn:
  return;
end procedure;

procedure UniquePath(pathValue, reservedPaths)
begin
UniqueCandidate:
  result := CalculateCollisionFreePath(pathValue, projectAuthority, reservedPaths);
UniquePathReturn:
  return;
end procedure;

procedure Descendants(directory)
begin
DescendantCollect:
  result := CollectByCanonicalSegmentBoundary(directory, projectAuthority);
DescendantReturn:
  return;
end procedure;

procedure BuildImportCollision(file, directory, reservedPaths)
variables kind = NoReference, pathValue = NoReference;
begin
CollisionClassify:
  kind := ClassifyAssetFile(file);
CollisionCandidatePath:
  pathValue := CandidateAssetPath(file, directory);
CollisionDecision:
  if kind # NoReference /\ DirectoryExistsAndNotTrash(directory) then
    result := CollisionDecision(
      kind,
      pathValue,
      ResolveVfsAgainstProject(pathValue),
      reservedPaths);
  else
    result := NoReference;
  end if;
CollisionReturn:
  return;
end procedure;

procedure ResolveImportPlan(model, choice, reservedPaths)
begin
ResolvePlanBranch:
  if model.mode = "available" then
    result := [path |-> model.path, replaceId |-> NoReference];
  elsif choice = "replace" /\ model.replaceAllowed = TRUE then
    result := [path |-> model.path, replaceId |-> model.replaceId];
  else
    result := [
      path |-> CalculateCollisionFreePath(model.path, projectAuthority, reservedPaths),
      replaceId |-> NoReference
    ];
  end if;
ResolvePlanReturn:
  return;
end procedure;

procedure ParseDataAsset(name, bytes)
variables text = NoReference;
begin
ParseDecodeUtf8:
  text := DecodeUtf8(bytes);
ParseByFormat:
  if HasJsonExtension(name) then
    result := NormalizeJsonTopLevelOrDataArray(text);
  else
    result := ParseCsvOrTsvPreservingQuotedNewlinesAndBlankRows(name, text);
  end if;
ParseValidate:
  assert ValidTabularShape(result);
ParseReturn:
  return;
end procedure;

procedure CreateCsv(data, name, id, bytesBase64, mime, headerLines, pathValue)
begin
CreateCsvCandidate:
  candidate := NormalizeCsvAsset(data, name, id, bytesBase64, mime, headerLines, pathValue);
CreateCsvCommand:
  command := [name |-> "DATA_OBJECT_CREATED", asset |-> candidate];
CreateCsvResult:
  result := candidate;
CreateCsvReturn:
  return;
end procedure;

procedure CreateEmptyProjectCsv()
variables
  rows = <<<<"X", "Y">>, <<"", "">>>>,
  pathValue = NoReference;
begin
EmptyCsvPath:
  pathValue := CalculateCollisionFreePath(
    "/assets/csv/빈 CSV.csv",
    projectAuthority,
    {});
EmptyCsvCreate:
  call CreateCsv(
    rows,
    "빈 CSV.csv",
    NextProjectCsvId(),
    SerializeCsvRowsToUtf8Base64(rows),
    "text/csv",
    1,
    pathValue);
EmptyCsvOrdinaryAsset:
  assert ~HasProtectedOrDefaultCsvMarker(result);
EmptyCsvReturn:
  return;
end procedure;

procedure CreateImage(bytes, name, mime, id, pathValue)
begin
CreateImageCandidate:
  candidate := NormalizeImageAssetBytesNameMimeLocation(bytes, name, mime, id, pathValue);
CreateImageOwnership:
  assert ~ImageAssetContainsSlotDisplaySettings(candidate);
CreateImageCommand:
  command := [name |-> "IMAGE_OBJECT_CREATED", asset |-> candidate];
CreateImageResult:
  result := candidate;
CreateImageReturn:
  return;
end procedure;

procedure ImportBatch(files, directory, planImport)
begin
ImportTarget:
  assert DirectoryExistsAndNotTrash(directory);
ImportReadCandidates:
  candidate := ReadAndParseAllAssetCandidates(files);
ImportResolvePlans:
  candidate := ApplyCollisionPlans(candidate, planImport, projectAuthority);
ImportProjectCandidate:
  candidate := ApplyAssetsAndNextIdsToProject(candidate, projectAuthority);
ImportOptionalSlot:
  candidate := ApplyRequestedSlotImportCandidate(candidate);
ImportValidate:
  assert ValidateWholeProject(candidate);
ImportCommit:
  projectAuthority := candidate;
ImportResult:
  result := ImportResult(candidate);
ImportReturn:
  return;
end procedure;

procedure CollectReferences(csvIds, imageIds, state)
begin
CollectCsvReferences:
  result := CollectEveryGraphObjectReference(csvIds, state);
CollectImageReferences:
  result := AppendEveryImageSlotReference(result, imageIds, state);
CollectReferencesReturn:
  return;
end procedure;

procedure DeleteAsset(target)
variables asset = NoReference, refs = NoReference;
begin
DeleteResolveAsset:
  asset := ResolveCurrentAsset(target);
DeleteCollectReferences:
  if asset # NoReference then
    refs := CollectAssetReferences(asset, projectAuthority);
  end if;
DeleteBuildCandidate:
  if asset # NoReference then
    candidate := RemoveAssetAndDetachExactly(refs, asset, projectAuthority);
  end if;
DeleteValidate:
  if candidate # NoReference then
    assert ValidateWholeProject(candidate);
    projectAuthority := candidate;
    result := TRUE;
  end if;
DeleteReturn:
  return;
end procedure;

procedure PlanNodeMove(pathValue, directory)
variables source = NoReference;
begin
MovePlanResolveSource:
  source := ResolveVfs(pathValue, projectAuthority);
MovePlanEligibility:
  if source # NoReference /\ ~IsFixedProjectDirectory(source) then
    result := CalculateMovePlanFromCurrentVfs(pathValue, directory, projectAuthority);
  else
    result := NoReference;
  end if;
MovePlanTrashRule:
  assert source = NoReference
         \/ IsFixedProjectDirectory(source)
         \/ TreeMoveEligibilityIndependentOfTrashMembership(source);
MovePlanReturn:
  return;
end procedure;

procedure MoveNode(plan, useUniqueName)
variables fresh = NoReference;
begin
MoveReresolve:
  fresh := RebuildMovePlanFromCurrentProject(plan, projectAuthority);
MoveBuild:
  if fresh # NoReference then
    candidate := ApplyMoveDestination(fresh, useUniqueName, projectAuthority);
    if MoveEntersTrash(fresh) then
      candidate := DetachReferencesIfEnteringTrash(candidate);
    end if;
    if MoveLeavesTrash(fresh) then
      candidate := PreserveDetachedReferencesWithoutRestore(candidate);
    end if;
    candidate := MoveDescendantsIfDirectory(candidate);
  end if;
MoveValidate:
  if candidate # NoReference then
    assert ValidateMoveCollisionFixedCycleAndReferences(candidate);
    projectAuthority := candidate;
    result := FinalMovePath(candidate);
  end if;
MoveReturn:
  return;
end procedure;

procedure EmptyTrash()
variables trashObjects = NoReference, refs = NoReference;
begin
TrashResolve:
  trashObjects := ProjectVfsDescendants("/assets/trash", projectAuthority);
TrashReferences:
  refs := CollectReferencesForObjects(trashObjects, projectAuthority);
TrashBuild:
  candidate := RemoveTrashObjectsAndReferences(trashObjects, refs, projectAuthority);
TrashValidate:
  assert ValidateWholeProject(candidate);
TrashCommit:
  projectAuthority := candidate;
TrashResult:
  result := TrashRemovalResult(trashObjects, refs);
TrashReturn:
  return;
end procedure;

procedure EncodeTypedValue(value)
begin
EncodeTypedXml:
  result := RecursiveTypedXmlEncode(value);
EncodeTypeGuard:
  assert result # NoReference;
EncodeReturn:
  return;
end procedure;

procedure DecodeTypedValue(element)
begin
DecodeTypedXml:
  result := RecursiveTypedXmlDecode(element);
DecodeTypeGuard:
  assert DecodedTypedValueValid(result);
DecodeReturn:
  return;
end procedure;

procedure BuildFfpx()
begin
FfpxValidateProject:
  assert ValidateWholeProject(projectAuthority);
FfpxSnapshot:
  candidate := ReadProjectSnapshot(projectAuthority);
FfpxExcludeTrash:
  candidate := RemoveTrashFromExportSnapshot(candidate);
FfpxReferenceCheck:
  assert ExportReferencesResolve(candidate);
FfpxEncode:
  result := BuildFfpxEntriesWithTypedXmlAndCopiedBytes(candidate);
FfpxBuildReturn:
  return;
end procedure;

procedure ReadFfpx(file)
begin
FfpxContainer:
  assert ValidateStoreZipPathsCrcAndVersion(file);
FfpxDecode:
  candidate := DecodeRequiredTypedXmlDocuments(file);
FfpxRestoreAssets:
  candidate := RestoreAndParseReferencedAssetBytes(candidate, file);
FfpxReadResult:
  result := candidate;
FfpxReadReturn:
  return;
end procedure;

procedure BuildProjectObject(payload, fileName)
begin
ProjectImportHeader:
  assert ValidImportedProjectHeader(payload);
ProjectImportAssets:
  candidate := NormalizeImportedCsvImageCollections(payload);
ProjectImportCharts:
  candidate := NormalizeChartsAndResolveCsvReferences(candidate);
ProjectImportSlots:
  candidate := NormalizeSlotGeometryContentSettingsAndCaptions(candidate);
ProjectImportOwnership:
  assert EveryChartHasExactlyOneOwner(candidate);
ProjectImportPresentation:
  candidate := NormalizeLabelsCaptionsAppearanceExport(candidate);
ProjectImportNextIds:
  candidate := SetNextIdsAboveCollectionMaxima(candidate);
ProjectImportValidate:
  assert ValidateWholeProject(candidate);
ProjectImportResult:
  result := candidate;
ProjectImportReturn:
  return;
end procedure;

procedure ImportProject(file)
begin
ImportProjectRead:
  candidate := ReadFfpxCandidate(file);
ImportProjectBuild:
  candidate := BuildProjectObjectCandidate(candidate);
ImportProjectValidate:
  assert ValidateWholeProject(candidate);
ImportProjectCommand:
  command := [name |-> "PROJECT_LOADED", project |-> candidate];
ImportProjectReturn:
  return;
end procedure;

procedure BuildFfsx(slotValue, chart)
begin
FfsxCollectCsv:
  candidate := CollectOnlyChartReferencedCsv(slotValue, chart, projectAuthority);
FfsxRemapIds:
  candidate := RemapCsvAndGraphObjectIdsToPackageLocal(candidate);
FfsxEncode:
  result := BuildFfsxEntries(candidate);
FfsxBuildReturn:
  return;
end procedure;

procedure ReadFfsx(file)
begin
FfsxContainer:
  assert ValidateFfsxSchemaVersionAndEntries(file);
FfsxDecode:
  candidate := DecodeFfsxChartCaptionAndCsv(file);
FfsxReferences:
  assert ValidateFfsxGraphObjectCsvReferences(candidate);
FfsxChart:
  assert ValidateChartModel(candidate.chart);
FfsxReadResult:
  result := candidate;
FfsxReadReturn:
  return;
end procedure;

procedure ApplyFfsx(slotPayload, targetSlotId)
variables target = NoReference;
begin
FfsxTarget:
  target := ResolveSlot(targetSlotId, projectAuthority);
FfsxAllocateAssets:
  if target # NoReference then
    candidate := AllocateImportedCsvIdsAndPaths(slotPayload, projectAuthority);
    candidate := RemapFfsxChartToProjectCsv(candidate);
    candidate := AttachNewChartToTargetSlot(candidate, target);
    candidate := ApplyImportedSlotCaption(candidate, target);
  end if;
FfsxValidateCandidate:
  if candidate # NoReference then
    assert ValidateWholeProject(candidate);
    projectAuthority := candidate;
    result := FfsxCommitResult(candidate);
  end if;
FfsxApplyReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      call CreateEmptyProjectCsv();
    or
      with target = RequestedDeleteTarget() do
        call DeleteAsset(target);
      end with;
    or
      with plan = RequestedMovePlan(), unique = RequestedUniqueNameFlag() do
        call MoveNode(plan, unique);
      end with;
    or
      call EmptyTrash();
    end either;
  end while;
end algorithm;
*)
====
