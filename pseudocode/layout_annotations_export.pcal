---- MODULE FastFigureLayoutAnnotationsExportPseudocode ----
EXTENDS Naturals, Sequences, FiniteSets

\* Direct translation of sourcescript/layout_annotations_export.py.

CONSTANT NoReference

(*
--algorithm FastFigureLayoutAnnotationsExport
variables
  projectView = ReadActiveProject(),
  candidate = NoReference,
  snapshot = NoReference,
  result = NoReference;

procedure DashboardGeometry(width, heightOverride)
variables scale = 1, naturalHeight = 0, chosenHeight = 0;
begin
GeometryScale:
  scale := width / ReadReferenceWidth(projectView);
GeometryNaturalHeight:
  naturalHeight := width / ReadConfiguredAspect(projectView);
GeometryHeight:
  chosenHeight := IF ValidHeightOverride(heightOverride)
                  THEN heightOverride
                  ELSE naturalHeight;
GeometryResult:
  result := [
    width |-> width,
    height |-> chosenHeight,
    scale |-> scale,
    outerMargin |-> Min(
      ReadOuterMargin(projectView) * scale,
      Min(width, chosenHeight) * 0.49),
    gap |-> ReadGap(projectView) * scale,
    radius |-> ReadRadius(projectView) * scale
  ];
GeometryReturn:
  return;
end procedure;

procedure GridSlotGeometry(layoutState, geometry, slotValue)
variables colWidth = 0, rowHeight = 0;
begin
GridCellWidth:
  colWidth := (geometry.width - 2 * geometry.outerMargin
               - geometry.gap * (layoutState.gridCols - 1))
              / layoutState.gridCols;
GridCellHeight:
  rowHeight := (geometry.height - 2 * geometry.outerMargin
                - geometry.gap * (layoutState.gridRows - 1))
               / layoutState.gridRows;
GridSlotResult:
  result := SlotWidthHeightFromSpan(colWidth, rowHeight, geometry.gap, slotValue);
GridSlotReturn:
  return;
end procedure;

procedure SetLayoutStyle(values)
variables normalized = NoReference;
begin
LayoutStyleNormalize:
  normalized := NormalizeLayoutStyle(values, projectView);
LayoutStyleDispatch:
  if normalized # NoReference then
    result := ApplicationDispatchProjectCommand(
      "LAYOUT_STYLE_CHANGED",
      [style |-> normalized]);
    projectView := ReadActiveProject();
  end if;
LayoutStyleReturn:
  return;
end procedure;

procedure BuildGridResize(rows, cols)
begin
GridRequest:
  if ~(rows \in 1..8 /\ cols \in 1..8) then
    result := NoReference;
  else
    candidate := CopyProject(projectView);
    if rows >= projectView.layout.gridRows
       /\ cols >= projectView.layout.gridCols then
      candidate := AddDefaultSlotsOnlyAtNewCoordinates(candidate, rows, cols);
    else
      assert EveryRemovedOrCrossingSlotIsDefaultEmptyOneByOne(candidate, rows, cols);
      candidate := RemoveOnlyDefaultEmptyCells(candidate, rows, cols);
    end if;
    candidate := SetGridRowsCols(candidate, rows, cols);
    assert ValidateWholeProject(candidate);
    result := candidate;
  end if;
GridBuildReturn:
  return;
end procedure;

procedure SetGrid(rows, cols)
begin
GridBuild:
  call BuildGridResize(rows, cols);
GridDispatch:
  if result # NoReference then
    result := ApplicationDispatchProjectCommand(
      "GRID_LAYOUT_CHANGED",
      [rows |-> rows, cols |-> cols]);
    projectView := ReadActiveProject();
  end if;
GridSetReturn:
  return;
end procedure;

procedure MergeSlots(slotIds)
variables slots = NoReference;
begin
MergeResolve:
  slots := ResolveVisibleSlots(slotIds, projectView);
MergeRectangle:
  assert FormsCompleteRectangle(slots);
MergePayloadCount:
  assert Cardinality(NonDefaultLocalSlots(slots)) <= 1;
MergeBuild:
  candidate := CopyProject(projectView);
  candidate := MoveWholeLocalPayloadToTopLeftAnchor(candidate, slots);
  candidate := ResetCoveredSlotsToDefaultsAndHide(candidate, slots);
  candidate := SetAnchorRectangleSpan(candidate, slots);
MergeValidate:
  assert ValidateWholeProject(candidate);
MergeDispatch:
  result := ApplicationDispatchProjectCommand(
    "SLOTS_MERGED",
    [slotIds |-> slotIds]);
  projectView := ReadActiveProject();
MergeReturn:
  return;
end procedure;

procedure SplitSlots(slotIds)
variables anchors = NoReference;
begin
SplitResolve:
  anchors := ResolveRequestedMergedAnchors(slotIds, projectView);
SplitBuild:
  candidate := CopyProject(projectView);
  candidate := RestoreCoveredCellsAsVisibleDefaultSlots(candidate, anchors);
  candidate := ResetAnchorsToOneByOne(candidate, anchors);
SplitValidate:
  assert ValidateWholeProject(candidate);
SplitDispatch:
  result := ApplicationDispatchProjectCommand(
    "SLOTS_SPLIT",
    [slotIds |-> slotIds]);
  projectView := ReadActiveProject();
SplitReturn:
  return;
end procedure;

procedure ReadImageEditor()
begin
ImageEditorRead:
  result := ReadSelectedImageNameUrlAndSlotSettings(projectView);
ImageEditorReturn:
  return;
end procedure;

procedure SetImageSettings(values)
variables slotValue = NoReference;
begin
ImageSettingsResolve:
  slotValue := ResolveSelectedImageSlot(projectView);
ImageSettingsBuild:
  if slotValue # NoReference then
    candidate := UpdateOnlySelectedSlotImageSettings(
      projectView,
      slotValue,
      values);
  end if;
ImageSettingsDispatch:
  if candidate # NoReference then
    assert ValidateWholeProject(candidate);
    result := ApplicationDispatchProjectCommand(
      "SLOT_IMAGE_SETTINGS_CHANGED",
      [slotId |-> slotValue.id, settings |-> values]);
    projectView := ReadActiveProject();
  end if;
ImageSettingsReturn:
  return;
end procedure;

procedure ReadLabels()
begin
LabelsRead:
  result := ReadLabelSettings(projectView);
LabelsGeometry:
  result := AddSelectedSlotReferenceWidthHeight(result, projectView);
LabelsReadReturn:
  return;
end procedure;

procedure SetLabelEnabled(enabled)
begin
LabelEnabledDispatch:
  result := ApplicationDispatchProjectCommand(
    "LABEL_SETTINGS_CHANGED",
    [enabled |-> enabled]);
LabelEnabledRefresh:
  projectView := ReadActiveProject();
LabelEnabledReturn:
  return;
end procedure;

procedure SetLabelSettings(values)
variables normalized = NoReference;
begin
LabelSettingsNormalize:
  normalized := NormalizeLabelSettings(values, projectView);
LabelSettingsDispatch:
  result := ApplicationDispatchProjectCommand(
    "LABEL_SETTINGS_CHANGED",
    [settings |-> normalized]);
LabelSettingsRefresh:
  projectView := ReadActiveProject();
LabelSettingsReturn:
  return;
end procedure;

procedure SetLabelPosition(x, y)
begin
LabelPositionGuard:
  assert IsFinitePosition(x, y);
LabelPositionBuild:
  candidate := SetProjectLabelPosition(projectView, x, y);
LabelPositionValidate:
  assert ValidateWholeProject(candidate);
LabelPositionDispatch:
  result := ApplicationDispatchProjectCommand(
    "LABEL_POSITION_CHANGED",
    [x |-> x, y |-> y]);
LabelPositionRefresh:
  projectView := ReadActiveProject();
LabelPositionReturn:
  return;
end procedure;

procedure FinishLabelInteraction()
begin
LabelInteractionFinish:
  result := InteractionCompletionOnly();
LabelInteractionReturn:
  return;
end procedure;

procedure ReadGlobalCaption()
begin
GlobalCaptionRead:
  result := ReadProjectGlobalCaption(projectView);
GlobalCaptionReadReturn:
  return;
end procedure;

procedure ReadSlotCaption(slotId)
begin
SlotCaptionRead:
  result := ReadResolvedSlotIdPositionAndCaption(projectView, slotId);
SlotCaptionReadReturn:
  return;
end procedure;

procedure SetGlobalCaptionText(text)
begin
GlobalCaptionBuild:
  candidate := ReplaceOnlyGlobalCaptionText(projectView, text);
GlobalCaptionValidate:
  assert ValidateWholeProject(candidate);
GlobalCaptionDispatch:
  result := ApplicationDispatchProjectCommand(
    "CAPTION_TEXT_INPUT",
    [target |-> [kind |-> "global"], text |-> text]);
GlobalCaptionRefresh:
  projectView := ReadActiveProject();
GlobalCaptionReturn:
  return;
end procedure;

procedure SetSlotCaption(slotId, text)
begin
SlotCaptionBuild:
  candidate := SetResolvedSlotCaptionCandidate(projectView, slotId, text);
SlotCaptionDispatch:
  if candidate # NoReference /\ ValidateWholeProject(candidate) then
    result := ApplicationDispatchProjectCommand(
      "CAPTION_TEXT_INPUT",
      [target |-> [kind |-> "slot", id |-> slotId], text |-> text]);
    projectView := ReadActiveProject();
  end if;
SlotCaptionReturn:
  return;
end procedure;

procedure InsertSlotCaptions(slotIds)
variables slots = NoReference, projectedText = "";
begin
InsertCaptionResolve:
  slots := ResolveSlotsInLayoutOrder(slotIds, projectView);
InsertCaptionProjection:
  projectedText := ProjectNonEmptySlotCaptions(slots);
InsertCaptionBuild:
  candidate := InsertIntoGlobalCaption(projectView, projectedText);
InsertCaptionValidate:
  assert ValidateWholeProject(candidate);
InsertCaptionDispatch:
  result := ApplicationDispatchProjectCommand(
    "SLOT_CAPTIONS_INSERTED",
    [slotIds |-> slotIds, projectedText |-> projectedText]);
InsertCaptionRefresh:
  projectView := ReadActiveProject();
InsertCaptionReturn:
  return;
end procedure;

procedure SetCaptionEnabled(enabled)
begin
CaptionEnabledDispatch:
  result := ApplicationDispatchProjectCommand(
    "CAPTION_SETTINGS_CHANGED",
    [enabled |-> enabled]);
CaptionEnabledRefresh:
  projectView := ReadActiveProject();
CaptionEnabledReturn:
  return;
end procedure;

procedure SetCaptionName(name)
begin
CaptionNameDispatch:
  result := ApplicationDispatchProjectCommand(
    "CAPTION_SETTINGS_CHANGED",
    [name |-> name]);
CaptionNameRefresh:
  projectView := ReadActiveProject();
CaptionNameReturn:
  return;
end procedure;

procedure SetCaptionNameBold(nameBold)
begin
CaptionNameBoldDispatch:
  result := ApplicationDispatchProjectCommand(
    "CAPTION_SETTINGS_CHANGED",
    [nameBold |-> nameBold]);
CaptionNameBoldRefresh:
  projectView := ReadActiveProject();
CaptionNameBoldReturn:
  return;
end procedure;

procedure SetCaptionSettings(values)
variables normalized = NoReference;
begin
CaptionSettingsNormalize:
  normalized := NormalizeCaptionSettings(values, projectView);
CaptionSettingsDispatch:
  result := ApplicationDispatchProjectCommand(
    "CAPTION_SETTINGS_CHANGED",
    [settings |-> normalized]);
CaptionSettingsRefresh:
  projectView := ReadActiveProject();
CaptionSettingsReturn:
  return;
end procedure;

procedure ReadExportSettings()
begin
ExportSettingsRead:
  result := ReadProjectExportSettings(projectView);
ExportSettingsReadReturn:
  return;
end procedure;

procedure SetExportSettings(values)
begin
ExportSettingsBuild:
  candidate := NormalizeExportSettings(projectView, values);
ExportSettingsValidate:
  assert ValidateWholeProject(candidate);
ExportSettingsDispatch:
  result := ApplicationDispatchProjectCommand(
    "EXPORT_SETTINGS_CHANGED",
    [settings |-> candidate]);
ExportSettingsRefresh:
  projectView := ReadActiveProject();
ExportSettingsReturn:
  return;
end procedure;

procedure CreateExportSnapshot()
begin
ExportSnapshotRead:
  snapshot := SnapshotProjectObjects(projectView);
ExportSnapshotGeometry:
  snapshot := AddTargetGeometryFromPersistentExportSettings(snapshot);
ExportSnapshotResult:
  result := snapshot;
ExportSnapshotReturn:
  return;
end procedure;

procedure ExportTarget()
begin
ExportTargetSnapshot:
  call CreateExportSnapshot();
ExportTargetCopy:
  snapshot := result;
ExportTargetHeight:
  snapshot := ResolveAutoOrExplicitHeight(snapshot);
ExportTargetLimits:
  if ~WithinRasterLimits(snapshot) then
    result := [status |-> "rejected"];
  else
    snapshot := RenderVisibleChartsImagesLabelsCaptions(snapshot);
    result := EncodeRasterWithDpiAndDownload(snapshot);
  end if;
ExportTargetReturn:
  return;
end procedure;

procedure CaptureCurrent()
begin
CaptureViewport:
  snapshot := ReadRenderedViewportForOneShotCapture();
CaptureEncoding:
  snapshot := AddPersistentDpiAndFormatDefaults(snapshot, projectView);
CaptureResult:
  result := EncodeRasterAndDownload(snapshot);
CaptureReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with style = RequestedLayoutStyle() do
        call SetLayoutStyle(style);
      end with;
    or
      with rows = RequestedRows(), cols = RequestedCols() do
        call SetGrid(rows, cols);
      end with;
    or
      with ids = RequestedSlotIds() do
        call MergeSlots(ids);
      end with;
    or
      with ids = RequestedSlotIds() do
        call SplitSlots(ids);
      end with;
    or
      with values = RequestedImageSettings() do
        call SetImageSettings(values);
      end with;
    or
      with enabled = RequestedLabelEnabled() do
        call SetLabelEnabled(enabled);
      end with;
    or
      with values = RequestedLabelSettings() do
        call SetLabelSettings(values);
      end with;
    or
      with x = RequestedLabelX(), y = RequestedLabelY() do
        call SetLabelPosition(x, y);
      end with;
    or
      with text = RequestedGlobalCaptionText() do
        call SetGlobalCaptionText(text);
      end with;
    or
      with slotId = RequestedCaptionSlotId(), text = RequestedSlotCaptionText() do
        call SetSlotCaption(slotId, text);
      end with;
    or
      with ids = RequestedSlotCaptionInsertIds() do
        call InsertSlotCaptions(ids);
      end with;
    or
      with enabled = RequestedCaptionEnabled() do
        call SetCaptionEnabled(enabled);
      end with;
    or
      with name = RequestedCaptionName() do
        call SetCaptionName(name);
      end with;
    or
      with nameBold = RequestedCaptionNameBold() do
        call SetCaptionNameBold(nameBold);
      end with;
    or
      with values = RequestedCaptionSettings() do
        call SetCaptionSettings(values);
      end with;
    or
      with values = RequestedExportSettings() do
        call SetExportSettings(values);
      end with;
    or
      call ExportTarget();
    or
      call CaptureCurrent();
    end either;
  end while;
end algorithm;
*)
