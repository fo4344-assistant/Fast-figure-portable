---- MODULE FastFigureLayoutAnnotationsExportPseudocode ----
EXTENDS Naturals, Sequences, FiniteSets

\* r16 PlusCal pseudocode for sourcescript/layout_annotations_export.py.

CONSTANT NoReference

(*
--algorithm FastFigureLayoutAnnotationsExport
variables
  projectAuthority = ReadActiveProject(),
  candidate = NoReference,
  snapshot = NoReference,
  result = NoReference;

procedure DashboardGeometry(width, heightOverride)
variables scale = 1, naturalHeight = 0, chosenHeight = 0;
begin
GeometryScale:
  scale := width / ReadReferenceWidth(projectAuthority);
GeometryNaturalHeight:
  naturalHeight := width / ReadConfiguredAspect(projectAuthority);
GeometryHeight:
  chosenHeight := IF ValidHeightOverride(heightOverride)
                  THEN heightOverride
                  ELSE naturalHeight;
GeometryResult:
  result := [
    width |-> width,
    height |-> chosenHeight,
    scale |-> scale,
    outerMargin |-> Min(
      ReadOuterMargin(projectAuthority) * scale,
      Min(width, chosenHeight) * 0.49),
    gap |-> ReadGap(projectAuthority) * scale,
    radius |-> ReadRadius(projectAuthority) * scale
  ];
GeometryReturn:
  return;
end procedure;

procedure GridSlotGeometry(layoutState, geometry, slotValue)
variables colWidth = 0, rowHeight = 0;
begin
GridCellWidth:
  colWidth := (geometry.width - 2 * geometry.outerMargin
               - geometry.gap * (layoutState.gridCols - 1))
              / layoutState.gridCols;
GridCellHeight:
  rowHeight := (geometry.height - 2 * geometry.outerMargin
                - geometry.gap * (layoutState.gridRows - 1))
               / layoutState.gridRows;
GridSlotResult:
  result := SlotWidthHeightFromSpan(colWidth, rowHeight, geometry.gap, slotValue);
GridSlotReturn:
  return;
end procedure;

procedure BuildGridResize(rows, cols)
begin
GridRequest:
  if ~(rows \in 1..8 /\ cols \in 1..8) then
    result := NoReference;
  else
    candidate := CopyProject(projectAuthority);
    if rows >= projectAuthority.layout.gridRows
       /\ cols >= projectAuthority.layout.gridCols then
      candidate := AddDefaultSlotsOnlyAtNewCoordinates(candidate, rows, cols);
    else
      assert EveryRemovedOrCrossingSlotIsDefaultEmptyOneByOne(candidate, rows, cols);
      candidate := RemoveOnlyDefaultEmptyCells(candidate, rows, cols);
    end if;
    candidate := SetGridRowsCols(candidate, rows, cols);
    assert ValidateWholeProject(candidate);
    result := candidate;
  end if;
GridBuildReturn:
  return;
end procedure;

procedure SetGrid(rows, cols)
begin
GridBuild:
  call BuildGridResize(rows, cols);
GridCommit:
  if result # NoReference then
    projectAuthority := result;
    result := GridCommitMutationResult(projectAuthority);
  end if;
GridSetReturn:
  return;
end procedure;

procedure MergeSlots(slotIds)
variables slots = NoReference;
begin
MergeResolve:
  slots := ResolveVisibleSlots(slotIds, projectAuthority);
MergeRectangle:
  assert FormsCompleteRectangle(slots);
MergePayloadCount:
  assert Cardinality(NonDefaultLocalSlots(slots)) <= 1;
MergeBuild:
  candidate := CopyProject(projectAuthority);
  candidate := MoveWholeLocalPayloadToTopLeftAnchor(candidate, slots);
  candidate := ResetCoveredSlotsToDefaultsAndHide(candidate, slots);
  candidate := SetAnchorRectangleSpan(candidate, slots);
MergeValidate:
  assert ValidateWholeProject(candidate);
MergeCommit:
  projectAuthority := candidate;
MergeResult:
  result := MergeResult(candidate);
MergeReturn:
  return;
end procedure;

procedure SplitSlots(slotIds)
variables anchors = NoReference;
begin
SplitResolve:
  anchors := ResolveRequestedMergedAnchors(slotIds, projectAuthority);
SplitBuild:
  candidate := CopyProject(projectAuthority);
  candidate := RestoreCoveredCellsAsVisibleDefaultSlots(candidate, anchors);
  candidate := ResetAnchorsToOneByOne(candidate, anchors);
SplitValidate:
  assert ValidateWholeProject(candidate);
SplitCommit:
  projectAuthority := candidate;
SplitResult:
  result := SplitResult(candidate);
SplitReturn:
  return;
end procedure;

procedure ReadImageEditor()
begin
ImageEditorRead:
  result := ReadSelectedImageNameUrlAndSlotSettings(projectAuthority);
ImageEditorReturn:
  return;
end procedure;

procedure SetImageSettings(values)
variables slotValue = NoReference;
begin
ImageSettingsResolve:
  slotValue := ResolveSelectedImageSlot(projectAuthority);
ImageSettingsBuild:
  if slotValue # NoReference then
    candidate := UpdateOnlySelectedSlotImageSettings(
      projectAuthority,
      slotValue,
      values);
  end if;
ImageSettingsCommit:
  if candidate # NoReference then
    assert ValidateWholeProject(candidate);
    projectAuthority := candidate;
    result := ReadImageEditorProjection(projectAuthority, slotValue.id);
  end if;
ImageSettingsReturn:
  return;
end procedure;

procedure ReadLabels()
begin
LabelsRead:
  result := ReadLabelSettings(projectAuthority);
LabelsGeometry:
  result := AddSelectedSlotReferenceWidthHeight(result, projectAuthority);
LabelsReadReturn:
  return;
end procedure;

procedure SetLabelPosition(x, y)
begin
LabelPositionGuard:
  assert IsFinitePosition(x, y);
LabelPositionBuild:
  candidate := SetProjectLabelPosition(projectAuthority, x, y);
LabelPositionValidate:
  assert ValidateWholeProject(candidate);
LabelPositionCommit:
  projectAuthority := candidate;
LabelPositionResult:
  result := ReadLabelProjection(projectAuthority);
LabelPositionReturn:
  return;
end procedure;

procedure FinishLabelInteraction()
begin
LabelInteractionFinish:
  result := InteractionCompletionOnly();
LabelInteractionReturn:
  return;
end procedure;

procedure ReadGlobalCaption()
begin
GlobalCaptionRead:
  result := ReadProjectGlobalCaption(projectAuthority);
GlobalCaptionReadReturn:
  return;
end procedure;

procedure ReadSlotCaption(slotId)
begin
SlotCaptionRead:
  result := ReadResolvedSlotIdPositionAndCaption(projectAuthority, slotId);
SlotCaptionReadReturn:
  return;
end procedure;

procedure SetGlobalCaptionText(text)
begin
GlobalCaptionBuild:
  candidate := ReplaceOnlyGlobalCaptionText(projectAuthority, text);
GlobalCaptionValidate:
  assert ValidateWholeProject(candidate);
GlobalCaptionCommit:
  projectAuthority := candidate;
GlobalCaptionResult:
  result := ReadProjectGlobalCaption(projectAuthority);
GlobalCaptionReturn:
  return;
end procedure;

procedure SetSlotCaption(slotId, text)
begin
SlotCaptionBuild:
  candidate := SetResolvedSlotCaptionCandidate(projectAuthority, slotId, text);
SlotCaptionCommit:
  if candidate # NoReference /\ ValidateWholeProject(candidate) then
    projectAuthority := candidate;
    result := ReadResolvedSlotIdPositionAndCaption(projectAuthority, slotId);
  end if;
SlotCaptionReturn:
  return;
end procedure;

procedure InsertSlotCaptions(slotIds)
variables slots = NoReference, projectedText = "";
begin
InsertCaptionResolve:
  slots := ResolveSlotsInLayoutOrder(slotIds, projectAuthority);
InsertCaptionProjection:
  projectedText := ProjectNonEmptySlotCaptions(slots);
InsertCaptionBuild:
  candidate := InsertIntoGlobalCaption(projectAuthority, projectedText);
InsertCaptionValidate:
  assert ValidateWholeProject(candidate);
InsertCaptionCommit:
  projectAuthority := candidate;
InsertCaptionResult:
  result := ReadProjectGlobalCaption(projectAuthority);
InsertCaptionReturn:
  return;
end procedure;

procedure ReadExportSettings()
begin
ExportSettingsRead:
  result := ReadProjectExportSettings(projectAuthority);
ExportSettingsReadReturn:
  return;
end procedure;

procedure SetExportSettings(values)
begin
ExportSettingsBuild:
  candidate := NormalizeExportSettings(projectAuthority, values);
ExportSettingsValidate:
  assert ValidateWholeProject(candidate);
ExportSettingsCommit:
  projectAuthority := candidate;
ExportSettingsResult:
  result := ReadProjectExportSettings(projectAuthority);
ExportSettingsReturn:
  return;
end procedure;

procedure CreateExportSnapshot()
begin
ExportSnapshotRead:
  snapshot := SnapshotProjectObjects(projectAuthority);
ExportSnapshotGeometry:
  snapshot := AddTargetGeometryFromPersistentExportSettings(snapshot);
ExportSnapshotResult:
  result := snapshot;
ExportSnapshotReturn:
  return;
end procedure;

procedure ExportTarget()
begin
ExportTargetSnapshot:
  call CreateExportSnapshot();
ExportTargetCopy:
  snapshot := result;
ExportTargetHeight:
  snapshot := ResolveAutoOrExplicitHeight(snapshot);
ExportTargetLimits:
  if ~WithinRasterLimits(snapshot) then
    result := [status |-> "rejected"];
  else
    snapshot := RenderVisibleChartsImagesLabelsCaptions(snapshot);
    result := EncodeRasterWithDpiAndDownload(snapshot);
  end if;
ExportTargetReturn:
  return;
end procedure;

procedure CaptureCurrent()
begin
CaptureViewport:
  snapshot := ReadRenderedViewportForOneShotCapture();
CaptureEncoding:
  snapshot := AddPersistentDpiAndFormatDefaults(snapshot, projectAuthority);
CaptureResult:
  result := EncodeRasterAndDownload(snapshot);
CaptureReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with rows = RequestedRows(), cols = RequestedCols() do
        call SetGrid(rows, cols);
      end with;
    or
      with ids = RequestedSlotIds() do
        call MergeSlots(ids);
      end with;
    or
      with ids = RequestedSlotIds() do
        call SplitSlots(ids);
      end with;
    or
      call ExportTarget();
    or
      call CaptureCurrent();
    end either;
  end while;
end algorithm;
*)
====
