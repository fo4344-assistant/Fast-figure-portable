---- MODULE FastFigureInterfaceFsmPseudocode ----
EXTENDS Naturals, Sequences

\* Direct translation of Source Script r25 sourcescript/interface_fsm.py.
\* Frontend runtime authority consumes validated/reconciliation inputs and never reads Backend state.

CONSTANT NoSelection

(*
--algorithm FastFigureInterfaceFsm
variables
  lifecycle = "booting",
  workspace = "project",
  overlay = "none",
  assetSelection = "none",
  assetPath = NoSelection,
  graphObject = "none",
  graphObjectIndex = NoSelection,
  direction = "model-to-ui",
  revision = 0,
  error = NoSelection,
  selectedSlotId = NoSelection,
  result = NoSelection,
  effect = NoSelection;

procedure PublishState()
begin
PublishRevision:
  revision := revision + 1;
PublishReturn:
  return;
end procedure;

procedure ReadState()
begin
ReadStateProjection:
  result := [
    lifecycle |-> lifecycle,
    workspace |-> workspace,
    overlay |-> overlay,
    assetSelection |-> assetSelection,
    assetPath |-> assetPath,
    graphObject |-> graphObject,
    graphObjectIndex |-> graphObjectIndex,
    direction |-> direction,
    revision |-> revision,
    error |-> error,
    selectedSlotId |-> selectedSlotId
  ];
ReadStateReturn:
  return;
end procedure;

procedure SelectSlot(validatedInput)
begin
SelectSlotAccepted:
  if validatedInput.accepted then
    if validatedInput.reference = NoSelection then
      selectedSlotId := NoSelection ||
      graphObject := "none" ||
      graphObjectIndex := NoSelection ||
      workspace := "project";
    elsif validatedInput.selectionHint = "toggle-clear"
          /\ selectedSlotId = validatedInput.reference then
      selectedSlotId := NoSelection ||
      graphObject := "none" ||
      graphObjectIndex := NoSelection ||
      workspace := "project";
    else
      selectedSlotId := validatedInput.reference ||
      workspace := validatedInput.workspaceHint;
      if validatedInput.selectionHint = "clear-graph-object" then
        graphObject := "none" ||
        graphObjectIndex := NoSelection;
      end if;
    end if;
    call PublishState();
  end if;
SelectSlotReturn:
  return;
end procedure;

procedure SelectAsset(validatedInput)
begin
SelectAssetAccepted:
  if validatedInput.accepted then
    graphObject := "none" ||
    graphObjectIndex := NoSelection;
    if validatedInput.reference = NoSelection then
      assetSelection := "none" ||
      assetPath := NoSelection;
    else
      assetSelection := validatedInput.selectionHint ||
      assetPath := validatedInput.reference;
    end if;
    call PublishState();
  end if;
SelectAssetReturn:
  return;
end procedure;

procedure SelectGraphObject(validatedInput)
begin
SelectGraphAccepted:
  if validatedInput.accepted then
    if validatedInput.reference = NoSelection then
      graphObject := "none" ||
      graphObjectIndex := NoSelection;
    else
      graphObject := "selected" ||
      graphObjectIndex := validatedInput.reference ||
      assetSelection := "csv" ||
      assetPath := validatedInput.selectionHint;
    end if;
    call PublishState();
  end if;
SelectGraphReturn:
  return;
end procedure;

procedure TransitionOverlay(eventName, validatedInput)
begin
OverlayTransition:
  if validatedInput.accepted then
    overlay := ResolveFrontendOverlayTarget(overlay, eventName, validatedInput);
    call PublishState();
  end if;
OverlayReturn:
  return;
end procedure;

procedure TransitionLifecycle(eventName, validatedInput)
begin
LifecycleTransition:
  if validatedInput.accepted then
    if eventName = "LIFECYCLE_START" then
      lifecycle := validatedInput.reference ||
      error := NoSelection;
    elsif eventName = "LIFECYCLE_COMPLETE" then
      lifecycle := "ready" ||
      error := NoSelection;
    elsif eventName = "LIFECYCLE_FAILED" then
      error := validatedInput.reference ||
      lifecycle := "error";
    end if;
    call PublishState();
  end if;
LifecycleReturn:
  return;
end procedure;

procedure Send(eventName, validatedInput)
begin
SendValidatedInput:
  assert IsFrontendValidatedOrLocalInput(eventName, validatedInput);
SendDispatch:
  if eventName = "SELECT_SLOT" then
    call SelectSlot(validatedInput);
  elsif eventName = "SELECT_ASSET" then
    call SelectAsset(validatedInput);
  elsif eventName = "CLEAR_ASSET_SELECTION" then
    assetSelection := "none" ||
    assetPath := NoSelection;
    call PublishState();
  elsif eventName = "SELECT_GRAPH_OBJECT" then
    call SelectGraphObject(validatedInput);
  elsif eventName = "CLEAR_GRAPH_OBJECT" then
    graphObject := "none" ||
    graphObjectIndex := NoSelection;
    call PublishState();
  elsif eventName = "TOGGLE_OVERLAY"
        \/ eventName = "CLOSE_OVERLAY"
        \/ eventName = "OUTSIDE_CLICK"
        \/ eventName = "ESCAPE" then
    call TransitionOverlay(eventName, validatedInput);
  elsif eventName = "LIFECYCLE_START"
        \/ eventName = "LIFECYCLE_COMPLETE"
        \/ eventName = "LIFECYCLE_FAILED" then
    call TransitionLifecycle(eventName, validatedInput);
  end if;
SendNoBackendAccess:
  assert BackendAuthorityUnchangedAndUnreadByFrontendFsm();
SendResult:
  call ReadState();
SendReturn:
  return;
end procedure;

procedure ReconcileProjectResult(eventName, reconciliationInput)
begin
ReconcileInput:
  assert IsFrontendReconciliationInput(reconciliationInput);
ReconcileSlot:
  selectedSlotId := ReconciledReferenceOrClear(
    selectedSlotId,
    reconciliationInput.selectedSlot
  );
ReconcileAsset:
  assetPath := ReconciledReferenceOrClear(
    assetPath,
    reconciliationInput.assetSelection
  ) ||
  assetSelection := ReconciledAssetKindOrNone(
    assetSelection,
    reconciliationInput.assetSelection
  );
ReconcileGraph:
  graphObjectIndex := ReconciledReferenceOrClear(
    graphObjectIndex,
    reconciliationInput.graphObject
  ) ||
  graphObject := IF graphObjectIndex = NoSelection THEN "none" ELSE "selected";
ReconcileWorkspace:
  workspace := reconciliationInput.workspaceHint;
ReconcileNoProjectMutation:
  assert ProjectAuthorityUnchangedByInterfaceReconciliation();
ReconcilePublish:
  call PublishState();
ReconcileResult:
  call ReadState();
ReconcileReturn:
  return;
end procedure;

procedure Notify(objectName, eventName, payload)
begin
NotifyProjectionOnly:
  direction := "model-to-ui" ||
  effect := FrontendProjectionNotification(objectName, eventName, payload);
NotifyPublish:
  call PublishState();
NotifyReturn:
  return;
end procedure;

begin
Main:
  while TRUE do
    either
      with request = NextValidatedInterfaceEvent() do
        call Send(request.event, request.validatedInput);
      end with;
    or
      with reconciliation = NextFrontendReconciliationInput() do
        call ReconcileProjectResult(reconciliation.event, reconciliation.input);
      end with;
    end either;
  end while;
end algorithm;
*)
====
