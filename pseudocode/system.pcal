---- MODULE FastFigureSystemPseudocode ----
EXTENDS Naturals

\* Direct translation of Source Script r25 sourcescript/system.py.
\* Semantic children are Backend, Application boundary, Frontend, and Portable build.
\* Runtime load order is physical and does not flatten that hierarchy.

CONSTANT NoValue

(*
--algorithm FastFigureSystem
variables
  activeProject = NoValue,
  coreRuntime = "uninitialized",
  interfaceLifecycle = "booting",
  apiExposed = FALSE,
  projectProjection = NoValue,
  finalInterfaceState = NoValue,
  mantineMounted = FALSE,
  result = NoValue,
  effect = NoValue;

procedure InitializeFastFigure()
variables projectCandidate = NoValue;
begin
InitializeProjectCandidate:
  projectCandidate := CreateProjectState();
InitializeProjectValidate:
  assert ValidateWholeProject(projectCandidate);
InitializeProjectCommit:
  activeProject := projectCandidate;
InitializeRendererHosts:
  assert RequiredRendererHostsExist();
InitializeDashboardProjection:
  effect := ApplyDashboardZoomProjection();
InitializeSlotController:
  effect := InstallSlotInteractionController(ApplicationPublicActionSurface());
InitializeRendererInputs:
  finalInterfaceState := ReadFrontendStateProjection() ||
  projectProjection := ApplicationDispatchProjectQuery("renderer", finalInterfaceState);
InitializeRender:
  effect := RenderDashboardFrom(projectProjection, finalInterfaceState);
InitializeStyle:
  effect := ApplySlotStyleFrom(projectProjection);
InitializeReady:
  effect := ApplicationDispatchInterfaceEvent("LIFECYCLE_COMPLETE", [accepted |-> TRUE]) ||
  interfaceLifecycle := "ready";
InitializeWorkspace:
  effect := SynchronizeInitialWorkspaceAndOverlay();
InitializeApi:
  apiExposed := TRUE;
InitializeMantine:
  effect := MountMantineProviderAndShell();
InitializeMantineState:
  mantineMounted := TRUE;
InitializeNoSyntheticData:
  assert NoDefaultCsvOrFakeGraphObjectWasCreated(activeProject);
InitializeAudit:
  assert AuditProjectReferenceRuntimeInvariants();
InitializeResult:
  coreRuntime := "ready" ||
  result := "initialized";
InitializeReturn:
  return;
end procedure;

begin
Main:
  call InitializeFastFigure();
end algorithm;
*)
