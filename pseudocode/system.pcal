---- MODULE FastFigureSystemR38 ----
EXTENDS Sequences

\* Direct Source Script translation; Plan027 supplements current-authority display/input procedures.
\* Hierarchy: Backend / Application boundary / Frontend / Portable build.
\* No new system FSM. Qualified imported methods use '_' mechanically.
\* activeProject below is an imported Backend binding, NOT a copied authority.
\* projection/actions/interfaceState/result are startup-call-local values.
\* Debug clicks synchronously read renderer-owned debugEnabled via readDebugEnabled,
\* invert into existing setDebugEnabled, then display one-way telemetry; never invert telemetry.
CONSTANT NoValue

(* --algorithm FastFigureSystem
variables result = NoValue;

procedure initializeFastFigure()
variables candidate = NoValue, projectProjection = NoValue,
          interfaceState = NoValue, frontendActions = NoValue,
          coreRuntime = NoValue, uiMount = NoValue;
begin
RequireCoreAndHosts:
  assert RequiredRendererHostsAndStylesExist() /\ PlotlyRuntimeReady() /\ ReactMantineRuntimeReady();
CreateValidatedInitialProject:
  call createProjectState();
  candidate := result;
  call ProjectObject_create(candidate);
  \* Adopt only the successfully constructed instance; this is the imported sole binding.
  activeProject := result;
ExposeExistingBoundary:
  ExposeFastFigureApi(FastFigureApi);
  \* Public actions exist before their renderer/startup consumers.
PrepareBoundaryInputs:
  \* Application obtains the initial read input BEFORE its Frontend consumer.
  \* This is the supplied input of renderer.startupCoreRuntime, not a system mirror.
  call dispatchProjectQuery("renderer", []);
  projectProjection := result;
  call InterfaceStateMachine_readState();
  interfaceState := result;
  frontendActions := PublicActionSurface(FastFigureApi);
PrepareAndRenderCore:
  \* Directly reuse renderer.startupCoreRuntime's Source-defined order:
  \* zoom -> controllers -> existing visible slots -> supplied slot style -> audit.
  call startupCoreRuntime(projectProjection, interfaceState, frontendActions);
  coreRuntime := result;
ReadyThroughApplication:
  call dispatchInterfaceEvent("LIFECYCLE_COMPLETE", []);
MountExistingUi:
  uiMount := MountMantineProviderAndFastFigureShellAtExistingReactRoot();
AuditStartup:
  \* Startup does not create default CSV/fake objects or reconstruct grid data.
  AuditProjectReferenceRuntimeInvariantsThroughTheirOwners();
  \* A startup-call-local runtime value containing the supplied Application actions,
  \* returned core/controller runtime and the one UI mount; concrete platform handles
  \* are represented symbolically, with no new project or session authority.
  result := InitializedRuntimeConfiguration(frontendActions,coreRuntime,uiMount);
  return;
end procedure;

begin
Startup:
  call initializeFastFigure();
end algorithm; *)
