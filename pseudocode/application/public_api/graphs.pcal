procedure exportSelectedGraph(slotId,operation)
variables payload = NoValue;
begin
SemanticFigureOrSlotPackageQuery:
  call dispatchProjectQuery("export",[operation |-> operation,slotId |-> slotId,stamp |-> CurrentUtcIsoTimestamp()]); payload := result;
  if payload = NoValue then result := NoValue; return; end if;
  call downloadExportPayload(payload);
  \* downloadExportPayload side-effect return remains None, not disk confirmation.
  return;
end procedure;

