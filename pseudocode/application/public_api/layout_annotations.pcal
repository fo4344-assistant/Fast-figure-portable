  if state.selectedSlotId = slotId then result := TRUE; return; end if;
  call dispatchSlotSelection(slotId,NoValue,"model-to-fsm");
  result := result[1].selectedSlotId = slotId;
  \* No content-type command or duplicate stored target; same-id never toggles.
