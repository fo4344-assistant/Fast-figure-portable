  call dispatchProjectCommand("SLOT_IMAGE_IMPORTED",[slotId |-> slotId,operation |-> "images.insertEmpty",imageInput |-> svg]); tuple := result;
  if ~tuple[1].committed then result := NoValue; return; end if;
  call dispatchProjectQuery("project-api",[operation |-> "assets.readDeletionTarget",path |-> ActualCreatedImagePath(tuple[1].changed)]);
  result := result.target;
