---- MODULE FastFigureGraphsPseudocode ----
EXTENDS Naturals, Sequences

\* r13 translation of sourcescript/graphs.py.
\* Project/chart writes are emitted through existing mutation commands.
CONSTANTS NoReference

(*
--algorithm FastFigureGraphs {
  variables selectedSlot = NoReference,
            selectedCsv = NoReference,
            selectedObjectIndex = NoReference,
            chartCandidate = NoReference,
            projectCandidate = NoReference,
            command = NoReference,
            result = NoReference;

  procedure AddGraphObject(csvId) {
  ResolveAddInputs:
    with (slot = ResolveSelectedSlot(),
          csv = ResolveProjectCsv(csvId)) {
      if (slot # NoReference /\ csv # NoReference) {
        if (slot.chart = NoReference) {
        BuildFirstObjectCandidate:
          chartCandidate := ConnectDataToSlotCandidate(slot, csv);
        EmitSlotDataConnect:
          command := [
            name |-> "SLOT_DATA_CONNECTED",
            slotId |-> slot.id,
            csvId |-> csv.id
          ];
        } else {
        ResolveOwnedChart:
          with (chart = ResolveChart(slot.chart)) {
            if (chart # NoReference /\ chart.editor.editable = TRUE) {
            BuildAppendCandidate:
              chartCandidate := AppendBaseGraphObject(chart, csv);
            ValidateAppendCandidate:
              assert ValidateChartModel(chartCandidate);
            EmitObjectReplacement:
              command := [
                name |-> "GRAPH_OBJECTS_REPLACED",
                chartId |-> chart.id,
                objects |-> chartCandidate.editor.objects
              ];
            };
          };
        };
      };
    };
    return;
  }

  procedure CommitGraphObjects(objects, requestedIndex) {
  ResolveCommitChart:
    with (chart = ResolveSelectedChart()) {
      if (chart # NoReference /\ chart.editor.editable = TRUE) {
      NormalizeObjects:
        chartCandidate := NormalizeGraphObjects(chart, objects);
      ValidateObjectReferences:
        assert EveryObjectCsvAndColumnReferenceResolves(chartCandidate);
      RebuildCandidateProjection:
        chartCandidate := RebuildEditableProjection(chartCandidate);
      EmitCommit:
        command := [
          name |-> "GRAPH_OBJECTS_REPLACED",
          chartId |-> chart.id,
          objects |-> chartCandidate.editor.objects
        ];
      ReconcileRuntimeObjectSelection:
        if (requestedIndex \in 1..Len(chartCandidate.editor.objects)) {
          selectedObjectIndex := requestedIndex;
        } else {
          selectedObjectIndex := NoReference;
        };
      };
    };
    return;
  }

  procedure SetObjectValues(index, values) {
  ResolveObject:
    with (chart = ResolveSelectedChart(),
          object = ResolveGraphObject(index)) {
      if (chart # NoReference /\ object # NoReference
          /\ chart.editor.editable = TRUE) {
      ResolveObjectCsv:
        with (csv = ResolveRequestedOrExistingCsv(values, object.csvId)) {
          if (csv # NoReference) {
          NormalizeAllowedFields:
            chartCandidate := ReplaceOneObjectWithNormalizedValues(
              chart, index, values, csv);
          DelegateObjectCommit:
            call CommitGraphObjects(chartCandidate.editor.objects, index);
          };
        };
      };
    };
    return;
  }

  procedure SetEditable(editable) {
  ResolveEditableChart:
    with (chart = ResolveSelectedChart()) {
      if (chart # NoReference) {
        if (editable = TRUE /\ chart.editor.editable = FALSE) {
        ConvertImportedCandidate:
          projectCandidate := ConvertImportedChartToEditableCandidate(chart);
        ValidateEditableProject:
          assert ValidateWholeProject(projectCandidate);
        EmitEditableProjectCommit:
          command := [
            name |-> "CHART_MODEL_REPLACED",
            chartId |-> chart.id,
            candidate |-> projectCandidate
          ];
        } else {
        EmitEditableFlagCommit:
          command := [
            name |-> "CHART_MODEL_REPLACED",
            chartId |-> chart.id,
            editable |-> editable
          ];
        };
      };
    };
    return;
  }

  procedure RebuildEditable(chart) {
  ResolveTraceCsvReferences:
    assert EveryGraphObjectCsvResolves(chart);
  CalculateTraceProjection:
    chartCandidate := ChartWithTracesFromEditorAndCsv(chart);
  CalculateLayoutProjection:
    chartCandidate := ChartWithNormalizedLayout(chartCandidate);
  ReturnProjection:
    result := chartCandidate;
    return;
  }

  procedure ImportGraphFile(file) {
  ResolveTargetSlot:
    with (slot = ResolveSelectedSlot()) {
      if (slot # NoReference) {
        if (IsFfsx(file)) {
        ReadFfsxCandidate:
          projectCandidate := ReadAndRemapFfsx(file, slot);
        } else {
        ReadPlotlyCandidate:
          chartCandidate := ParsePlotlyPreservingOriginal(file);
          projectCandidate := AttachImportedChartToSlot(chartCandidate, slot);
        };
      ValidateImportedProject:
        assert ValidateWholeProject(projectCandidate);
      EmitImportedChartCommit:
        command := [
          name |-> "SLOT_CHART_IMPORTED",
          slotId |-> slot.id,
          candidate |-> projectCandidate
        ];
      };
    };
    return;
  }

  procedure ExportChartFigure(chart) {
  PreserveRepresentationRule:
    if (chart.editor.editable = TRUE) {
      result := FigureFromEditorAndReferencedCsv(chart);
    } else {
      result := PreservedImportedFigure(chart);
    };
    return;
  }

  procedure DataTable(data) {
  NormalizeTabularInput:
    if (RowsAreArrays(data)) {
      result := PreserveArrayRows(data);
    } else {
      if (RowsAreObjects(data)) {
      BuildObjectKeyUnion:
        result := ProjectObjectsToCommonColumnOrder(data);
      } else {
      RejectUnsupportedTable:
        result := NoReference;
      };
    };
  RequireNonEmptySupportedTable:
    assert result # NoReference;
    return;
  }

  procedure ColumnDefinitions(table, headerLines) {
  ComputeMaximumWidth:
    with (width = MaximumRowWidth(table)) {
    ChooseLastHeaderRow:
      result := BuildColumnIdsAndOptionalNames(width, table, headerLines);
    };
    return;
  }

  procedure GraphDataSelection(matrix, headerLines, editor) {
  ResolveValidColumns:
    with (columns = ColumnDefinitionsFor(matrix, headerLines)) {
      if (EditorXYRemainValid(editor, columns)) {
      PreserveEditorSelection:
        result := [x |-> editor.x, y |-> editor.y];
      } else {
      ChooseX:
        with (x = FirstNumericColumnOrValidFallback(matrix, columns)) {
      ChooseY:
        result := [x |-> x, y |-> DifferentNumericOrValidColumn(matrix, columns, x)];
        };
      };
    };
    return;
  }

  procedure ConnectDataToSlot(slot, data, sourceName, projectCsv) {
  ResolveSlotAndCsv:
    assert ResolveSlot(slot.id) # NoReference /\ ResolveProjectCsv(projectCsv.id) # NoReference;
  ChooseValidColumns:
    with (xy = GraphDataSelectionForCsv(projectCsv)) {
      if (slot.chart # NoReference) {
      AppendObjectToOwnedChartCandidate:
        result := AppendGraphObjectCandidate(slot, projectCsv, xy);
      } else {
      AllocateChartAndAttachCandidate:
        result := NewOwnedChartCandidate(slot, projectCsv, xy);
      };
    };
  RebuildConnectionProjection:
    result := RebuildCandidateGraphProjection(result);
    return;
  }

  procedure TracesSingle(objectView) {
  ReadObjectCsvValues:
    with (values = ResolveTraceColumnsAndDivisors(objectView)) {
    FilterAxisDomain:
      values := RemoveReciprocalZeroAndLogNonPositive(values, objectView);
    MapTraceStyle:
      result := BuildPlotlyTraceFromGraphObject(values, objectView);
    };
    return;
  }

  procedure Traces(chart) {
  ResolveEveryObjectCsv:
    assert EveryGraphObjectCsvResolves(chart);
  ProjectEveryObject:
    result := ConcatenateTraceProjectionPerObject(chart);
    return;
  }

  procedure NormalizeAxis(axis, key) {
  FillAxisDefaults:
    result := FillAxisDefaultsBySide(axis, key);
  NormalizeAxisEnumsAndNumbers:
    result := NormalizeAxisEnumsNumericOrEmpty(result);
  RequireNonZeroDivide:
    assert result.divide # 0;
  ForcePlotlyTicksForLog:
    if (result.scaleType = "log") {
      result := SetTickModePlotly(result);
    };
    return;
  }

  procedure NormalizeGlobal(settings) {
  FillGraphDefaults:
    result := FillGlobalGraphDefaults(settings);
  NormalizeFourAxes:
    result := NormalizeAllFourAxes(result);
  PreserveImportedExtensionsSeparately:
    result := SeparateEditorOwnedAndImportedExtensionFields(result);
    return;
  }

  procedure ValidateChart(chart, csvCollection) {
  ValidateChartShape:
    assert ValidChartIdEditorAndGraphShape(chart);
  PermitZeroObjects:
    assert IsSequence(chart.editor.objects);
  ValidateObjects:
    assert EveryObjectReferenceColumnEnumAndStyleValid(chart, csvCollection);
  ValidateGlobalSettings:
    assert GlobalAndFourAxesNormalize(chart.editor.globalSettings);
  ValidateRendererShapes:
    assert ValidGraphDataLayoutConfigFramesImported(chart.graph);
  ReturnChart:
    result := chart;
    return;
  }

  procedure ParsePlotly(figure, chartId) {
  PreserveOriginalFigure:
    chartCandidate := DeepCopyImportedPlotlyRepresentation(figure, chartId);
  BuildConversionRows:
    chartCandidate := ExpandTraceXYArraysInTraceOrder(chartCandidate);
  BuildConversionObjects:
    chartCandidate := MapSupportedTraceAxisTypeVisibilityAndStyles(chartCandidate);
  ConvertLayout:
    chartCandidate := ConvertSupportedLayoutToGlobalSettings(chartCandidate);
  PreserveUnsupportedExtensions:
    chartCandidate := PreservePlotlyExtensions(chartCandidate);
  PermitEmptyConversion:
    assert ZeroTraceOrZeroDataFigureNeedsNoFakeRows(chartCandidate);
  MarkNonEditable:
    chartCandidate := SetEditorEditable(chartCandidate, FALSE);
  ReturnImportedChart:
    result := chartCandidate;
    return;
  }

  procedure ConvertImportedToEditable(chart) {
  PreserveImportedRepresentation:
    projectCandidate := CopyCurrentProject();
  HandleEmptyConversion:
    if (Len(ConversionObjects(chart)) = 0) {
      projectCandidate := SetChartEditableWithoutCsv(projectCandidate, chart.id);
    } else {
    CreateOneProjectCsv:
      projectCandidate := CreateCsvFromConversionRows(projectCandidate, chart);
    RemapAllConversionObjects:
      projectCandidate := PointConversionObjectsToCreatedCsv(projectCandidate, chart.id);
    };
  RebuildEditableProjection:
    projectCandidate := RebuildConvertedChartProjection(projectCandidate, chart.id);
  ValidateConvertedProject:
    assert ValidateWholeProject(projectCandidate);
  ReturnEditableCandidate:
    result := projectCandidate;
    return;
  }
  Main:
    while (TRUE) {
      either {
        with (csvId = SelectedCsvId()) {
          call AddGraphObject(csvId);
        };
      } or {
        with (objects = EditedObjectList(), index = RequestedObjectIndex()) {
          call CommitGraphObjects(objects, index);
        };
      } or {
        with (index = RequestedObjectIndex(), values = EditedObjectValues()) {
          call SetObjectValues(index, values);
        };
      } or {
        with (editable = RequestedEditableState()) {
          call SetEditable(editable);
        };
      };
    };
}
*)
====
